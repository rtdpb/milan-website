---
/**
 * Button.astro
 * Reusable CTA component with honest disabled/placeholder state.
 *
 * Source: RESEARCH §Pattern 7 (placeholder disabled CTA), UI-SPEC §Button Variants,
 *         UI-SPEC §Disabled/Placeholder CTA Pattern; D-12, HOME-10
 *
 * HONESTY RULE (HOME-10):
 * When `disabled` is true, the component renders a <span role="button">
 * with aria-disabled="true" and tabindex="-1" — never an href="#" or
 * href="" that would deceive the visitor. The `placeholderReason` prop
 * is surfaced as a data attribute + title tooltip for developers and
 * assistive technology.
 *
 * Variants:
 *   primary       — yellow fill (#FFDD11), near-black text (D-02 signature moment)
 *   secondary     — outline on light bg; near-black border + text
 *   ghost         — alias for secondary (transparent bg)
 *   ghost-on-dark — outline on dark bg; off-white border + text
 */

interface Props {
  /** Link destination. Required when disabled=false; omitted when disabled=true. */
  href?: string;
  /** Visual style variant. Default: 'primary'. */
  variant?: 'primary' | 'secondary' | 'ghost' | 'ghost-on-dark';
  /** Render as a non-interactive placeholder (aria-disabled). Default: false. */
  disabled?: boolean;
  /**
   * Human-readable reason for the placeholder state. Surfaced as:
   *  - data-placeholder attribute (for devs / grep)
   *  - title tooltip (visible on hover for sighted users)
   *  - aria-describedby label (for AT)
   * Example: "Contact page not yet built — Phase 2"
   */
  placeholderReason?: string;
  /** Open link in new tab (adds rel="noopener noreferrer" per T-01-04). */
  external?: boolean;
  /** Extra CSS classes to merge onto the root element. */
  class?: string;
}

const {
  href,
  variant = 'primary',
  disabled = false,
  placeholderReason,
  external = false,
  class: extraClass,
} = Astro.props;

const variantClass = `btn--${variant}`;
const classes = ['btn', variantClass, extraClass].filter(Boolean).join(' ');
---

{disabled ? (
  <span
    class={`${classes} btn--disabled`}
    role="button"
    aria-disabled="true"
    tabindex="-1"
    data-placeholder={placeholderReason}
    title={placeholderReason}
  >
    <slot />
  </span>
) : (
  <a
    href={href}
    class={classes}
    {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  >
    <slot />
  </a>
)}

<style>
  /* ── Base Button ──────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding-inline: var(--space-lg);  /* 24px left/right */
    border-radius: var(--radius-md);  /* 8px */
    font-family: var(--font-body);
    font-size: 0.9375rem;             /* 15px — UI-SPEC CTA/Button */
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    border: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color            var(--duration-fast) var(--ease-out),
      transform        var(--duration-fast) var(--ease-out),
      box-shadow       var(--duration-fast) var(--ease-out);

    /* Minimum 44px touch target on mobile (WCAG 2.5.5) */
    min-height: 44px;
  }

  /* ── Primary: yellow fill + near-black text (D-02 — accent CTA) ─────── */
  .btn--primary {
    background-color: var(--color-accent);   /* #FFDD11 */
    color: var(--color-text);                /* #1A1A18 */
    border: none;
  }

  .btn--primary:hover:not(.btn--disabled) {
    background-color: var(--color-accent-dark); /* #C9AC00 */
    transform: scale(1.02);
  }

  /* ── Secondary / Ghost: outline on light background ─────────────────── */
  .btn--secondary,
  .btn--ghost {
    background-color: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-text);
  }

  .btn--secondary:hover:not(.btn--disabled),
  .btn--ghost:hover:not(.btn--disabled) {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  /* ── Ghost on dark: outline on dark band ────────────────────────────── */
  .btn--ghost-on-dark {
    background-color: transparent;
    color: var(--color-dark-text);           /* #F5F2EC */
    border: 1px solid var(--color-dark-text);
  }

  .btn--ghost-on-dark:hover:not(.btn--disabled) {
    background-color: var(--color-dark-text);
    color: var(--color-dark-band);           /* #111110 */
  }

  /* ── Disabled / Placeholder state ───────────────────────────────────── */
  .btn--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none; /* belt + suspenders: no hover/click events */
  }

  /* ── Focus ring (a11y — FND-06) — brand-coloured focus indicator ─────── */
  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
