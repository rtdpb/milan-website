---
/**
 * Nav.astro
 * Site header — sticky, scroll-aware, with mobile hamburger toggle island.
 *
 * Source: UI-SPEC §Component Inventory <SiteHeader> (HOME-01),
 *         UI-SPEC §Interaction Contracts Navigation — Mobile,
 *         UI-SPEC §Accessibility Contract, RESEARCH §Architecture Patterns,
 *         PLAN 01-02 Task 2; D-12, D-16
 *
 * HONESTY RULE (HOME-10, D-12):
 * All nav items whose destinations are future pages are DISABLED:
 *   - aria-disabled="true" on the anchor
 *   - tabindex="-1" (removed from natural tab order)
 *   - cursor: not-allowed + opacity 0.5
 *   - title = DISABLED_TOOLTIP ("Binnenkort beschikbaar")
 *   - NEVER bare hash or empty href
 * Destinations are centralised in src/config.ts (TODO_* constants).
 *
 * NL|EN switch: non-functional disabled affordance (D-16 — Phase 4).
 * LinkedIn icon: inline SVG, disabled (aria-disabled), references TODO_LINKEDIN_URL.
 * Yellow (#FFDD11): used ONLY for primary CTA hover state and active-nav underline (D-02).
 * Nav/footer background: NOT yellow (D-02, D-03).
 */

import { getRelativeLocaleUrl } from 'astro:i18n';
import { getStrings, nlToEn, enToNl } from '../../i18n/utils';
import { SITE_NAME } from '../../config';

// Phase 4: locale-parameterized strings + functional NL↔EN switch (D-07, I18N-01)
const t = getStrings(Astro.currentLocale);

const currentLocale = Astro.currentLocale ?? 'nl';
const isEn = currentLocale === 'en';

// ── Language switch href (D-07) ────────────────────────────────────────────
// Strip base path + locale prefix to derive the current bare slug.
// RESEARCH §Pattern 5, §Common Pitfall 5: use getRelativeLocaleUrl — never
// manual concatenation — so base path (/milan-website/) is applied automatically.
const base = import.meta.env.BASE_URL; // '/milan-website/'
let rawSlug = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname.slice(1);
rawSlug = rawSlug.replace(/\/$/, ''); // strip trailing slash
const currentSlug = isEn ? rawSlug.replace(/^en\/?/, '') : rawSlug;

const oppositeLocale = isEn ? 'nl' : 'en';
const oppositeSlug   = isEn ? (enToNl[currentSlug] ?? '') : (nlToEn[currentSlug] ?? '');
const switchHref     = getRelativeLocaleUrl(oppositeLocale, oppositeSlug);

// Wordmark: only the first name ("Milan") is bold; the rest of the name stays
// in a regular weight (feedback). Kept uppercase — only the weight differs.
const [wmFirst, ...wmRestParts] = SITE_NAME.split(' ');
const wmRest = wmRestParts.join(' ');

// Phase 3 Plan 03: nieuwsbrief enabled — /nieuwsbrief page now exists; boek still disabled
const currentPath = Astro.url.pathname;

// WR-04: normalize BOTH sides before comparing so trailing-slash differences
// between currentPath (which may have a trailing slash under some Astro configs)
// and href (which getRelativeLocaleUrl may or may not append) never produce a
// false negative for the active indicator.
const normalize = (p: string) => p.replace(/\/$/, '');
const isActive = (href: string) => normalize(currentPath) === normalize(href);

// ── navItems — locale-branched (Phase 4) ─────────────────────────────────
// EN: use getRelativeLocaleUrl so base path is handled automatically (Pitfall 5).
// NL: keep existing BASE_URL-prefixed slugs for backward compatibility.
const navItems = isEn
  ? [
      { label: t.nav.coaching,    href: getRelativeLocaleUrl('en', 'coaching') },
      { label: t.nav.spreker,     href: getRelativeLocaleUrl('en', 'speaking') },
      { label: t.nav.nieuwsbrief, href: getRelativeLocaleUrl('en', 'newsletter') },
      { label: t.nav.mijnVerhaal, href: getRelativeLocaleUrl('en', 'about') },
      // 'Boek' tab intentionally omitted (feedback — added back later).
    ]
  : [
      { label: t.nav.coaching,    href: `${base}coaching` },
      { label: t.nav.spreker,     href: `${base}spreker` },
      { label: t.nav.nieuwsbrief, href: `${base}nieuwsbrief` },
      { label: t.nav.mijnVerhaal, href: `${base}mijn-verhaal` },
      // 'Boek' tab intentionally omitted (feedback — added back later).
    ];
---

<!-- TODO Plan 02 — Nav wired into BaseLayout -->
<header class="site-header" id="site-header">
  <div class="site-header__inner">

    <!-- Wordmark (left) -->
    <a href={import.meta.env.BASE_URL} class="site-header__wordmark" aria-label={`${SITE_NAME} — ${t.nav.homeAria}`}>
      <span class="wm-first">{wmFirst}</span> <span class="wm-rest">{wmRest}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="site-header__nav" aria-label={t.nav.navLabel}>
      <ul class="nav-list" role="list">
        {navItems.map((item) => (
          <li>
            {item.href ? (
              <a
                href={item.href}
                class={`nav-link${isActive(item.href) ? ' nav-link--active' : ''}`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ) : (
              <span
                class="nav-link nav-link--disabled"
                role="link"
                aria-disabled="true"
                tabindex="-1"
                title={t.common.disabledTooltip}
              >
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right rail: Contact CTA + NL|EN + LinkedIn -->
    <div class="site-header__actions">

      <!-- Contact CTA: primary button — enabled in Phase 2 (D-11) -->
      <a
        href={isEn ? getRelativeLocaleUrl('en', 'contact') : `${base}contact`}
        class="btn btn--primary nav-cta"
      >
        {t.nav.contact}
      </a>

      <!-- NL|EN switch: functional language switch (Phase 4 — D-07, I18N-01) -->
      <!-- Shows the OTHER locale label (clicking "EN" takes you to EN, etc.) -->
      <!-- BRAND RULE (D-02/D-03): not yellow — matches existing affordance style -->
      <a
        href={switchHref}
        class="lang-switch"
        aria-label={isEn ? 'Schakel naar Nederlands' : 'Switch to English'}
      >
        {isEn ? 'NL' : 'EN'}
      </a>

      <!-- LinkedIn icon: disabled — TODO_LINKEDIN_URL in config.ts -->
      <!--
        TODO: wire href to real LinkedIn URL (TODO_LINKEDIN_URL in config.ts).
        When wired: add target="_blank" rel="noopener noreferrer" (T-01-04 contract).
        Current: aria-disabled span — no navigation.
      -->
      <span
        class="linkedin-icon"
        role="link"
        aria-disabled="true"
        aria-label={`${t.nav.linkedin} — ${t.common.disabledTooltip}`}
        tabindex="-1"
        title={t.common.disabledTooltip}
      >
        <!-- LinkedIn inline SVG (authorised static markup, T-01-06 accepted) -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </span>

      <!-- Hamburger toggle (mobile only — aria-expanded managed by JS island below) -->
      <!-- CR-04: data-label-* carry locale strings so the JS island can read them
           instead of hardcoding Dutch. The JS island overwrites aria-label on
           open/close — without these attributes it always wrote Dutch strings. -->
      <button
        class="hamburger"
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label={t.nav.openMenu}
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
      >
        <!-- Three-line hamburger icon -->
        <span class="hamburger__line" aria-hidden="true"></span>
        <span class="hamburger__line" aria-hidden="true"></span>
        <span class="hamburger__line" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Nav Panel (right-slide, full-height) -->
<div
  class="mobile-nav"
  id="mobile-nav-panel"
  role="dialog"
  aria-modal="true"
  aria-label={t.nav.navLabel}
  hidden
>
  <div class="mobile-nav__inner">
    <div class="mobile-nav__header">
      <span class="mobile-nav__wordmark"><span class="wm-first">{wmFirst}</span> <span class="wm-rest">{wmRest}</span></span>
      <button
        class="mobile-nav__close"
        id="nav-close"
        type="button"
        aria-label={t.nav.closeMenu}
      >
        <!-- Close icon (×) -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <nav aria-label={t.nav.navLabel}>
      <ul class="mobile-nav__list" role="list">
        {navItems.map((item) => (
          <li>
            {item.href ? (
              <a
                href={item.href}
                class={`mobile-nav__link${isActive(item.href) ? ' mobile-nav__link--active' : ''}`}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ) : (
              <span
                class="mobile-nav__link mobile-nav__link--disabled"
                role="link"
                aria-disabled="true"
                tabindex="-1"
                title={t.common.disabledTooltip}
              >
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile Contact CTA — enabled in Phase 2 (D-11) -->
    <div class="mobile-nav__cta">
      <a
        href={isEn ? getRelativeLocaleUrl('en', 'contact') : `${base}contact`}
        class="btn btn--primary"
      >
        {t.nav.contact}
      </a>
    </div>

    <!-- Mobile meta: NL/EN switch + LinkedIn (preserved on mobile — brief) -->
    <div class="mobile-nav__meta">
      <a
        href={switchHref}
        class="mobile-nav__lang"
        aria-label={isEn ? 'Schakel naar Nederlands' : 'Switch to English'}
      >
        {isEn ? 'Nederlands' : 'English'}
      </a>
      <span
        class="mobile-nav__linkedin"
        role="link"
        aria-disabled="true"
        aria-label={`${t.nav.linkedin} — ${t.common.disabledTooltip}`}
        tabindex="-1"
        title={t.common.disabledTooltip}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <span class="sr-only">{t.nav.linkedin}</span>
      </span>
    </div>
  </div>
</div>

<!-- Mobile nav backdrop -->
<div class="mobile-nav-backdrop" id="mobile-nav-backdrop" aria-hidden="true" hidden></div>

<!-- Vanilla JS island: mobile toggle + scroll-aware header (D-14 — no framework) -->
<script>
  (function () {
    'use strict';

    // ── Element refs ────────────────────────────────────────────────────────
    const header   = document.getElementById('site-header');
    const toggle   = document.getElementById('nav-toggle');
    const panel    = document.getElementById('mobile-nav-panel');
    const closeBtn = document.getElementById('nav-close');
    const backdrop = document.getElementById('mobile-nav-backdrop');

    if (!header || !toggle || !panel || !closeBtn || !backdrop) return;

    // After the null check above, TypeScript still considers these possibly null
    // inside closures. Use non-null assertions (!) — we know they exist (guarded above).
    const h = header!;
    const t = toggle!;
    const p = panel!;
    const c = closeBtn!;
    const b = backdrop!;

    // CR-04: read locale-resolved aria-label strings from data-* attributes
    // baked into the button at build time (see template above). Fall back to
    // Dutch so NL behaviour is identical to before this fix.
    const labelOpen  = (t as HTMLButtonElement).dataset.labelOpen  || 'Menu openen';
    const labelClose = (t as HTMLButtonElement).dataset.labelClose || 'Menu sluiten';

    // ── Scroll-aware header background ─────────────────────────────────────
    // Transparent at top; --color-bg + shadow after ~60px scroll.
    // Uses requestAnimationFrame for smooth, non-jank class toggling.
    let lastKnownScrollY = 0;
    let ticking = false;

    function updateHeader() {
      if (lastKnownScrollY > 60) {
        h.classList.add('site-header--scrolled');
      } else {
        h.classList.remove('site-header--scrolled');
      }
      ticking = false;
    }

    window.addEventListener('scroll', function () {
      lastKnownScrollY = window.scrollY;
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }, { passive: true });

    // ── Mobile nav open / close ─────────────────────────────────────────────
    // Evaluate live so a mid-session OS preference change is respected (WR-06).
    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function openNav() {
      p.hidden = false;
      b.hidden = false;
      t.setAttribute('aria-expanded', 'true');
      t.setAttribute('aria-label', labelClose);
      document.body.style.overflow = 'hidden'; // prevent background scroll

      // Move focus into the panel (a11y — focus trap start)
      c.focus();

      // Animate in (if motion is OK)
      if (!prefersReducedMotion()) {
        // Small rAF delay allows `hidden` removal + paint before transition
        requestAnimationFrame(function () {
          p.classList.add('mobile-nav--open');
          b.classList.add('mobile-nav-backdrop--visible');
        });
      } else {
        p.classList.add('mobile-nav--open');
        b.classList.add('mobile-nav-backdrop--visible');
      }
    }

    function closeNav() {
      t.setAttribute('aria-expanded', 'false');
      t.setAttribute('aria-label', labelOpen);
      document.body.style.overflow = '';

      if (!prefersReducedMotion()) {
        p.classList.remove('mobile-nav--open');
        b.classList.remove('mobile-nav-backdrop--visible');
        // Wait for CSS transition to finish before hiding from DOM
        var dur = 240;
        setTimeout(function () {
          p.hidden = true;
          b.hidden = true;
        }, dur);
      } else {
        p.classList.remove('mobile-nav--open');
        b.classList.remove('mobile-nav-backdrop--visible');
        p.hidden = true;
        b.hidden = true;
      }

      // Return focus to the toggle button — but only if it is visible.
      // On desktop the hamburger is display:none, so focusing it would drop
      // focus silently (WR-06). offsetParent is null when not rendered.
      if (t.offsetParent !== null) {
        t.focus();
      }
    }

    // Toggle button
    t.addEventListener('click', function () {
      var isOpen = t.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeNav();
      } else {
        openNav();
      }
    });

    // Close button inside panel
    c.addEventListener('click', closeNav);

    // Backdrop click closes nav
    b.addEventListener('click', closeNav);

    // Escape key closes nav (a11y — keyboard users)
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && t.getAttribute('aria-expanded') === 'true') {
        closeNav();
      }
    });

    // ── Basic focus trap within mobile nav panel ────────────────────────────
    // Traps Tab focus inside the panel while it is open.
    p.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      var focusable = p.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      var focusArray = Array.prototype.slice.call(focusable);
      if (focusArray.length === 0) return;
      var first = focusArray[0] as HTMLElement;
      var last  = focusArray[focusArray.length - 1] as HTMLElement;

      if (e.shiftKey) {
        if (document.activeElement === first) {
          last.focus();
          e.preventDefault();
        }
      } else {
        if (document.activeElement === last) {
          first.focus();
          e.preventDefault();
        }
      }
    });
  })();
</script>

<style>
  /* ── Header Shell ─────────────────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    /* Transparent at top of page */
    background-color: transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      box-shadow       var(--duration-base) var(--ease-out);
  }

  /* After 60px scroll — translucent warm bg + hairline (toggled by JS island) */
  .site-header--scrolled {
    background-color: rgba(244, 239, 230, 0.82);
    -webkit-backdrop-filter: saturate(1.2) blur(14px);
            backdrop-filter: saturate(1.2) blur(14px);
    box-shadow: 0 1px 0 var(--line-on-light);
  }

  /* ── Inner Container ──────────────────────────────────────────────────── */
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: 76px;
  }

  /* ── Wordmark (left) ──────────────────────────────────────────────────── */
  .site-header__wordmark {
    font-family: var(--font-sans);
    font-size: 1.0625rem;  /* 17px on mobile — keeps room for the hamburger */
    font-weight: 500;      /* base weight — only "Milan" is bold (feedback) */
    letter-spacing: 0.02em;   /* caps read better with slight positive tracking */
    text-transform: uppercase; /* feedback: uppercase; only "Milan" is bold */
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* Only the first name is bold; the remainder of the name is regular weight. */
  .site-header__wordmark .wm-first,
  .mobile-nav__wordmark .wm-first { font-weight: 800; }
  .site-header__wordmark .wm-rest,
  .mobile-nav__wordmark .wm-rest { font-weight: 400; }
  @media (min-width: 960px) {
    .site-header__wordmark { font-size: 1.25rem; }  /* 20px logotype on desktop */
  }

  .site-header__wordmark:hover {
    color: var(--color-text); /* no colour shift on wordmark hover */
  }

  .site-header__wordmark:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* ── Desktop Nav (center/right) ───────────────────────────────────────── */
  .site-header__nav {
    display: none; /* hidden on mobile — shown via hamburger */
  }

  @media (min-width: 960px) {
    .site-header__nav {
      display: flex;
      align-items: center;
      flex: 1;
      justify-content: center;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xl);  /* 32px between nav items */
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Nav Link (disabled — all nav items in Phase 1) ──────────────────── */
  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);  /* 14-16px label size */
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.005em;
    display: block;
    padding-block: var(--space-sm);
    white-space: nowrap;
    position: relative;
  }

  /* Hover / active underline: 2px yellow (accent for active + hover state) */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link--active::after { transform: scaleX(1); }

  /* Disabled nav links */
  .nav-link--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ── Right Rail Actions ───────────────────────────────────────────────── */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);  /* 16px between action items */
    flex-shrink: 0;
  }
  /* The LinkedIn box is a 44px touch target whose glyph is centred, so it adds
     ~12px of visual space on its left — pulling it back evens out the optical
     rhythm between Contact · EN · LinkedIn (feedback). */
  @media (min-width: 960px) {
    .site-header__actions .linkedin-icon { margin-left: calc(var(--space-sm) * -1); }
  }

  /* ── Nav CTA (Contact button — desktop only) ──────────────────────────── */
  .nav-cta {
    display: none;
  }

  @media (min-width: 960px) {
    .nav-cta {
      display: inline-flex;
      /* Reuse .btn styles from Button.astro — inlined here for the nav context */
      align-items: center;
      justify-content: center;
      height: 44px;
      padding-inline: var(--space-lg);
      border-radius: var(--radius-pill);
      font-family: var(--font-body);
      font-size: 0.875rem;    /* 14px — compact in nav */
      font-weight: 600;
      letter-spacing: 0.01em;
      background-color: var(--color-text);
      color: var(--color-bg);
      text-decoration: none;
      cursor: pointer;
      transition: background-color var(--duration-fast) var(--ease-out),
                  transform var(--duration-fast) var(--ease-out);
    }

    .nav-cta:hover {
      background-color: #000;
      transform: translateY(-1px);
    }

    .nav-cta:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }
  }

  /* ── NL|EN Switch — functional language switch (Phase 4, D-07) ──────── */
  /* BRAND RULE: not yellow (D-02/D-03) — uses secondary text colour */
  .lang-switch {
    display: none; /* hidden on mobile (space) */
  }

  @media (min-width: 960px) {
    .lang-switch {
      display: inline-flex;
      align-items: center;
      font-family: var(--font-body);
      font-size: var(--text-xs);   /* 12-14px label */
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--color-text-secondary);
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition: color var(--duration-fast) var(--ease-out);
    }

    .lang-switch:hover {
      color: var(--color-text);
    }

    .lang-switch:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
      border-radius: var(--radius-sm);
    }
  }

  /* ── LinkedIn Icon ────────────────────────────────────────────────────── */
  /* Desktop-only in the header (keeps the mobile header clean; LinkedIn also
     lives in the footer). Matches lang-switch / nav-cta which are also >=960. */
