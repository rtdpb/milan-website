---
/**
 * Nav.astro
 * Site header — sticky, scroll-aware, with mobile hamburger toggle island.
 *
 * Source: UI-SPEC §Component Inventory <SiteHeader> (HOME-01),
 *         UI-SPEC §Interaction Contracts Navigation — Mobile,
 *         UI-SPEC §Accessibility Contract, RESEARCH §Architecture Patterns,
 *         PLAN 01-02 Task 2; D-12, D-16
 *
 * HONESTY RULE (HOME-10, D-12):
 * All nav items whose destinations are future pages are DISABLED:
 *   - aria-disabled="true" on the anchor
 *   - tabindex="-1" (removed from natural tab order)
 *   - cursor: not-allowed + opacity 0.5
 *   - title = DISABLED_TOOLTIP ("Binnenkort beschikbaar")
 *   - NEVER bare hash or empty href
 * Destinations are centralised in src/config.ts (TODO_* constants).
 *
 * NL|EN switch: non-functional disabled affordance (D-16 — Phase 4).
 * LinkedIn icon: inline SVG, disabled (aria-disabled), references TODO_LINKEDIN_URL.
 * Yellow (#FFDD11): used ONLY for primary CTA hover state and active-nav underline (D-02).
 * Nav/footer background: NOT yellow (D-02, D-03).
 */

import { nl } from '../../i18n/nl';
import { SITE_NAME, TODO_LINKEDIN_URL, DISABLED_TOOLTIP } from '../../config';

// Nav items: all disabled in Phase 1 — pages arrive in Phase 2+
const navItems = [
  { label: nl.nav.coaching,    reason: 'Coaching pagina volgt in fase 2' },
  { label: nl.nav.spreker,     reason: 'Spreker pagina volgt in fase 2' },
  { label: nl.nav.nieuwsbrief, reason: 'Nieuwsbrief pagina volgt in fase 2' },
  { label: nl.nav.mijnVerhaal, reason: 'Mijn verhaal pagina volgt in fase 2' },
  { label: nl.nav.boek,        reason: 'Boek pagina volgt in fase 2' },
];
---

<!-- TODO Plan 02 — Nav wired into BaseLayout -->
<header class="site-header" id="site-header">
  <div class="site-header__inner">

    <!-- Wordmark (left) -->
    <a href={import.meta.env.BASE_URL} class="site-header__wordmark" aria-label={`${SITE_NAME} — naar startpagina`}>
      {SITE_NAME}
    </a>

    <!-- Desktop Navigation -->
    <nav class="site-header__nav" aria-label={nl.nav.navLabel}>
      <ul class="nav-list" role="list">
        {navItems.map((item) => (
          <li>
            <!--
              TODO Phase 2: replace aria-disabled span with real <a href="/{page}"> when page exists.
              Destinations centralised in src/config.ts — grep TODO_ to find all placeholders.
            -->
            <span
              class="nav-link nav-link--disabled"
              role="link"
              aria-disabled="true"
              tabindex="-1"
              data-placeholder={item.reason}
              title={DISABLED_TOOLTIP}
            >
              {item.label}
            </span>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right rail: Contact CTA + NL|EN + LinkedIn -->
    <div class="site-header__actions">

      <!-- Contact CTA: primary button — enabled in Phase 2 (D-11) -->
      <a
        href={`${import.meta.env.BASE_URL}contact`}
        class="btn btn--primary nav-cta"
      >
        {nl.nav.contact}
      </a>

      <!-- NL|EN switch: disabled affordance — Phase 4 wires real switching (D-16) -->
      <span
        class="lang-switch"
        aria-disabled="true"
        aria-label="Taalselectie — beschikbaar in een toekomstige versie"
        title="Engelstalige versie volgt in fase 4"
        tabindex="-1"
      >
        {nl.common.nlEnSwitch}
      </span>

      <!-- LinkedIn icon: disabled — TODO_LINKEDIN_URL in config.ts -->
      <!--
        TODO: wire href to real LinkedIn URL (TODO_LINKEDIN_URL in config.ts).
        When wired: add target="_blank" rel="noopener noreferrer" (T-01-04 contract).
        Current: aria-disabled span — no navigation.
      -->
      <span
        class="linkedin-icon"
        role="link"
        aria-disabled="true"
        aria-label={`${nl.nav.linkedin} — ${DISABLED_TOOLTIP}`}
        tabindex="-1"
        title={DISABLED_TOOLTIP}
        data-placeholder={`LinkedIn URL: ${TODO_LINKEDIN_URL} — wire when available`}
      >
        <!-- LinkedIn inline SVG (authorised static markup, T-01-06 accepted) -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </span>

      <!-- Hamburger toggle (mobile only — aria-expanded managed by JS island below) -->
      <button
        class="hamburger"
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label={nl.nav.openMenu}
      >
        <!-- Three-line hamburger icon -->
        <span class="hamburger__line" aria-hidden="true"></span>
        <span class="hamburger__line" aria-hidden="true"></span>
        <span class="hamburger__line" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Nav Panel (right-slide, full-height) -->
<div
  class="mobile-nav"
  id="mobile-nav-panel"
  role="dialog"
  aria-modal="true"
  aria-label={nl.nav.navLabel}
  hidden
>
  <div class="mobile-nav__inner">
    <div class="mobile-nav__header">
      <span class="mobile-nav__wordmark">{SITE_NAME}</span>
      <button
        class="mobile-nav__close"
        id="nav-close"
        type="button"
        aria-label={nl.nav.closeMenu}
      >
        <!-- Close icon (×) -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <nav aria-label={nl.nav.navLabel}>
      <ul class="mobile-nav__list" role="list">
        {navItems.map((item) => (
          <li>
            <!--
              TODO Phase 2: replace with real <a> when page exists.
              All disabled states preserved on mobile (HOME-10).
            -->
            <span
              class="mobile-nav__link mobile-nav__link--disabled"
              role="link"
              aria-disabled="true"
              tabindex="-1"
              title={DISABLED_TOOLTIP}
            >
              {item.label}
            </span>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile Contact CTA — enabled in Phase 2 (D-11) -->
    <div class="mobile-nav__cta">
      <a
        href={`${import.meta.env.BASE_URL}contact`}
        class="btn btn--primary"
      >
        {nl.nav.contact}
      </a>
    </div>
  </div>
</div>

<!-- Mobile nav backdrop -->
<div class="mobile-nav-backdrop" id="mobile-nav-backdrop" aria-hidden="true" hidden></div>

<!-- Vanilla JS island: mobile toggle + scroll-aware header (D-14 — no framework) -->
<script>
  (function () {
    'use strict';

    // ── Element refs ────────────────────────────────────────────────────────
    const header   = document.getElementById('site-header');
    const toggle   = document.getElementById('nav-toggle');
    const panel    = document.getElementById('mobile-nav-panel');
    const closeBtn = document.getElementById('nav-close');
    const backdrop = document.getElementById('mobile-nav-backdrop');

    if (!header || !toggle || !panel || !closeBtn || !backdrop) return;

    // After the null check above, TypeScript still considers these possibly null
    // inside closures. Use non-null assertions (!) — we know they exist (guarded above).
    const h = header!;
    const t = toggle!;
    const p = panel!;
    const c = closeBtn!;
    const b = backdrop!;

    // ── Scroll-aware header background ─────────────────────────────────────
    // Transparent at top; --color-bg + shadow after ~60px scroll.
    // Uses requestAnimationFrame for smooth, non-jank class toggling.
    let lastKnownScrollY = 0;
    let ticking = false;

    function updateHeader() {
      if (lastKnownScrollY > 60) {
        h.classList.add('site-header--scrolled');
      } else {
        h.classList.remove('site-header--scrolled');
      }
      ticking = false;
    }

    window.addEventListener('scroll', function () {
      lastKnownScrollY = window.scrollY;
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }, { passive: true });

    // ── Mobile nav open / close ─────────────────────────────────────────────
    // Evaluate live so a mid-session OS preference change is respected (WR-06).
    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function openNav() {
      p.hidden = false;
      b.hidden = false;
      t.setAttribute('aria-expanded', 'true');
      t.setAttribute('aria-label', 'Menu sluiten');
      document.body.style.overflow = 'hidden'; // prevent background scroll

      // Move focus into the panel (a11y — focus trap start)
      c.focus();

      // Animate in (if motion is OK)
      if (!prefersReducedMotion()) {
        // Small rAF delay allows `hidden` removal + paint before transition
        requestAnimationFrame(function () {
          p.classList.add('mobile-nav--open');
          b.classList.add('mobile-nav-backdrop--visible');
        });
      } else {
        p.classList.add('mobile-nav--open');
        b.classList.add('mobile-nav-backdrop--visible');
      }
    }

    function closeNav() {
      t.setAttribute('aria-expanded', 'false');
      t.setAttribute('aria-label', 'Menu openen');
      document.body.style.overflow = '';

      if (!prefersReducedMotion()) {
        p.classList.remove('mobile-nav--open');
        b.classList.remove('mobile-nav-backdrop--visible');
        // Wait for CSS transition to finish before hiding from DOM
        var dur = 240;
        setTimeout(function () {
          p.hidden = true;
          b.hidden = true;
        }, dur);
      } else {
        p.classList.remove('mobile-nav--open');
        b.classList.remove('mobile-nav-backdrop--visible');
        p.hidden = true;
        b.hidden = true;
      }

      // Return focus to the toggle button — but only if it is visible.
      // On desktop the hamburger is display:none, so focusing it would drop
      // focus silently (WR-06). offsetParent is null when not rendered.
      if (t.offsetParent !== null) {
        t.focus();
      }
    }

    // Toggle button
    t.addEventListener('click', function () {
      var isOpen = t.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeNav();
      } else {
        openNav();
      }
    });

    // Close button inside panel
    c.addEventListener('click', closeNav);

    // Backdrop click closes nav
    b.addEventListener('click', closeNav);

    // Escape key closes nav (a11y — keyboard users)
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && t.getAttribute('aria-expanded') === 'true') {
        closeNav();
      }
    });

    // ── Basic focus trap within mobile nav panel ────────────────────────────
    // Traps Tab focus inside the panel while it is open.
    p.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      var focusable = p.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      var focusArray = Array.prototype.slice.call(focusable);
      if (focusArray.length === 0) return;
      var first = focusArray[0] as HTMLElement;
      var last  = focusArray[focusArray.length - 1] as HTMLElement;

      if (e.shiftKey) {
        if (document.activeElement === first) {
          last.focus();
          e.preventDefault();
        }
      } else {
        if (document.activeElement === last) {
          first.focus();
          e.preventDefault();
        }
      }
    });
  })();
</script>

<style>
  /* ── Header Shell ─────────────────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    /* Transparent at top of page */
    background-color: transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      box-shadow       var(--duration-base) var(--ease-out);
  }

  /* After 60px scroll — opaque bg + shadow (toggled by JS island) */
  .site-header--scrolled {
    background-color: var(--color-bg);
    box-shadow: 0 1px 0 var(--color-border), 0 2px 16px rgba(26, 26, 24, 0.06);
  }

  /* ── Inner Container ──────────────────────────────────────────────────── */
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-lg);
    height: 72px;
  }

  @media (min-width: 768px) {
    .site-header__inner {
      padding-inline: var(--space-3xl);
    }
  }

  /* ── Wordmark (left) ──────────────────────────────────────────────────── */
  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: 1.125rem;   /* 18px */
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .site-header__wordmark:hover {
    color: var(--color-text); /* no colour shift on wordmark hover */
  }

  .site-header__wordmark:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* ── Desktop Nav (center/right) ───────────────────────────────────────── */
  .site-header__nav {
    display: none; /* hidden on mobile — shown via hamburger */
  }

  @media (min-width: 960px) {
    .site-header__nav {
      display: flex;
      align-items: center;
      flex: 1;
      justify-content: center;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xl);  /* 32px between nav items */
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Nav Link (disabled — all nav items in Phase 1) ──────────────────── */
  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);  /* 14-16px label size */
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    display: block;
    padding-block: var(--space-sm);
    white-space: nowrap;
    position: relative;
  }

  /* Active nav underline: 2px yellow (D-02 — accent for active state only) */
  /* Currently no item is "active" — reserved for future routing */
  .nav-link--active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent);
  }

  /* Disabled nav links */
  .nav-link--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ── Right Rail Actions ───────────────────────────────────────────────── */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);  /* 16px between action items */
    flex-shrink: 0;
  }

  /* ── Nav CTA (Contact button — desktop only) ──────────────────────────── */
  .nav-cta {
    display: none;
  }

  @media (min-width: 960px) {
    .nav-cta {
      display: inline-flex;
      /* Reuse .btn styles from Button.astro — inlined here for the nav context */
      align-items: center;
      justify-content: center;
      height: 40px;           /* slightly shorter in nav */
      padding-inline: var(--space-md);
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-size: 0.875rem;    /* 14px — compact in nav */
      font-weight: 600;
      letter-spacing: 0.02em;
      background-color: var(--color-accent);
      color: var(--color-text);
      text-decoration: none;
      cursor: pointer;
      transition: background-color var(--duration-fast) var(--ease-out),
                  transform var(--duration-fast) var(--ease-out);
    }

    .nav-cta:hover {
      background-color: var(--color-accent-dark);
      transform: scale(1.02);
    }

    .nav-cta:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }
  }

  /* ── NL|EN Switch (disabled affordance) ──────────────────────────────── */
  .lang-switch {
    display: none; /* hidden on mobile (space) */
  }

  @media (min-width: 960px) {
    .lang-switch {
      display: inline-flex;
      align-items: center;
      font-family: var(--font-body);
      font-size: var(--text-xs);   /* 12-14px label */
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--color-text-secondary);
      opacity: 0.4;                /* clearly inactive affordance */
      cursor: not-allowed;
      white-space: nowrap;
      user-select: none;
    }
  }

  /* ── LinkedIn Icon ────────────────────────────────────────────────────── */
  .linkedin-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44×44 touch target */
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);  /* grey — NOT yellow (D-02) */
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ── Hamburger Button ─────────────────────────────────────────────────── */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;    /* 44×44 touch target (WCAG 2.5.5) */
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    border-radius: var(--radius-sm);
    color: var(--color-text);
  }

  .hamburger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Hide hamburger on desktop — nav is always visible */
  @media (min-width: 960px) {
    .hamburger {
      display: none;
    }
  }

  .hamburger__line {
    display: block;
    width: 22px;
    height: 2px;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform var(--duration-fast) var(--ease-out),
                opacity  var(--duration-fast) var(--ease-out);
  }

  /* ── Mobile Nav Panel ─────────────────────────────────────────────────── */
  .mobile-nav {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(280px, 85vw);
    z-index: 200;
    background-color: var(--color-bg);
    box-shadow: -4px 0 32px rgba(26, 26, 24, 0.12);
    /* Slide in from right */
    transform: translateX(100%);
    transition: transform 240ms var(--ease-out);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  /* When hidden: both CSS transform and HTML hidden attribute used (belt + suspenders) */
  .mobile-nav[hidden] {
    display: flex;  /* Keep flex layout, hidden via transform */
    visibility: hidden;
  }

  .mobile-nav--open {
    transform: translateX(0);
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav {
      transition: none;
    }
  }

  .mobile-nav__inner {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    height: 100%;
  }

  .mobile-nav__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-nav__wordmark {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .mobile-nav__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    border-radius: var(--radius-sm);
  }

  .mobile-nav__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .mobile-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mobile-nav__link {
    display: block;
    padding: var(--space-sm) 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);  /* slightly larger on mobile panel */
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav__link--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .mobile-nav__cta {
    margin-top: auto;  /* push to bottom of panel */
  }

  .mobile-nav__cta .btn {
    width: 100%;
    justify-content: center;
  }

  /* ── Mobile nav backdrop ──────────────────────────────────────────────── */
  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 150;
    background-color: rgba(26, 26, 24, 0.4);
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
  }

  .mobile-nav-backdrop[hidden] {
    display: block; /* Keep in DOM for transition, hidden visually */
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-nav-backdrop--visible {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-backdrop {
      transition: none;
    }
  }
</style>
