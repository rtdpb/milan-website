---
/**
 * Footer.astro
 * Site footer — light background, three-column desktop layout.
 *
 * Source: UI-SPEC §Component Inventory <SiteFooter> (HOME-09),
 *         UI-SPEC §Copywriting Contract; PLAN 01-02 Task 3; D-01, D-12
 *
 * DESIGN RULES:
 * - Background: --color-bg (light) — dark band is RESERVED for the story
 *   section (D-01). Footer is NEVER a dark band.
 * - Yellow (#FFDD11): NOT used here (D-02, D-03). Footer is neutral.
 * - No invented content (HOME-11) — all strings from nl.ts.
 *
 * HONESTY RULE (HOME-10, D-12):
 * All nav links whose destinations are unknown are aria-disabled.
 * Privacy / terms links are also disabled (pages not yet built).
 * LinkedIn icon disabled (TODO_LINKEDIN_URL pending).
 * NEVER href="#" or href="".
 */

import { nl } from '../../i18n/nl';
import {
  SITE_NAME,
  TODO_LINKEDIN_URL,
  TODO_PRIVACY_URL,
  TODO_TERMS_URL,
  DISABLED_TOOLTIP,
  COPYRIGHT_YEAR,
} from '../../config';

// Footer nav items — Phase 2: coaching + spreker enabled; others remain disabled placeholders
// mijnVerhaal: stays disabled here — enabled in Plan 03
const navItems = [
  { label: nl.nav.coaching,    href: `${import.meta.env.BASE_URL}coaching` },
  { label: nl.nav.spreker,     href: `${import.meta.env.BASE_URL}spreker` },
  { label: nl.nav.nieuwsbrief, reason: 'Nieuwsbrief pagina volgt in fase 3' },
  { label: nl.nav.mijnVerhaal, reason: 'Mijn verhaal pagina volgt in fase 2, plan 3' },
  { label: nl.nav.boek,        reason: 'Boek pagina volgt in fase 5' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">

    <!-- Column 1: Wordmark + tagline -->
    <div class="site-footer__brand">
      <a href={import.meta.env.BASE_URL} class="site-footer__wordmark" aria-label={`${SITE_NAME} — naar startpagina`}>
        {SITE_NAME}
      </a>
      <p class="site-footer__tagline">{nl.footer.tagline}</p>
    </div>

    <!-- Column 2: Nav links -->
    <nav class="site-footer__nav" aria-label="Footer navigatie">
      <p class="site-footer__nav-heading">{nl.footer.navHeading}</p>
      <ul class="site-footer__nav-list" role="list">
        {navItems.map((item) => (
          <li>
            {item.href ? (
              <a href={item.href} class="site-footer__nav-link">
                {item.label}
              </a>
            ) : (
              <span
                class="site-footer__nav-link site-footer__nav-link--disabled"
                role="link"
                aria-disabled="true"
                tabindex="-1"
                title={DISABLED_TOOLTIP}
              >
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Column 3: Social + legal -->
    <div class="site-footer__legal-col">

      <!-- LinkedIn icon: disabled (TODO_LINKEDIN_URL pending) -->
      <!--
        TODO: wire href to real LinkedIn URL (TODO_LINKEDIN_URL in config.ts).
        When wired: add target="_blank" rel="noopener noreferrer" (T-01-04).
        Current: aria-disabled span — no navigation.
      -->
      <span
        class="site-footer__linkedin"
        role="link"
        aria-disabled="true"
        aria-label={`${nl.nav.linkedin} — ${DISABLED_TOOLTIP}`}
        tabindex="-1"
        title={DISABLED_TOOLTIP}
        data-placeholder={`LinkedIn URL: ${TODO_LINKEDIN_URL} — wire when available`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <span class="sr-only">{nl.nav.linkedin}</span>
      </span>

      <!-- Legal links: disabled placeholder (pages not yet built) -->
      <div class="site-footer__legal-links">
        <!--
          TODO Phase 2+: wire to real pages (TODO_PRIVACY_URL, TODO_TERMS_URL in config.ts).
        -->
        <span
          class="site-footer__legal-link site-footer__legal-link--disabled"
          role="link"
          aria-disabled="true"
          tabindex="-1"
          title={DISABLED_TOOLTIP}
          data-placeholder={`Privacy pagina: ${TODO_PRIVACY_URL} — volgt in fase 2`}
        >
          {nl.footer.privacy}
        </span>
        <span class="site-footer__legal-sep" aria-hidden="true">·</span>
        <span
          class="site-footer__legal-link site-footer__legal-link--disabled"
          role="link"
          aria-disabled="true"
          tabindex="-1"
          title={DISABLED_TOOLTIP}
          data-placeholder={`Voorwaarden pagina: ${TODO_TERMS_URL} — volgt in fase 2`}
        >
          {nl.footer.terms}
        </span>
      </div>

      <!-- Copyright -->
      <p class="site-footer__copyright">
        &copy; {COPYRIGHT_YEAR} {SITE_NAME}. Alle rechten voorbehouden.
      </p>
    </div>

  </div>
</footer>

<style>
  /* ── Footer Shell — LIGHT background (D-01: dark band reserved for story) ── */
  .site-footer {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-3xl);  /* 64px top/bottom */
  }

  /* ── Inner container ──────────────────────────────────────────────────── */
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);   /* 48px between columns on mobile (stacked) */
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      padding-inline: var(--space-3xl);
    }
  }

  /* Three-column layout on desktop */
  @media (min-width: 960px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
      align-items: start;
    }
  }

  /* ── Column 1: Brand ─────────────────────────────────────────────────── */
  .site-footer__wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.125rem;  /* 18px */
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: var(--space-sm);
  }

  .site-footer__wordmark:hover {
    color: var(--color-text);
  }

  .site-footer__wordmark:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .site-footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-xs);     /* 13px label size */
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin: 0;
    max-width: 240px;
  }

  /* ── Column 2: Nav links ─────────────────────────────────────────────── */
  .site-footer__nav-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-md) 0;
  }

  .site-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);  /* 8px between links */
  }

  .site-footer__nav-link {
    font-family: var(--font-body);
    font-size: var(--text-xs);  /* 13px — footer label size (UI-SPEC) */
    color: var(--color-text-secondary);
    text-decoration: none;
    display: block;
    line-height: 1.4;
  }

  .site-footer__nav-link--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ── Column 3: Legal / social ────────────────────────────────────────── */
  .site-footer__legal-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);  /* 16px */
  }

  /* LinkedIn icon */
  .site-footer__linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);  /* grey — NOT yellow (D-02) */
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Legal links row */
  .site-footer__legal-links {
    display: flex;
    align-items: center;
    gap: var(--space-sm);  /* 8px */
    flex-wrap: wrap;
  }

  .site-footer__legal-link {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    line-height: 1.4;
  }

  .site-footer__legal-link--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .site-footer__legal-sep {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    opacity: 0.5;
  }

  /* Copyright */
  .site-footer__copyright {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    opacity: 0.6;
    margin: 0;
    line-height: 1.4;
  }
</style>
