---
/**
 * BaseHead.astro
 * Centralised <head> component for all pages.
 * Source: RESEARCH §Pattern 4 (SEO BaseHead), §SEO/Metadata Checklist
 * Emits: charset, viewport, title, description, canonical, OG, Twitter,
 *        JSON-LD Person schema, font preloads, favicon.
 * Phase 4: hreflang alternates, locale-correct og:locale, dynamic locale props.
 */
import { getAbsoluteLocaleUrl } from 'astro:i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Active locale — 'nl' | 'en'; defaults to 'nl' */
  locale?: string;
  /** NL slug override for hreflang (e.g. 'spreker' when on /en/speaking) */
  nlSlug?: string;
  /** EN slug override for hreflang (e.g. 'speaking' when on /spreker) */
  enSlug?: string;
}

// Base path (import.meta.env.BASE_URL) — '/' locally, '/milan-website/' on
// GitHub Pages project deploy. All static asset URLs (favicon, fonts, og-image)
// must be prefixed with it so they resolve under the project subpath.
const base = import.meta.env.BASE_URL;

const {
  title,
  description,
  ogImage = `${base}og-image.jpg`,
  locale = 'nl',
  nlSlug,
  enSlug,
} = Astro.props;

// Canonical URL — requires `site` set in astro.config.mjs (RESEARCH Pitfall 3).
// Astro.url.pathname already includes the base at build time.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// ── hreflang / og:locale (Phase 4) ───────────────────────────────────────────
// Strip base path + locale prefix to derive the bare page slug for hreflang.
// RESEARCH §Pattern 6, §Common Pitfall 3: always use getAbsoluteLocaleUrl, never
// manually concatenate — the helper applies site + base + locale prefix correctly.
let rawPath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname.slice(1);
rawPath = rawPath.replace(/\/$/, ''); // strip trailing slash

// For pages where NL and EN slugs are identical (coaching, contact, homepage),
// no explicit override is needed — strip the 'en/' prefix to get the bare slug.
// For translated-slug pages (spreker ↔ speaking etc.), the caller passes explicit
// nlSlug/enSlug props to BaseLayout which are forwarded here.
const effectiveNlSlug = nlSlug ?? rawPath.replace(/^en\/?/, '');
const effectiveEnSlug = enSlug ?? rawPath.replace(/^en\/?/, '');

// getAbsoluteLocaleUrl returns a full URL including site + base + locale prefix
// (e.g. https://rtdpb.github.io/milan-website/en/speaking).
// RESEARCH §Common Pitfall 3: never call with the full pathname — slug only.
const nlAbsUrl = getAbsoluteLocaleUrl('nl', effectiveNlSlug);
const enAbsUrl = getAbsoluteLocaleUrl('en', effectiveEnSlug);

// og:locale: 'en_US' for international English (D-04 / RESEARCH A6), 'nl_NL' otherwise.
const ogLocale    = locale === 'en' ? 'en_US' : 'nl_NL';
const ogLocaleAlt = locale === 'en' ? 'nl_NL' : 'en_US';

// OG image absolute URL
const ogImageURL = new URL(ogImage, Astro.site);

// @font-face — authored here (not tokens.css) so src URLs carry the base path.
// Self-hosted WOFF2 in public/fonts/. Vite leaves is:inline styles untouched.
const fontFaceCss = `
@font-face {
  font-family: 'Fraunces';
  src: url('${base}fonts/Fraunces-subset.woff2') format('woff2');
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0020-007E, U+00A0-00FF;
}
@font-face {
  font-family: 'DM Sans';
  src: url('${base}fonts/DMSans-subset.woff2') format('woff2');
  font-weight: 300 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0020-007E, U+00A0-00FF;
}`;

/**
 * JSON-LD Person schema — establishes Milan's authorship.
 * sameAs: TODO — add LinkedIn URL once supplied (RESEARCH Open Q4 / D-12).
 * jobTitle from UI-SPEC §SEO.
 */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Milan van der Meulen',
  jobTitle: 'Ondernemer, coach en spreker',
  url: Astro.site?.toString(),
  // TODO: replace TODO_LINKEDIN_URL with actual LinkedIn URL when supplied (D-12)
  sameAs: [] as string[],
};
---

<!-- Character encoding and viewport -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternates (Phase 4: I18N-01, D-04, D-05) -->
<!-- RESEARCH §Common Pitfall 3: use getAbsoluteLocaleUrl — never manual concatenation -->
<link rel="alternate" hreflang="nl"        href={nlAbsUrl} />
<link rel="alternate" hreflang="en"        href={enAbsUrl} />
<link rel="alternate" hreflang="x-default" href={nlAbsUrl} />

<!-- Favicon (interim SVG — replace with brand favicon when supplied) -->
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

<!-- Self-hosted @font-face (base-aware — see frontmatter). is:inline so Vite leaves url() untouched. -->
<style is:inline set:html={fontFaceCss}></style>

<!--
  Font preloads — CRITICAL for FND-07 / LCP performance.
  Preloading the WOFF2 files prevents FOUT on the first render.
  Both files must match the @font-face src URLs above exactly (base-prefixed).
  Source: RESEARCH §Fonts, §Pattern 6, §Common Pitfalls 7.
-->
<link
  rel="preload"
  href={`${base}fonts/Fraunces-subset.woff2`}
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href={`${base}fonts/DMSans-subset.woff2`}
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlt} />
<meta property="og:site_name" content="Milan van der Meulen" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- JSON-LD Person Schema (FND-05 — establishes authorship) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
