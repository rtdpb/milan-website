---
/**
 * ContactForm.astro
 * Contact form that composes an email to CONTACT_EMAIL via `mailto:` (PAGE-04).
 *
 * Overhauled in 260824-jd5:
 * - Removed subject dropdown + mailtoFallbackPre line
 * - Added optional Naam bedrijf + Telefoonnummer fields
 * - Added required privacy-consent checkbox linking to privacy page
 * - Submit button restyled as yellow pill CTA with arrow (matches site's primary CTAs)
 *
 * NO-JS PATH: native form posts to `mailto:CONTACT_EMAIL` with
 * enctype="text/plain", so the browser still opens the mail client with the
 * field values in the body.
 *
 * JS PATH: submit intercepted (preventDefault). Builds a nicely formatted
 * `mailto:` (localised subject + labelled body) and navigates to it, then shows
 * a static polite note. No fake success/network states — delivery happens in
 * the user's mail app.
 *
 * ACCESSIBILITY:
 * - Every field has a visible <label for> (never placeholder-only).
 * - aria-live="polite" on result region for screen reader announcements.
 * - aria-required="true" on required fields + native required attribute.
 * - Autocomplete attributes on all appropriate fields.
 *
 * SECURITY: result strings come ONLY from i18n — never echoed from user input.
 */

import { CONTACT_EMAIL } from '../../config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getStrings } from '../../i18n/utils';

// Phase 4: locale-parameterized contact strings
const t = getStrings(Astro.currentLocale);
const {
  labelNaam,
  labelEmail,
  labelBericht,
  labelBedrijf,
  labelTelefoon,
  privacyConsentPre,
  privacyConsentLink,
  ctaSubmit,
  emailSubject,
  mailtoNote,
} = t.contact;

// Privacy policy href — NL: /privacybeleid, EN: /en/privacy
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const base = import.meta.env.BASE_URL;
const privacyHref = isEn ? getRelativeLocaleUrl('en', 'privacy') : `${base}privacybeleid`;
---

<!-- ContactForm: mailto composer (260824-jd5 overhaul) -->
<div class="contact-form-wrap">
  <form
    id="contact-form"
    method="post"
    enctype="text/plain"
    action={`mailto:${CONTACT_EMAIL}`}
    novalidate
    class="contact-form"
    data-email={CONTACT_EMAIL}
    data-subject={emailSubject}
    data-note={mailtoNote}
    data-l-name={labelNaam}
    data-l-email={labelEmail}
    data-l-message={labelBericht}
    data-l-company={labelBedrijf}
    data-l-phone={labelTelefoon}
  >
    <!-- Name — required -->
    <div class="form-group">
      <label for="contact-naam" class="form-label">
        {labelNaam}<span aria-hidden="true"> *</span>
      </label>
      <input
        id="contact-naam"
        type="text"
        name="name"
        required
        aria-required="true"
        autocomplete="name"
        class="form-input"
      />
    </div>

    <!-- Email address — required -->
    <div class="form-group">
      <label for="contact-email" class="form-label">
        {labelEmail}<span aria-hidden="true"> *</span>
      </label>
      <input
        id="contact-email"
        type="email"
        name="email"
        required
        aria-required="true"
        autocomplete="email"
        class="form-input"
      />
    </div>

    <!-- Company name — optional -->
    <div class="form-group">
      <label for="contact-bedrijf" class="form-label">
        {labelBedrijf}
      </label>
      <input
        id="contact-bedrijf"
        type="text"
        name="company"
        autocomplete="organization"
        class="form-input"
      />
    </div>

    <!-- Phone number — optional -->
    <div class="form-group">
      <label for="contact-telefoon" class="form-label">
        {labelTelefoon}
      </label>
      <input
        id="contact-telefoon"
        type="tel"
        name="phone"
        autocomplete="tel"
        class="form-input"
      />
    </div>

    <!-- Message — required -->
    <div class="form-group">
      <label for="contact-bericht" class="form-label">
        {labelBericht}<span aria-hidden="true"> *</span>
      </label>
      <textarea
        id="contact-bericht"
        name="message"
        rows="5"
        required
        aria-required="true"
        class="form-input form-textarea"
      ></textarea>
    </div>

    <!-- Privacy consent — required -->
    <div class="form-consent">
      <input
        type="checkbox"
        id="contact-privacy"
        name="privacy"
        required
        aria-required="true"
        class="form-consent__box"
      />
      <label for="contact-privacy" class="form-consent__label">
        {privacyConsentPre}<a href={privacyHref} class="form-consent__link">{privacyConsentLink}</a>
      </label>
    </div>

    <!-- Submit — yellow pill CTA with arrow (matches site's primary CTAs) -->
    <button
      type="submit"
      id="contact-submit"
      class="contact-submit"
      aria-describedby="contact-result"
    >
      {ctaSubmit}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </button>
  </form>

  <!-- Result region: polite note after the mail client opens (aria-live for AT) -->
  <div id="contact-result" aria-live="polite" hidden></div>
</div>

<!-- JS island: mailto composer -->
<script>
  (function () {
    'use strict';

    const form     = document.getElementById('contact-form') as HTMLFormElement | null;
    const resultEl = document.getElementById('contact-result') as HTMLElement | null;

    if (!form) return;
    const f = form!;

    // ── Copy + config from data-* attributes (single source of truth) ──────
    const email       = f.dataset.email    || '';
    const subjectBase = f.dataset.subject  || '';
    const note        = f.dataset.note     || '';
    const lName       = f.dataset.lName    || 'Naam';
    const lEmail      = f.dataset.lEmail   || 'Mailadres';
    const lMessage    = f.dataset.lMessage || 'Bericht';
    const lCompany    = f.dataset.lCompany || 'Naam bedrijf';
    const lPhone      = f.dataset.lPhone   || 'Telefoonnummer';

    // ── Submit → build mailto and open the visitor's mail client ───────────
    f.addEventListener('submit', function (e) {
      e.preventDefault();

      // novalidate carries the no-JS path; the JS path validates itself (WR-02).
      if (!f.checkValidity()) {
        f.reportValidity();
        return;
      }

      const fd      = new FormData(f);
      const name    = String(fd.get('name') || '');
      const sender  = String(fd.get('email') || '');
      const company = String(fd.get('company') || '');
      const phone   = String(fd.get('phone') || '');
      const message = String(fd.get('message') || '');

      const subject = subjectBase;

      let body =
        lName + ': ' + name + '\n' +
        lEmail + ': ' + sender + '\n';

      if (company) body += lCompany + ': ' + company + '\n';
      if (phone)   body += lPhone   + ': ' + phone   + '\n';

      body += '\n' + message;

      const url =
        'mailto:' + email +
        '?subject=' + encodeURIComponent(subject) +
        '&body=' + encodeURIComponent(body);

      // Fire Plausible 'Contact: Submit' goal (GROW-01, D-05)
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if (typeof (window as any).plausible === 'function') {
        (window as any).plausible('Contact: Submit');
      }

      // Open the mail client
      window.location.href = url;

      // Static polite note — never echoes user input (T-2-02)
      if (resultEl) {
        const p = document.createElement('p');
        p.className = 'form-success';
        p.textContent = note;
        resultEl.innerHTML = '';
        resultEl.appendChild(p);
        resultEl.hidden = false;
      }
    });
  })();
</script>

<style>
  /* ── Contact form wrapper ──────────────────────────────────────────────── */
  .contact-form-wrap {
    width: 100%;
  }

  /* ── Form layout ────────────────────────────────────────────────────────── */
  .contact-form {
    display: flex;
    flex-direction: column;
  }

  /* ── Form group: label + input container ──────────────────────────────── */
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);       /* 8px between label and input */
    margin-bottom: var(--space-lg); /* 24px between groups */
  }

  /* ── Label ───────────────────────────────────────────────────────────────── */
  .form-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);    /* 14–16px label size */
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.01em;
    display: block;
  }

  /* ── Input / Textarea ───────────────────────────────────────────────────── */
  .form-input {
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);    /* 8px */
    height: 48px;
    padding-inline: var(--space-md);   /* 16px */
    font-family: var(--font-body);
    font-size: 1rem;                   /* 16px FIXED — prevents iOS zoom (FND-06) */
    font-weight: 400;
    color: var(--color-text);
    background-color: var(--color-bg);
    width: 100%;
    box-sizing: border-box;
    outline: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow   var(--duration-fast) var(--ease-out);
    appearance: none;
    -webkit-appearance: none;
  }

  /* Textarea overrides: allow vertical resize, min-height 120px */
  .form-textarea {
    height: auto;
    min-height: 120px;
    padding: var(--space-sm) var(--space-md); /* 8px top/bottom, 16px inline */
    resize: vertical;
    line-height: 1.6;
  }

  /* Focus ring: 2px --color-accent with 2px offset */
  .form-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  /* Placeholder text */
  .form-input::placeholder {
    color: var(--color-text-secondary);
  }

  /* ── Privacy consent row ─────────────────────────────────────────────────── */
  .form-consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .form-consent__box {
    width: 20px;
    height: 20px;
    min-width: 20px;
    margin-top: 2px; /* optical alignment with label text */
    border: 1.5px solid var(--color-border);
    border-radius: 4px;
    background-color: var(--color-bg);
    cursor: pointer;
    accent-color: var(--color-accent);
    flex-shrink: 0;
  }

  .form-consent__box:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .form-consent__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-secondary);
    line-height: 1.5;
    cursor: pointer;
    /* Touch target: ensure the label is at least 44px tall */
    min-height: 44px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25ch;
  }

  .form-consent__link {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .form-consent__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Submit button — yellow pill CTA ────────────────────────────────────── */
  .contact-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    align-self: flex-start;
    margin-top: var(--space-sm);
    height: 54px;
    padding-inline: var(--space-xl);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    border: none;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .contact-submit:hover {
    transform: translateY(-2px);
    background-color: var(--color-accent-dark);
  }

  .contact-submit svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .contact-submit:hover svg {
    transform: translateX(3px);
  }

  .contact-submit:focus-visible {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 3px;
  }

  .contact-submit:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  /* ── Result region ────────────────────────────────────────────────────────── */
  .form-success {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.5;
    margin: var(--space-md) 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-submit,
    .contact-submit svg {
      transition: none;
    }
  }
</style>
