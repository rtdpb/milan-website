---
/**
 * ContactForm.astro
 * Contact form that emails submissions straight to Milan via Web3Forms
 * (260825-flj — replaced the earlier `mailto:` composer).
 *
 * DELIVERY: fetch POST JSON → https://api.web3forms.com/submit with the public
 * access_key (config TODO_WEB3FORMS_ACCESS_KEY). The email lands in Milan's
 * inbox (the address the key was generated against). No mail app opens, and no
 * autoresponder is sent to the visitor — only Milan is notified.
 *
 * Mirrors the proven pattern in BookInterestForm.astro (same fetch flow,
 * honeypot, static-copy result states).
 *
 * NO-JS PATH: native POST to Web3Forms with a `redirect` to the default
 * thank-you page, so the form still delivers without JavaScript.
 *
 * ACCESSIBILITY:
 * - Every field has a visible <label for> (never placeholder-only).
 * - aria-live="polite" on result region for screen reader announcements.
 * - aria-required="true" on required fields + native required attribute.
 * - Autocomplete attributes on all appropriate fields.
 *
 * SECURITY: result strings come ONLY from i18n — never echoed from the API
 * response or user input. Honeypot botcheck checkbox blocks spam bots.
 */

import { TODO_WEB3FORMS_ACCESS_KEY } from '../../config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getStrings } from '../../i18n/utils';

// Phase 4: locale-parameterized contact strings
const t = getStrings(Astro.currentLocale);
const {
  labelNaam,
  labelEmail,
  labelBericht,
  labelBedrijf,
  labelTelefoon,
  privacyConsentPre,
  privacyConsentLink,
  ctaSubmit,
  ctaSubmitting,
  successMsg,
  errorMsg,
  errorNetwork,
  emailSubject,
} = t.contact;

// Privacy policy href — NL: /privacybeleid, EN: /en/privacy
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const base = import.meta.env.BASE_URL;
const privacyHref = isEn ? getRelativeLocaleUrl('en', 'privacy') : `${base}privacybeleid`;
---

<!-- ContactForm: Web3Forms fetch submit (260825-flj) -->
<div class="contact-form-wrap">
  <form
    id="contact-form"
    method="POST"
    action="https://api.web3forms.com/submit"
    novalidate
    class="contact-form"
    data-submit={ctaSubmit}
    data-submitting={ctaSubmitting}
    data-success={successMsg}
    data-error={errorMsg}
    data-network={errorNetwork}
  >
    <!-- Hidden: Web3Forms access key — public client-side identifier -->
    <input type="hidden" name="access_key" value={TODO_WEB3FORMS_ACCESS_KEY} />

    <!-- Hidden: locale-resolved subject line for the email Milan receives -->
    <input type="hidden" name="subject" value={emailSubject} />

    <!-- Hidden: redirect for the no-JS path (Web3Forms default thank-you page) -->
    <input type="hidden" name="redirect" value="https://web3forms.com/success" />

    <!-- Type identifier: distinguishes contact emails from book-interest emails in the inbox -->
    <input type="hidden" name="type" value="contact" />

    <!-- Honeypot: botcheck checkbox (must be a checkbox for Web3Forms) -->
    <input
      type="checkbox"
      name="botcheck"
      style="display:none"
      tabindex="-1"
      aria-hidden="true"
    />

    <!-- Name — required -->
    <div class="form-group">
      <label for="contact-naam" class="form-label">
        {labelNaam}<span aria-hidden="true"> *</span>
      </label>
      <input
        id="contact-naam"
        type="text"
        name="name"
        required
        aria-required="true"
        autocomplete="name"
        class="form-input"
      />
    </div>

    <!-- Email address — required -->
    <div class="form-group">
      <label for="contact-email" class="form-label">
        {labelEmail}<span aria-hidden="true"> *</span>
      </label>
      <input
        id="contact-email"
        type="email"
        name="email"
        required
        aria-required="true"
        autocomplete="email"
        class="form-input"
      />
    </div>

    <!-- Company name — optional -->
    <div class="form-group">
      <label for="contact-bedrijf" class="form-label">
        {labelBedrijf}
      </label>
      <input
        id="contact-bedrijf"
        type="text"
        name="company"
        autocomplete="organization"
        class="form-input"
      />
    </div>

    <!-- Phone number — optional -->
    <div class="form-group">
      <label for="contact-telefoon" class="form-label">
        {labelTelefoon}
      </label>
      <input
        id="contact-telefoon"
        type="tel"
        name="phone"
        autocomplete="tel"
        class="form-input"
      />
    </div>

    <!-- Message — required -->
    <div class="form-group">
      <label for="contact-bericht" class="form-label">
        {labelBericht}<span aria-hidden="true"> *</span>
      </label>
      <textarea
        id="contact-bericht"
        name="message"
        rows="5"
        required
        aria-required="true"
        class="form-input form-textarea"
      ></textarea>
    </div>

    <!-- Privacy consent — required -->
    <div class="form-consent">
      <input
        type="checkbox"
        id="contact-privacy"
        name="privacy"
        required
        aria-required="true"
        class="form-consent__box"
      />
      <label for="contact-privacy" class="form-consent__label">
        {privacyConsentPre}<a href={privacyHref} class="form-consent__link">{privacyConsentLink}</a>
      </label>
    </div>

    <!-- Submit — yellow pill CTA with arrow (matches site's primary CTAs) -->
    <button
      type="submit"
      id="contact-submit"
      class="contact-submit"
      aria-describedby="contact-result"
    >
      {ctaSubmit}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </button>
  </form>

  <!-- Result region: hidden until JS resolves success or error (aria-live for AT) -->
  <div id="contact-result" aria-live="polite" hidden></div>
</div>

<!-- JS island: Web3Forms fetch submit (mirrors BookInterestForm.astro) -->
<script>
  (function () {
    'use strict';

    const form     = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const resultEl = document.getElementById('contact-result') as HTMLElement | null;

    if (!form || !submitBtn || !resultEl) return;
    const f = form!;
    const s = submitBtn!;
    const r = resultEl!;

    // ── Static copy from data-* attributes (single source of truth, XSS-safe) ──
    const copySubmitting = f.dataset.submitting || 'Versturen…';
    const copySuccess    = f.dataset.success    || '';
    const copyError      = f.dataset.error      || '';
    const copyNetwork    = f.dataset.network    || '';

    // Preserve the submit button's arrow icon so we can restore it after states.
    const submitHTML = s.innerHTML;

    // ── Placeholder key detection ─────────────────────────────────────────
    const accessKeyInput = f.querySelector('input[name="access_key"]') as HTMLInputElement | null;
    const accessKey      = accessKeyInput ? accessKeyInput.value : '';
    if (accessKey === 'TODO_WEB3FORMS_ACCESS_KEY') {
      console.warn(
        '[ContactForm] Web3Forms access key is a placeholder — form will not deliver email. ' +
        'Replace TODO_WEB3FORMS_ACCESS_KEY in src/config.ts.'
      );
    }

    // ── Helper: show error in result region, re-enable button ──────────────
    function showError(message: string) {
      const errorP = document.createElement('p');
      errorP.className = 'form-error';
      errorP.textContent = message;
      r.innerHTML = '';
      r.appendChild(errorP);
      r.hidden = false;

      s.disabled = false;
      s.innerHTML = submitHTML;
      (s as HTMLElement).style.opacity = '';
    }

    // ── Fetch submit handler ────────────────────────────────────────────────
    f.addEventListener('submit', async function (e) {
      e.preventDefault();

      // novalidate carries the no-JS path; the JS path validates itself.
      if (!f.checkValidity()) {
        f.reportValidity();
        return;
      }

      // Submitting — disable button, swap label (drop the arrow icon), dim.
      s.disabled = true;
      s.textContent = copySubmitting;
      (s as HTMLElement).style.opacity = '0.7';

      r.hidden = true;
      r.innerHTML = '';

      try {
        const data = Object.fromEntries(new FormData(f));
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const json = await response.json();

        if (json && json.success === true) {
          // Fire Plausible 'Contact: Submit' goal (GROW-01, D-05)
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          if (typeof (window as any).plausible === 'function') {
            (window as any).plausible('Contact: Submit');
          }

          // Success — hide form, show STATIC success message.
          // NEVER echo json.message or user input into the DOM (DOM XSS safety).
          (f as HTMLElement).hidden = true;
          const successP = document.createElement('p');
          successP.className = 'form-success';
          successP.textContent = copySuccess;
          r.appendChild(successP);
          r.hidden = false;
        } else {
          // API error (invalid key, rate limit, etc.)
          showError(copyError);
        }
      } catch (_err) {
        // Network error (no connection, CORS, etc.)
        showError(copyNetwork);
      }
    });
  })();
</script>

<style>
  /* ── Contact form wrapper ──────────────────────────────────────────────── */
  .contact-form-wrap {
    width: 100%;
  }

  /* ── Form layout ────────────────────────────────────────────────────────── */
  .contact-form {
    display: flex;
    flex-direction: column;
  }

  /* ── Form group: label + input container ──────────────────────────────── */
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);       /* 8px between label and input */
    margin-bottom: var(--space-lg); /* 24px between groups */
  }

  /* ── Label ───────────────────────────────────────────────────────────────── */
  .form-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);    /* 14–16px label size */
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.01em;
    display: block;
  }

  /* ── Input / Textarea ───────────────────────────────────────────────────── */
  .form-input {
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);    /* 8px */
    height: 48px;
    padding-inline: var(--space-md);   /* 16px */
    font-family: var(--font-body);
    font-size: 1rem;                   /* 16px FIXED — prevents iOS zoom (FND-06) */
    font-weight: 400;
    color: var(--color-text);
    background-color: var(--color-bg);
    width: 100%;
    box-sizing: border-box;
    outline: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow   var(--duration-fast) var(--ease-out);
    appearance: none;
    -webkit-appearance: none;
  }

  /* Textarea overrides: allow vertical resize, min-height 120px */
  .form-textarea {
    height: auto;
    min-height: 120px;
    padding: var(--space-sm) var(--space-md); /* 8px top/bottom, 16px inline */
    resize: vertical;
    line-height: 1.6;
  }

  /* Focus ring: 2px --color-accent with 2px offset */
  .form-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  /* Placeholder text */
  .form-input::placeholder {
    color: var(--color-text-secondary);
  }

  /* ── Privacy consent row ─────────────────────────────────────────────────── */
  .form-consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .form-consent__box {
    width: 20px;
    height: 20px;
    min-width: 20px;
    margin-top: 2px; /* optical alignment with label text */
    border: 1.5px solid var(--color-border);
    border-radius: 4px;
    background-color: var(--color-bg);
    cursor: pointer;
    accent-color: var(--color-accent);
    flex-shrink: 0;
  }

  .form-consent__box:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .form-consent__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-secondary);
    line-height: 1.5;
    cursor: pointer;
    /* Touch target: ensure the label is at least 44px tall */
    min-height: 44px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25ch;
  }

  .form-consent__link {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .form-consent__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Submit button — yellow pill CTA ────────────────────────────────────── */
  .contact-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    align-self: flex-start;
    margin-top: var(--space-sm);
    height: 54px;
    padding-inline: var(--space-xl);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    border: none;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .contact-submit:hover {
    transform: translateY(-2px);
    background-color: var(--color-accent-dark);
  }

  .contact-submit svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .contact-submit:hover svg {
    transform: translateX(3px);
  }

  .contact-submit:focus-visible {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 3px;
  }

  .contact-submit:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  /* ── Result region ────────────────────────────────────────────────────────── */
  .form-success {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.5;
    margin: var(--space-md) 0 0;
  }

  /* Error: --color-destructive — not yellow */
  .form-error {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-destructive);
    line-height: 1.5;
    margin: var(--space-md) 0 0;
    word-wrap: break-word;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-submit,
    .contact-submit svg {
      transition: none;
    }
  }
</style>
