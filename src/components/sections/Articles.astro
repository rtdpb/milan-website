---
/**
 * Articles.astro
 * "Recente artikelen" section — Sectie 6 (HOME-08).
 *
 * Source: PLAN 01-05 Task 2, UI-SPEC §ArticlesSection, CONTEXT D-10, D-12,
 *         HOME-08, HOME-10, HOME-11, FND-04
 *         Phase 3 PLAN 03-01: RSS-fed via src/lib/rss.ts behind TODO_SUBSTACK_URL sentinel
 *
 * Design decisions:
 * - D-02: Build-time RSS fetch (static HTML, zero runtime JS, no CORS proxy).
 *   Refreshed daily by scheduled GitHub Actions cron rebuild.
 * - D-04: While TODO_SUBSTACK_URL is the sentinel, renders existing 3 placeholder
 *   cards with PlaceholderBadge (honest current state). One grep-replace flips live.
 * - D-06: Feed failure / empty feed → honest placeholder + build-log warning; build
 *   always succeeds (never fails on network error from Substack).
 * - D-07: Homepage shows latest 3 posts. "Lees verder" → real post URL (target=_blank
 *   rel=noopener). "Alle artikelen" → Substack publication home.
 * - D-12: "Lees verder" and "Alle artikelen" are honest disabled placeholders when
 *   IS_SENTINEL is true (no href, no href="#"). aria-disabled="true" + tabindex="-1".
 * - T-3-01: All external anchors carry rel="noopener noreferrer" with target="_blank".
 * - T-3-02: NEVER set:html on RSS content. Excerpts from description (stripped only).
 *
 * ArticleCard type is imported from src/lib/rss.ts (Phase 3 — replaces comment block).
 */

import SectionWrapper from '../ui/SectionWrapper.astro';
import Card from '../ui/Card.astro';
import PlaceholderBadge from '../ui/PlaceholderBadge.astro';
import { getStrings } from '../../i18n/utils';
import { TODO_SUBSTACK_URL } from '../../config';
import { fetchSubstackFeed, type ArticleCard, type PlaceholderCard } from '../../lib/rss';

// Phase 4: locale-parameterized strings (I18N-02, D-02)
const t = getStrings(Astro.currentLocale);

// ── Sentinel guard — decides placeholder vs live feed ───────────────────────
const IS_SENTINEL = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
const substackPublicationUrl = TODO_SUBSTACK_URL;

let articles: ArticleCard[] | PlaceholderCard[];

if (IS_SENTINEL) {
  // D-04: honest placeholder state while Substack URL not yet supplied.
  // Renders the locale-appropriate 3 fictional founder-topic cards (HOME-11).
  articles = t.articles.items.map((item) => ({ ...item, isPlaceholder: true as const }));
} else {
  // D-02: build-time RSS fetch — runs once at `astro build`, not in the browser.
  const feedUrl = `${TODO_SUBSTACK_URL}/feed`;
  const fetched = await fetchSubstackFeed(feedUrl, 3);
  if (fetched.length === 0) {
    // D-06: feed failure or empty feed → honest placeholder + build-log warning.
    // Build must never fail on Substack errors (T-3-04).
    console.warn('[Phase 3] Substack feed returned 0 items — rendering placeholder cards.');
    articles = t.articles.items.map((item) => ({ ...item, isPlaceholder: true as const }));
  } else {
    articles = fetched;
  }
}

const { heading, seeAll } = t.articles;
---

<SectionWrapper id="artikelen" labelledBy="articles-heading" variant="default">
  <div class="articles">

    <!-- ── Section heading ─────────────────────────────────────────────────── -->
    <h2 id="articles-heading" class="articles__heading">
      {heading}
    </h2>

    <!-- ── Article cards grid ─────────────────────────────────────────────── -->
    <div class="articles__grid" role="list">

      {articles.map((article) => (
        <div class="articles__card-wrapper" role="listitem">
          <Card class="articles__card">

            <!-- Placeholder badge — top-right corner of card (D-10) -->
            <!-- Only shown when IS_SENTINEL or feed returned 0 items (D-04, D-06) -->
            {article.isPlaceholder && (
              <div class="articles__badge-row">
                <PlaceholderBadge />
              </div>
            )}

            <!-- Eyebrow category -->
            <p class="articles__category">
              {article.category}
            </p>

            <!-- Article title — fictional founder-topic copy when placeholder (HOME-11)
                 When real RSS: exact title from Substack feed. -->
            <h3 class="articles__title">
              {article.title}
            </h3>

            <!-- One-sentence excerpt -->
            <p class="articles__excerpt">
              {article.excerpt}
            </p>

            <!-- Meta row: date + read time -->
            <div class="articles__meta">
              <span class="articles__date">{article.date}</span>
              <span class="articles__separator" aria-hidden="true">·</span>
              <span class="articles__read-time">{article.readTime}</span>
            </div>

            <!-- "Lees verder" — disabled when placeholder (D-12, HOME-10),
                 real external link when live (T-3-01: rel="noopener noreferrer") -->
            {article.isPlaceholder ? (
              <span
                class="articles__read-more"
                role="link"
                aria-disabled="true"
                tabindex="-1"
                title={t.common.disabledTooltip}
                aria-label={`${t.common.readMore.replace(' →', '')} "${article.title}" — ${t.common.disabledTooltip}`}
              >
                {t.common.readMore}
              </span>
            ) : (
              <a
                href={(article as ArticleCard).href}
                target="_blank"
                rel="noopener noreferrer"
                class="articles__read-more articles__read-more--enabled"
                aria-label={`Lees "${article.title}" op Substack`}
              >
                {t.common.readMore}
              </a>
            )}

          </Card>
        </div>
      ))}

    </div>
    <!-- End article cards grid -->

    <!-- "Alle artikelen" — disabled when IS_SENTINEL (D-12, HOME-10),
         real external link to Substack publication home when live (D-07, T-3-01) -->
    <div class="articles__see-all-row">
      {IS_SENTINEL ? (
        <span
          class="articles__see-all"
          role="link"
          aria-disabled="true"
          tabindex="-1"
          title={t.common.disabledTooltip}
        >
          {seeAll}
          <span class="articles__see-all-arrow" aria-hidden="true">→</span>
        </span>
      ) : (
        <a
          href={substackPublicationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="articles__see-all articles__see-all--enabled"
        >
          {seeAll}
          <span class="articles__see-all-arrow" aria-hidden="true">→</span>
        </a>
      )}
    </div>

  </div>
</SectionWrapper>

<style>
  /* ── Section layout ────────────────────────────────────────────────────────── */
  .articles {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  /* ── Section heading ──────────────────────────────────────────────────────── */
  .articles__heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);   /* 24–36px — section heading (UI-SPEC) */
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .articles__heading {
      font-size: var(--text-3xl);
    }
  }

  /* ── Cards grid: 1 column mobile → 2 col tablet → 3 col desktop (FND-04) ── */
  .articles__grid {
    display: grid;
    grid-template-columns: 1fr;         /* Mobile: stacked */
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) {
    .articles__grid {
      grid-template-columns: repeat(2, 1fr); /* Tablet: 2 col */
    }
  }

  @media (min-width: 1024px) {
    .articles__grid {
      grid-template-columns: repeat(3, 1fr); /* Desktop: 3 col */
      gap: var(--space-xl);
    }
  }

  /* ── Card wrapper (full height) ───────────────────────────────────────────── */
  .articles__card-wrapper {
    height: 100%;
  }

  /* ── Article card inner layout ────────────────────────────────────────────── */
  /* Override Card.astro padding via :global to add flex layout for bottom-aligned "Lees verder" */
  :global(.articles__card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
    position: relative;  /* For badge positioning */
  }

  /* ── Placeholder badge row ────────────────────────────────────────────────── */
  .articles__badge-row {
    display: flex;
    justify-content: flex-end;   /* Top-right corner (UI-SPEC §ArticlesSection) */
    margin-bottom: calc(-1 * var(--space-xs)); /* Tighten gap above category */
  }

  /* ── Category eyebrow ────────────────────────────────────────────────────── */
  .articles__category {
    font-family: var(--font-body);
    font-size: var(--text-xs);   /* 12–14px — label/eyebrow */
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Article title (Subheading: 22px/medium) ────────────────────────────── */
  .articles__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);   /* 20–28px — subheading (UI-SPEC) */
    font-weight: 600;            /* 600 — collapsed from medium per UI-SPEC note */
    line-height: 1.25;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  /* ── Excerpt (Body: 17px/400) ────────────────────────────────────────────── */
  .articles__excerpt {
    font-family: var(--font-body);
    font-size: var(--text-base);  /* 16–18px body */
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1;  /* Pushes meta + read-more to bottom of card */
  }

  /* ── Meta row ────────────────────────────────────────────────────────────── */
  .articles__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);   /* 12–14px — Meta/Caption (UI-SPEC) */
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .articles__separator {
    opacity: 0.5;
  }

  /* ── "Lees verder" — base styles shared by disabled + enabled states ──────── */
  .articles__read-more {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    /* Minimum 44px touch target height (WCAG 2.5.5) */
    min-height: 44px;
    align-self: flex-start;
    padding-block: var(--space-sm);
    /* Disabled state (span): honest not-allowed cursor, muted opacity */
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Enabled "Lees verder" link — overrides disabled defaults */
  .articles__read-more--enabled {
    opacity: 1;
    cursor: pointer;
  }

  .articles__read-more--enabled:hover {
    text-decoration: underline;
  }

  .articles__read-more--enabled:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── "Alle artikelen" row ────────────────────────────────────────────────── */
  .articles__see-all-row {
    display: flex;
    justify-content: center;
    padding-top: var(--space-md);
  }

  /* "Alle artikelen" — base styles shared by disabled + enabled states */
  .articles__see-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    /* Minimum 44px touch target height (WCAG 2.5.5) */
    min-height: 44px;
    padding-block: var(--space-sm);
    /* Disabled state (span): honest not-allowed cursor, muted opacity */
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Enabled "Alle artikelen" link — overrides disabled defaults */
  .articles__see-all--enabled {
    opacity: 1;
    cursor: pointer;
  }

  .articles__see-all--enabled:hover .articles__see-all-arrow {
    transform: translateX(4px);
  }

  .articles__see-all--enabled:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .articles__see-all-arrow {
    transition: transform var(--duration-fast) var(--ease-out);
  }
</style>
