---
/**
 * Articles.astro — "Recente artikelen" with custom covers.
 *
 * HONESTY (client feedback): this section is HIDDEN until there are REAL articles.
 * No placeholder / "Voorbeeld" cards are ever shown. It renders only when the
 * Substack feed actually returns posts; once Milan publishes, the cards appear
 * automatically (real titles, dates, read-times, links). Custom colourful covers
 * are an easy swap point for real thumbnails later.
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import { getStrings } from '../../i18n/utils';
import { TODO_SUBSTACK_URL } from '../../config';
import { fetchSubstackFeed, parseFeed, type ArticleCard } from '../../lib/rss';
import feedSnapshot from '../../data/substack-feed.xml?raw';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const IS_SENTINEL = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
const substackPublicationUrl = TODO_SUBSTACK_URL;

// Real posts only — empty until the Substack feed has content (no placeholders).
let articles: ArticleCard[] = [];
if (!IS_SENTINEL) {
  articles = await fetchSubstackFeed(`${TODO_SUBSTACK_URL}/feed`, 3);
  // The GitHub Actions build can't reach Substack (403 from the datacenter IP),
  // so fall back to the committed snapshot — refresh via `npm run articles:pull`.
  if (articles.length === 0) articles = parseFeed(feedSnapshot, 3);
}
const hasArticles = articles.length > 0;

const { heading, seeAll } = t.articles;
const covers = ['cov--blue', 'cov--yellow', 'cov--coral'];
const [lead, ...rest] = articles;
const motif = `<svg class="art__motif" viewBox="0 0 200 120" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><polyline points="0,104 34,84 64,92 100,52 132,64 168,26 200,40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

{hasArticles && (
  <SectionWrapper id="artikelen" labelledBy="articles-heading" variant="default">
    <div class="art">
      <header class="art__head" data-anim>
        <div class="art__head-text">
          <p class="art__eyebrow rule-label">{isEn ? 'Writing' : 'Schrijven'}</p>
          <h2 id="articles-heading" class="art__heading">{heading}</h2>
        </div>
        <a href={substackPublicationUrl} target="_blank" rel="noopener noreferrer" class="art__seeall">
          {seeAll}
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </header>

      <div class={`art__grid${rest.length === 0 ? ' art__grid--single' : ''}`}>
        <!-- Featured -->
        <a class="art__card art__card--lead art__card--link" data-anim href={lead.href} target="_blank" rel="noopener noreferrer">
          <div class={`art__cover ${covers[0]}`}>
            <Fragment set:html={motif} />
            <span class="art__cover-cat">{lead.category}</span>
          </div>
          <div class="art__body">
            <h3 class="art__title art__title--lead">{lead.title}</h3>
            <p class="art__excerpt">{lead.excerpt}</p>
            <div class="art__meta">
              <span>{lead.date}</span><span class="art__dot" aria-hidden="true"></span><span>{lead.readTime}</span>
              <span class="art__more">{t.common.readMore}</span>
            </div>
          </div>
        </a>

        <!-- Supporting (only when there is more than one post) -->
        {rest.length > 0 && (
        <div class="art__col">
          {rest.map((a, i) => (
            <a class="art__card art__card--sm art__card--link" data-anim style={`--i: ${i + 1}`} href={a.href} target="_blank" rel="noopener noreferrer">
              <div class={`art__cover art__cover--sm ${covers[(i + 1) % covers.length]}`}>
                <Fragment set:html={motif} />
                <span class="art__cover-cat">{a.category}</span>
              </div>
              <div class="art__body">
                <h3 class="art__title">{a.title}</h3>
                <div class="art__meta">
                  <span>{a.date}</span><span class="art__dot" aria-hidden="true"></span><span>{a.readTime}</span>
                  <span class="art__more">{t.common.readMore}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
        )}
      </div>
    </div>
  </SectionWrapper>
)}

<style>
  .art { display: flex; flex-direction: column; gap: clamp(var(--space-xl), 4vw, var(--space-3xl)); }
  .art__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-lg); flex-wrap: wrap; }
  .art__head-text { display: flex; flex-direction: column; gap: var(--space-sm); max-width: 46ch; }
  .art__eyebrow { margin: 0; }
  .art__heading { font-size: var(--text-3xl); margin: 0; }
  .art__seeall { display: inline-flex; align-items: center; gap: var(--space-sm); font-size: var(--text-sm); font-weight: 600; color: var(--color-text); text-decoration: none; }
  .art__seeall svg { transition: transform var(--duration-fast) var(--ease-out); }
  .art__seeall:hover svg { transform: translateX(4px); }

  .art__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  @media (min-width: 900px) { .art__grid { grid-template-columns: 1.1fr 0.9fr; align-items: start; } }
  .art__col { display: flex; flex-direction: column; gap: var(--space-lg); }

  /* Single post: one constrained featured card — no empty second column. */
  .art__grid--single { max-width: 640px; }
  @media (min-width: 900px) { .art__grid--single { grid-template-columns: 1fr; } }

  .art__card {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: var(--radius-card); text-decoration: none; color: var(--color-text);
  }
  .art__card--sm { flex-direction: row; }
  .art__card--link { transition: transform var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out); }
  .art__card--link:hover { transform: translateY(-4px); border-color: var(--line-on-light-strong); box-shadow: var(--shadow-card); }

  /* Cover */
  .art__cover { position: relative; overflow: hidden; aspect-ratio: 16 / 9; display: flex; align-items: flex-end; padding: var(--space-md); }
  .art__cover--sm { aspect-ratio: auto; width: 38%; min-width: 116px; flex-shrink: 0; }
  .cov--blue { background: var(--color-blue); color: rgba(244,241,233,0.55); }
  .cov--yellow { background: var(--color-accent); color: rgba(20,20,10,0.4); }
  .cov--coral { background: var(--color-warm); color: rgba(244,241,233,0.6); }
  :global(.art__motif) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.9; }
  .art__cover-cat {
    position: relative; z-index: 1;
    font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .cov--blue .art__cover-cat, .cov--coral .art__cover-cat { color: var(--color-dark-text); }
  .cov--yellow .art__cover-cat { color: var(--color-accent-ink); }

  .art__body { display: flex; flex-direction: column; gap: var(--space-sm); padding: clamp(var(--space-md), 2vw, var(--space-lg)); flex: 1; }
  .art__card--lead .art__body { padding: clamp(var(--space-lg), 2.4vw, var(--space-xl)); gap: var(--space-md); }
  .art__title { font-size: var(--text-lg); line-height: 1.15; margin: 0; color: var(--color-text); }
  .art__title--lead { font-size: var(--text-2xl); line-height: 1.08; max-width: 18ch; }
  .art__card--link:hover .art__title { text-decoration: underline; text-underline-offset: 3px; }
  .art__excerpt { font-size: var(--text-base); line-height: 1.55; color: var(--color-text-secondary); margin: 0; max-width: 46ch; flex: 1; }
  .art__meta { display: flex; align-items: center; gap: var(--space-sm); font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: auto; }
  .art__dot { width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: 0.5; }
  .art__more { margin-left: auto; color: var(--color-text); font-weight: 600; }

  @media (max-width: 520px) {
    .art__card--sm { flex-direction: column; }
    .art__cover--sm { width: 100%; aspect-ratio: 16 / 7; }
  }
  @media (prefers-reduced-motion: reduce) { .art__card--link, .art__seeall svg { transition: none; } }
</style>
