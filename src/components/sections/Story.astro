---
/**
 * Story.astro — Personal story, warm editorial · source-locked
 *
 * Story copy is VERBATIM from Input homepage Milan.docx §Sectie 4 (4 paragraphs
 * + signature). Warm, light editorial spread: portrait + asymmetric reading
 * column. Modern sans throughout (no isolated serif treatment). The portrait is
 * NOT hidden behind a reveal — it always renders.
 *
 * Shared component: also the opening band on /mijn-verhaal & /en/about (the
 * teaser link is suppressed there via the isMijnVerhaalPage guard).
 */
import { Picture } from 'astro:assets';
import SectionWrapper from '../ui/SectionWrapper.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getStrings } from '../../i18n/utils';
import portraitSrc from '../../assets/photos/milan-story-portrait.jpg';
import signatureSrc from '../../assets/photos/milan-signature.png';
import { TODO_LINKEDIN_URL } from '../../config';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const { eyebrow, heading, body, signature, imageAlt } = t.story;
const linkedinLive = TODO_LINKEDIN_URL !== 'TODO_LINKEDIN_URL';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const norm = (p: string) => p.replace(/\/$/, '');
const isMijnVerhaalPage =
  norm(currentPath) === norm(`${base}mijn-verhaal`) ||
  norm(currentPath) === norm(`${base}en/about`);
const teaserLink = isEn ? getRelativeLocaleUrl('en', 'about') : `${base}mijn-verhaal`;
---

<SectionWrapper id="verhaal" labelledBy="story-heading" variant="warm">
  <div class="story">
    <div class="story__grid">
      <!-- Portrait — always visible (no reveal clip); data-parallax for subtle lift on scroll (260821-m2d) -->
      <figure class="story__portrait" data-parallax="0.05">
        <Picture
          src={portraitSrc}
          formats={['avif', 'webp']}
          widths={[400, 600, 900, 1200]}
          sizes="(max-width: 900px) 92vw, 42vw"
          alt={imageAlt}
          loading="lazy"
          class="story__portrait-img"
        />
      </figure>

      <!-- Reading column -->
      <div class="story__text" data-anim data-anim-variant="right">
        <p class="story__eyebrow">{eyebrow}</p>
        <h2 id="story-heading" class="story__heading">{heading}</h2>
        <div class="story__body">
          {body.map((p: string, i: number) => (
            <p class={i === 0 ? 'story__lede' : (i === body.length - 1 ? 'story__final' : undefined)}>{p}</p>
          ))}
        </div>
        <div class="story__sign">
          <img class="story__sign-mark" src={signatureSrc.src} width={signatureSrc.width} height={signatureSrc.height} alt="" aria-hidden="true" loading="lazy" />
          <div class="story__sign-row">
            <div class="story__sign-meta">
              <span class="story__sign-name">{signature}</span>
              <span class="story__sign-role">{isEn ? 'Founder, Coach & Speaker' : 'Founder, Coach & Spreker'}</span>
            </div>
            {linkedinLive && (
              <a
                class="story__sign-linkedin"
                href={TODO_LINKEDIN_URL}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.nav.linkedin}
                title={t.nav.linkedin}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                <span class="sr-only">{t.nav.linkedin}</span>
              </a>
            )}
          </div>
        </div>
        {!isMijnVerhaalPage && (
          <a href={teaserLink} class="story__teaser">{t.mijnVerhaal.teaserLink}</a>
        )}
      </div>
    </div>
  </div>
</SectionWrapper>

<style>
  .story { display: flex; flex-direction: column; }
  .story__grid { display: grid; grid-template-columns: 1fr; gap: clamp(var(--space-xl), 4vw, var(--space-4xl)); align-items: start; }
  @media (min-width: 900px) { .story__grid { grid-template-columns: 0.82fr 1fr; } }

  .story__portrait { margin: 0; border-radius: var(--radius-card); overflow: hidden; background: var(--color-surface); aspect-ratio: 4 / 5; }
  @media (min-width: 900px) { .story__portrait { position: sticky; top: var(--space-3xl); } }
  .story__portrait-img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; display: block; }

  .story__text { display: flex; flex-direction: column; gap: var(--space-lg); }
  .story__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-warm); margin: 0; }
  .story__heading { font-size: var(--text-3xl); line-height: 1.04; margin: 0; max-width: 20ch; }
  .story__body { display: flex; flex-direction: column; gap: var(--space-lg); max-width: 62ch; }
  .story__body p { font-size: var(--text-base); line-height: 1.68; color: var(--color-text-secondary); margin: 0; }
  .story__lede { font-size: var(--text-lg) !important; line-height: 1.55 !important; color: var(--color-text) !important; }
  /* Final sentence carries the promise — emphasised in the same sans system. */
  .story__final { color: var(--color-text) !important; font-weight: 500; }

  .story__sign { display: flex; flex-direction: column; gap: var(--space-sm); padding-top: var(--space-lg); border-top: 1px solid var(--line-on-light); }
  /* Handwritten signature (transparent PNG) — sits above the name. */
  .story__sign-mark { height: clamp(52px, 7vw, 72px); width: auto; display: block; margin-left: -2px; }
  .story__sign-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); flex-wrap: wrap; }
  .story__sign-meta { display: flex; flex-direction: column; gap: 2px; }
  .story__sign-name { font-size: var(--text-lg); font-weight: 680; color: var(--color-text); }
  .story__sign-role { font-size: var(--text-xs); letter-spacing: 0.04em; color: var(--color-text-secondary); }
  .story__sign-linkedin {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
    border: 1px solid var(--line-on-light-strong); color: var(--color-text);
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .story__sign-linkedin:hover { background: var(--color-text); color: var(--color-bg); }
  .story__sign-linkedin:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .story__sign-linkedin { transition: none; } }

  .story__teaser {
    display: inline-flex; align-self: flex-start; font-size: var(--text-sm); font-weight: 600;
    color: var(--color-text); text-decoration: underline; text-underline-offset: 4px;
    text-decoration-color: var(--line-on-light-strong);
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }
  .story__teaser:hover { text-decoration-color: var(--color-accent); }
  @media (prefers-reduced-motion: reduce) { .story__teaser { transition: none; } }
</style>
