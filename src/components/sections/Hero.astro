---
/**
 * Hero.astro — Professional editorial hero · v4.0
 *
 * Robust two-column grid: headline block LEFT, dominant photo RIGHT. No text
 * ever overlaps the photo; no absolute positioning of text content. One yellow
 * highlight on a key word. Track record sits in a clean full-width rule beneath
 * the grid (count-up on scroll). A small, calm coaching card docks under the
 * photo. On mobile everything stacks in a logical order.
 *
 * Preserves: locale strings (I18N), LCP eager photo, a11y landmarks,
 * reduced-motion, honest base-safe hrefs, id="hero-cta" (StickyCTA observer).
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Picture } from 'astro:assets';
import heroImage from '../../assets/photos/milan-hero-stage.jpg';
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const { eyebrow, h1, subtext, ctaPrimary, ctaSecondary, stats, card } = t.hero;

const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const contactHref = isEn
  ? getRelativeLocaleUrl('en', 'contact')
  : `${import.meta.env.BASE_URL}contact`;

// Highlight the final word of the headline (a single, clean yellow underline).
const words = h1.trim().split(/\s+/);
const lastWord = words.pop() ?? '';
const headLead = words.join(' ');

// Split a stat value like "12+" into number (for count-up) + suffix.
const parseStat = (v: string) => {
  const m = v.match(/^(\d+)(.*)$/);
  return m ? { num: m[1], suffix: m[2] } : { num: v, suffix: '' };
};
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__grid">

      <!-- Lead (above the fold — not hidden by the reveal system) -->
      <div class="hero__lead">
        <p class="hero__eyebrow rule-label">{eyebrow}</p>
        <h1 id="hero-heading" class="hero__title">
          {headLead} <span class="hl">{lastWord}</span>
        </h1>
        <p class="hero__subtext">{subtext}</p>
        <div class="hero__ctas" role="group" aria-label={isEn ? 'Actions' : 'Acties'}>
          <a id="hero-cta" href={contactHref} class="hero__cta hero__cta--primary">
            {ctaPrimary}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="#verhaal" class="hero__cta hero__cta--ghost">{ctaSecondary}</a>
        </div>
      </div>

      <!-- Photo + calm coaching card -->
      <div class="hero__media">
        <figure class="hero__figure">
          <Picture
            src={heroImage}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[640, 900, 1200, 1600]}
            sizes="(max-width: 1023px) 100vw, 46vw"
            alt={isEn
              ? 'Milan van der Meulen speaking on stage against a yellow and blue backdrop.'
              : 'Milan van der Meulen spreekt op het podium met geel en blauw decor.'}
            priority
            class="hero__photo"
          />
        </figure>

        <a href={contactHref} class="hero__card">
          <span class="hero__card-main">
            <span class="hero__card-eyebrow">{card.eyebrow}</span>
            <span class="hero__card-title">{card.title}</span>
          </span>
          <span class="hero__card-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Track record — clean full-width rule beneath the hero -->
    <dl class="hero__stats" aria-label={isEn ? 'Track record' : 'Trackrecord'}>
      {stats.map((s) => {
        const { num, suffix } = parseStat(s.value);
        return (
          <div class="hero__stat">
            <dt class="hero__stat-value">
              <span data-countup={num} data-suffix={suffix}>{s.value}</span>
            </dt>
            <dd class="hero__stat-label">{s.label}</dd>
          </div>
        );
      })}
    </dl>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-bg);
    overflow: clip;
    padding-top: clamp(var(--space-xl), 5vw, var(--space-3xl));
    padding-bottom: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }
  .hero__inner {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── Grid ─────────────────────────────────────────────────────────────── */
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(var(--space-xl), 4vw, var(--space-3xl));
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
      gap: clamp(var(--space-2xl), 4vw, var(--space-4xl));
    }
  }

  /* ── Lead ─────────────────────────────────────────────────────────────── */
  .hero__lead { display: flex; flex-direction: column; gap: var(--space-lg); min-width: 0; }
  .hero__eyebrow { margin: 0; }
  .hero__title {
    font-size: var(--text-5xl);
    line-height: 1.0;
    letter-spacing: -0.03em;
    font-weight: 720;
    color: var(--color-text);
    margin: 0;
    max-width: 15ch;
  }
  .hero__subtext {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 46ch;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: center; margin-top: var(--space-xs); }
  .hero__cta {
    display: inline-flex; align-items: center; gap: var(--space-sm);
    height: 54px; padding-inline: var(--space-lg);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.01em;
    text-decoration: none; cursor: pointer; border: 1px solid transparent;
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .hero__cta--primary { background-color: var(--color-text); color: var(--color-bg); }
  .hero__cta--primary:hover { background-color: #000; transform: translateY(-2px); }
  .hero__cta--primary svg { transition: transform var(--duration-fast) var(--ease-out); }
  .hero__cta--primary:hover svg { transform: translateX(3px); }
  .hero__cta--ghost { background: transparent; color: var(--color-text); border-color: var(--line-on-light-strong); }
  .hero__cta--ghost:hover { border-color: var(--color-text); transform: translateY(-2px); }

  /* ── Media column ─────────────────────────────────────────────────────── */
  .hero__media { position: relative; display: flex; flex-direction: column; gap: var(--space-md); min-width: 0; }
  .hero__figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--color-accent);
    aspect-ratio: 4 / 5;
  }
  /* Decorative offset panel behind the photo — never over any text. */
  .hero__figure::before {
    content: '';
    position: absolute;
    inset: auto -14px -14px auto;
    width: 62%;
    height: 62%;
    background: var(--color-navy);
    border-radius: var(--radius-card);
    z-index: -1;
  }
  .hero__figure :global(picture) { display: block; width: 100%; height: 100%; }
  .hero__figure :global(img.hero__photo) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block;
  }
  @media (min-width: 1024px) {
    .hero__figure { aspect-ratio: auto; height: clamp(460px, 62vh, 620px); }
  }

  /* Calm coaching card — solid surface, docked UNDER the photo (no overlap). */
  .hero__card {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-ink);
    color: var(--color-dark-text);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }
  .hero__card:hover { transform: translateY(-2px); }
  .hero__card-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .hero__card-eyebrow {
    font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-accent);
  }
  .hero__card-title { font-size: var(--text-base); font-weight: 600; color: var(--color-dark-text); }
  .hero__card-arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%;
    background: var(--color-accent); color: var(--color-accent-ink);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .hero__card:hover .hero__card-arrow { transform: translateX(3px); }

  /* ── Track record rule ────────────────────────────────────────────────── */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin: clamp(var(--space-2xl), 4vw, var(--space-3xl)) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line-on-light-strong);
  }
  .hero__stat { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .hero__stat-value {
    font-family: var(--font-sans);
    font-weight: 720;
    font-size: clamp(2rem, 1.2rem + 2.4vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  .hero__stat-label {
    margin: 0; font-size: var(--text-xs); font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-secondary);
  }

  /* ── Mobile order & sizing ────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .hero__title { font-size: clamp(2.5rem, 1.2rem + 6vw, 3.75rem); max-width: 16ch; }
    .hero__figure { aspect-ratio: 4 / 3; }
    .hero__figure :global(img.hero__photo) { object-position: 55% 16%; }
  }
  @media (max-width: 480px) {
    .hero__stats { gap: var(--space-md); }
    .hero__card { padding: var(--space-sm) var(--space-md); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cta, .hero__cta svg, .hero__card, .hero__card-arrow { transition: none; }
  }
</style>
