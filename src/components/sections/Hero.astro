---
/**
 * Hero.astro — Robust editorial hero (rebuild · 260821-m2d)
 *
 * Deliberately simple, unbreakable layout: a two-column grid on desktop
 * (text left, photo right) that stacks cleanly on mobile, with a full-width
 * proof/stats row below. NO absolute-positioned overlap, NO fragile column
 * math — the previous asymmetric composition collapsed on sub-900px viewports
 * (photo blowing out full-width, panel clipping off the left edge). This layout
 * cannot collapse: every piece lives in normal flow, the photo has a capped,
 * fixed aspect box so it never enlarges unexpectedly, and the headline can
 * never be clipped by an overlapping element.
 *
 * Preserves: headline (+ highlighted last word), authentic yellow photo,
 * id="hero-cta" (StickyCTA observer), count-up stats, base-safe hrefs, i18n,
 * fail-safe entrance animation (fully visible under prefers-reduced-motion / no-JS).
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Picture } from 'astro:assets';
import heroImage from '../../assets/photos/milan-hero-stage.jpg';
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const { eyebrow, h1, hlWord, subtext, ctaPrimary, ctaSecondary, stats, proofLine } = t.hero;

const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const contactHref = isEn ? getRelativeLocaleUrl('en', 'contact') : `${import.meta.env.BASE_URL}contact`;
// Secondary CTA now points at the dedicated "Mijn verhaal" page (Story removed from homepage per feedback).
const verhaalHref = isEn ? getRelativeLocaleUrl('en', 'about') : `${import.meta.env.BASE_URL}mijn-verhaal`;

// Highlight a specific word in the headline (feedback: underline 'schalen', not the last word).
const hlIdx = hlWord ? h1.toLowerCase().indexOf(hlWord.toLowerCase()) : -1;
const headBefore = hlIdx >= 0 ? h1.slice(0, hlIdx) : h1;
const headMatch  = hlIdx >= 0 ? h1.slice(hlIdx, hlIdx + hlWord.length) : '';
const headAfter  = hlIdx >= 0 ? h1.slice(hlIdx + hlWord.length) : '';

// Split a stat value into optional currency/tilde prefix + number + suffix so the
// count-up animation works even for "€200M" / "12+" / "~1M".
const parseStat = (v: string) => {
  const m = v.match(/^(\D*)(\d+)(.*)$/);
  return m ? { prefix: m[1], num: m[2], suffix: m[3] } : { prefix: '', num: v, suffix: '' };
};
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow" style="--d: 1">{eyebrow}</p>
      <h1 id="hero-heading" class="hero__title" style="--d: 2">
        {headBefore}<span class="hl">{headMatch}</span>{headAfter}
      </h1>
      <p class="hero__subtext" style="--d: 3">{subtext}</p>
      <div class="hero__ctas" role="group" aria-label={isEn ? 'Actions' : 'Acties'} style="--d: 4">
        <a id="hero-cta" href={contactHref} class="hero__cta hero__cta--primary">
          {ctaPrimary}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={verhaalHref} class="hero__cta hero__cta--ghost">{ctaSecondary}</a>
      </div>
    </div>

    <div class="hero__media">
      <!--
        One bold, intentional element (no scattered icons): a solid yellow brand
        slab offset behind the photo so it peeks at the edges and reads as a
        confident layered composition. Contained in this relative wrapper,
        pointer-events:none + aria-hidden; the section clips overflow so the
        robust grid above cannot be disturbed (hero-fragile-avoid-absolute-overlap).
      -->
      <span class="hero__accent" aria-hidden="true"></span>

      <figure class="hero__figure">
        <!-- Parallax wrapper: scroll-linked scale/drift (motion.css) lives here so
             it never fights the image's one-time load reveal on .hero__photo. -->
        <div class="hero__parallax">
          <Picture
            src={heroImage}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[640, 900, 1200, 1600, 2000]}
            sizes="(max-width: 899px) 100vw, 52vw"
            alt={isEn
              ? 'Milan van der Meulen speaking on stage against a yellow and blue backdrop.'
              : 'Milan van der Meulen spreekt op het podium met geel en blauw decor.'}
            priority
            class="hero__photo"
          />
        </div>
      </figure>
    </div>
  </div>

  <!-- Full-width proof + stats row — normal flow, hairline top rule (no overlap) -->
  <div class="hero__proof">
    <p class="hero__proof-line">{proofLine}</p>
    <dl class="hero__stats" aria-label={isEn ? 'Track record' : 'Trackrecord'}>
      {stats.map((s) => {
        const { prefix, num, suffix } = parseStat(s.value);
        return (
          <div class="hero__stat">
            <dt class="hero__stat-value"><span data-countup={num} data-countup-prefix={prefix} data-suffix={suffix}>{s.value}</span></dt>
            <dd class="hero__stat-label">{s.label}</dd>
          </div>
        );
      })}
    </dl>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-bg);
    overflow: clip;
    padding-top: clamp(var(--space-lg), 3vw, var(--space-2xl));
    padding-bottom: clamp(var(--space-2xl), 4vw, var(--space-4xl));
  }

  /* Shared width container — inner grid and proof row align to the same measure. */
  .hero__inner,
  .hero__proof {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── Base (mobile-first): clean vertical stack ─────────────────────────── */
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-lg), 4vw, var(--space-2xl));
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-md), 1.6vw, var(--space-lg));
  }
  .hero__eyebrow {
    font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--color-text-secondary); margin: 0;
  }
  .hero__title {
    font-size: clamp(2rem, 1.15rem + 3.4vw, 3.5rem);
    line-height: 1.03; letter-spacing: -0.03em; font-weight: 730;
    color: var(--color-text); margin: 0; max-width: 16ch; text-wrap: balance;
  }
  .hero__subtext {
    font-size: var(--text-lg); line-height: 1.5;
    color: var(--color-text-secondary); margin: 0; max-width: 46ch;
  }
  .hero__ctas {
    display: flex; flex-wrap: wrap; gap: var(--space-sm);
    align-items: center; margin-top: var(--space-xs);
  }
  .hero__cta {
    display: inline-flex; align-items: center; gap: var(--space-sm);
    height: 54px; padding-inline: var(--space-lg); border-radius: var(--radius-pill);
    font-size: var(--text-sm); font-weight: 600; text-decoration: none; cursor: pointer;
    border: 1px solid transparent;
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .hero__cta--primary { background-color: var(--color-text); color: var(--color-bg); }
  .hero__cta--primary:hover { background-color: #000; transform: translateY(-2px); }
  .hero__cta--primary svg { transition: transform var(--duration-fast) var(--ease-out); }
  .hero__cta--primary:hover svg { transform: translateX(3px); }
  .hero__cta--ghost { background: transparent; color: var(--color-text); border-color: var(--line-on-light-strong); }
  .hero__cta--ghost:hover { border-color: var(--color-text); transform: translateY(-2px); }

  /* ── Media wrapper — positioning context for the bold accent slab ──────────
     The photo sits on top; the accent is absolutely positioned against this
     wrapper only, so the robust grid above cannot be disturbed. */
  .hero__media { position: relative; width: 100%; }

  /* Bold brand slab — offset behind the photo, peeking at the edges. */
  .hero__accent {
    position: absolute; z-index: 0; pointer-events: none;
    inset: 0;
    border-radius: clamp(20px, 2vw, 32px);
    background: var(--color-accent);
    transform: translate(-18px, 20px) scale(0.98);
    transform-origin: bottom left;
    opacity: 0;
    animation: heroAccentIn 900ms var(--ease-out) 160ms both;
  }

  /* ── Photograph — big, commanding, lifted off the page ─────────────────── */
  .hero__figure {
    position: relative; z-index: 1;
    margin: 0;
    border-radius: clamp(20px, 2vw, 32px);
    overflow: hidden;
    background: var(--color-accent);
    aspect-ratio: 4 / 5;        /* mobile: strong portrait presence */
    box-shadow: var(--shadow-float);
  }
  /* Parallax wrapper fills the clipped figure; scroll-linked transform in motion.css. */
  .hero__parallax { position: absolute; inset: 0; }
  .hero__figure :global(picture) { display: block; width: 100%; height: 100%; }
  .hero__figure :global(img.hero__photo) {
    width: 100%; height: 100%; object-fit: cover;
    /* Shift the crop left + a touch down so his gesturing hands stay in frame
       (they sit at the lower-left of the source) instead of being cut off. */
    object-position: 36% 32%;
    display: block;
    animation: heroReveal 1200ms var(--ease-out) both;
  }

  /* ── Proof + stats row — full width, hairline top rule, normal flow ────── */
  .hero__proof {
    margin-top: clamp(var(--space-xl), 4vw, var(--space-3xl));
    padding-top: clamp(var(--space-lg), 2vw, var(--space-xl));
    border-top: 1px solid var(--line-on-light);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .hero__proof-line {
    font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-text-secondary); margin: 0;
  }
  .hero__stats {
    display: flex; flex-wrap: wrap;
    gap: clamp(var(--space-lg), 4vw, var(--space-4xl));
    margin: 0;
  }
  .hero__stat { display: flex; flex-direction: column; gap: 2px; }
  .hero__stat-value {
    font-weight: 720; font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1; letter-spacing: -0.03em; color: var(--color-text);
  }
  .hero__stat-label {
    margin: 0; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--color-text-secondary);
  }

  /* ── Desktop: text left, full-bleed photo running to the right screen edge ──
     The inner grid drops its max-width and right padding so the media column
     reaches the viewport edge (magazine-cover feel). The left padding is
     computed to stay aligned with the rest of the site's container, so the copy
     lines up with every section below. Section overflow:clip is the safety net —
     nothing can ever cause a horizontal scrollbar. */
  @media (min-width: 900px) {
    .hero__inner {
      max-width: none;
      margin-inline: 0;
      padding-left: max(var(--gutter), calc((100vw - var(--max-width)) / 2 + var(--gutter)));
      padding-right: 0;
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.28fr);
      align-items: stretch;                /* photo fills the row height */
      gap: clamp(var(--space-2xl), 5vw, var(--space-4xl));
      min-height: min(90vh, 880px);        /* commands the viewport on open */
    }
    .hero__text { justify-content: center; }   /* vertically centre the copy */
    .hero__title { font-size: clamp(3.2rem, 1.1rem + 4.6vw, 5rem); }
    .hero__media { height: 100%; justify-self: stretch; }
    .hero__figure {
      aspect-ratio: auto;                  /* height-driven, not aspect-capped */
      height: 100%;
      width: 100%;
      /* Square the right corners — they sit on the screen edge. */
      border-radius: clamp(20px, 2vw, 32px) 0 0 clamp(20px, 2vw, 32px);
    }
    .hero__accent {
      border-radius: clamp(20px, 2vw, 32px) 0 0 clamp(20px, 2vw, 32px);
    }
  }

  /* ── Entrance animation (fail-safe: element fully visible if disabled) ─── */
  .hero__eyebrow, .hero__title, .hero__subtext, .hero__ctas {
    animation: heroRise 700ms var(--ease-out) both;
    animation-delay: calc(var(--d, 0) * 90ms + 120ms);
  }
  /* Photo entrance: a left→right wipe with a slow inward settle (Ken Burns). */
  @keyframes heroReveal {
    from { clip-path: inset(0 100% 0 0); transform: scale(1.1); }
    to   { clip-path: inset(0 0 0 0);   transform: scale(1); }
  }
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }
  /* Accent slab settles into its offset resting position. */
  @keyframes heroAccentIn {
    from { opacity: 0; transform: translate(0, 0) scale(0.9); }
    to   { opacity: 1; transform: translate(-18px, 20px) scale(0.98); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__photo, .hero__eyebrow, .hero__title, .hero__subtext, .hero__ctas { animation: none !important; }
    .hero__cta, .hero__cta svg { transition: none; }
    /* Accent: pin to final resting state, no motion. */
    .hero__accent { animation: none !important; opacity: 1; transform: translate(-18px, 20px) scale(0.98); }
  }
</style>
