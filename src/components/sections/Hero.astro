---
/**
 * Hero.astro — One cohesive contained composition · correction pass
 *
 * A single rounded hero panel with a SHARED background holds the headline block
 * and the authentic yellow photograph as one designed unit (photo flush to the
 * panel edge — not a detached floating column). Headline stays ≤3 lines at 1440px
 * in a generous text column; the track record is integrated inside the panel.
 * On mobile the photo leads so the image is visible immediately, and the headline
 * is reduced. No text overlaps the photo; no absolute-positioned text.
 *
 * Preserves: locale strings, LCP eager photo, id="hero-cta" (StickyCTA observer),
 * count-up stats, reduced-motion, base-safe hrefs.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Picture } from 'astro:assets';
import heroImage from '../../assets/photos/milan-hero-stage.jpg';
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const { eyebrow, h1, subtext, ctaPrimary, ctaSecondary, stats } = t.hero;

const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const contactHref = isEn ? getRelativeLocaleUrl('en', 'contact') : `${import.meta.env.BASE_URL}contact`;

// Highlight the final word of the headline with a single restrained yellow underline.
const words = h1.trim().split(/\s+/);
const lastWord = words.pop() ?? '';
const headLead = words.join(' ');

const parseStat = (v: string) => {
  const m = v.match(/^(\d+)(.*)$/);
  return m ? { num: m[1], suffix: m[2] } : { num: v, suffix: '' };
};
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__panel">
    <div class="hero__content">
      <p class="hero__eyebrow">{eyebrow}</p>
      <h1 id="hero-heading" class="hero__title">
        {headLead} <span class="hl">{lastWord}</span>
      </h1>
      <p class="hero__subtext">{subtext}</p>
      <div class="hero__ctas" role="group" aria-label={isEn ? 'Actions' : 'Acties'}>
        <a id="hero-cta" href={contactHref} class="hero__cta hero__cta--primary">
          {ctaPrimary}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#verhaal" class="hero__cta hero__cta--ghost">{ctaSecondary}</a>
      </div>

      <dl class="hero__stats" aria-label={isEn ? 'Track record' : 'Trackrecord'}>
        {stats.map((s) => {
          const { num, suffix } = parseStat(s.value);
          return (
            <div class="hero__stat">
              <dt class="hero__stat-value"><span data-countup={num} data-suffix={suffix}>{s.value}</span></dt>
              <dd class="hero__stat-label">{s.label}</dd>
            </div>
          );
        })}
      </dl>
    </div>

    <figure class="hero__figure">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[640, 900, 1200, 1600]}
        sizes="(max-width: 899px) 100vw, 44vw"
        alt={isEn
          ? 'Milan van der Meulen speaking on stage against a yellow and blue backdrop.'
          : 'Milan van der Meulen spreekt op het podium met geel en blauw decor.'}
        priority
        class="hero__photo"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-bg);
    overflow: clip;
    padding-top: clamp(var(--space-md), 2.5vw, var(--space-xl));
    padding-bottom: clamp(var(--space-2xl), 4vw, var(--space-4xl));
  }

  /* One contained composition — shared panel background unifies text + photo. */
  .hero__panel {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    /* Panel breaks slightly out of the standard gutter for presence, but stays contained. */
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: clamp(20px, 2.4vw, 32px);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .hero__panel { grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); align-items: stretch; }
  }

  /* ── Content ──────────────────────────────────────────────────────────── */
  .hero__content {
    display: flex; flex-direction: column;
    gap: clamp(var(--space-md), 1.6vw, var(--space-lg));
    padding: clamp(var(--space-xl), 3.5vw, var(--space-4xl));
    min-width: 0;
    justify-content: center;
  }
  .hero__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .hero__title {
    font-size: clamp(2rem, 1.1rem + 2.6vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 720;
    color: var(--color-text);
    margin: 0;
    max-width: 18ch;   /* keeps the headline to ≤3 lines at 1440px */
    text-wrap: balance;
  }
  .hero__subtext { font-size: var(--text-lg); line-height: 1.5; color: var(--color-text-secondary); margin: 0; max-width: 44ch; }

  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: center; margin-top: var(--space-xs); }
  .hero__cta {
    display: inline-flex; align-items: center; gap: var(--space-sm);
    height: 54px; padding-inline: var(--space-lg); border-radius: var(--radius-pill);
    font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.01em;
    text-decoration: none; cursor: pointer; border: 1px solid transparent;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .hero__cta--primary { background-color: var(--color-text); color: var(--color-bg); }
  .hero__cta--primary:hover { background-color: #000; transform: translateY(-2px); }
  .hero__cta--primary svg { transition: transform var(--duration-fast) var(--ease-out); }
  .hero__cta--primary:hover svg { transform: translateX(3px); }
  .hero__cta--ghost { background: transparent; color: var(--color-text); border-color: var(--line-on-light-strong); }
  .hero__cta--ghost:hover { border-color: var(--color-text); transform: translateY(-2px); }

  /* Track record — integrated inside the panel */
  .hero__stats {
    display: grid; grid-template-columns: repeat(3, auto); justify-content: start;
    gap: clamp(var(--space-lg), 3vw, var(--space-2xl));
    margin: var(--space-md) 0 0; padding-top: var(--space-lg);
    border-top: 1px solid var(--line-on-light-strong);
  }
  .hero__stat { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .hero__stat-value { font-weight: 720; font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.6rem); line-height: 1; letter-spacing: -0.03em; color: var(--color-text); }
  .hero__stat-label { margin: 0; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-secondary); }

  /* ── Photo — flush to the panel edge (part of the composition) ─────────── */
  .hero__figure { position: relative; margin: 0; background: var(--color-accent); min-height: 100%; }
  .hero__figure :global(picture) { display: block; width: 100%; height: 100%; }
  .hero__figure :global(img.hero__photo) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block; }

  /* ── Mobile: photo leads (visible immediately), headline reduced ───────── */
  @media (max-width: 899px) {
    .hero__panel { display: flex; flex-direction: column; }
    .hero__figure { order: -1; aspect-ratio: 16 / 11; min-height: 0; }
    .hero__figure :global(img.hero__photo) { object-position: 55% 16%; }
    .hero__content { padding: clamp(var(--space-lg), 5vw, var(--space-2xl)); }
    .hero__title { font-size: clamp(1.9rem, 1.2rem + 4vw, 2.6rem); max-width: 20ch; }
    .hero__subtext { font-size: var(--text-base); }
    .hero__stats { gap: var(--space-lg); }
  }
  @media (max-width: 400px) {
    .hero__stats { grid-template-columns: repeat(3, auto); gap: var(--space-md); }
    .hero__stat-value { font-size: 1.6rem; }
  }

  @media (prefers-reduced-motion: reduce) { .hero__cta, .hero__cta svg { transition: none; } }
</style>
