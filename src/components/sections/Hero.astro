---
/**
 * Hero.astro — Asymmetric editorial composition · evolution
 *
 * Deliberate art-direction (not a 50/50 template): the photograph occupies ~58%
 * on the right; a cream editorial panel on the left overlaps its edge (one strong
 * layering gesture). A single compact dark proof-card floats over the bottom seam
 * between panel and photo, carrying only the verified proof points + one narrative
 * proof line. Subtle CSS-only entrance: image mask-reveal + staggered headline —
 * both fail-safe (fully visible under prefers-reduced-motion or without JS).
 *
 * Preserves: headline, authentic yellow photo, id="hero-cta" (StickyCTA observer),
 * count-up stats, base-safe hrefs.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Picture } from 'astro:assets';
import heroImage from '../../assets/photos/milan-hero-stage.jpg';
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const { eyebrow, h1, subtext, ctaPrimary, ctaSecondary, stats, proofLine } = t.hero;

const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const contactHref = isEn ? getRelativeLocaleUrl('en', 'contact') : `${import.meta.env.BASE_URL}contact`;

const words = h1.trim().split(/\s+/);
const lastWord = words.pop() ?? '';
const headLead = words.join(' ');

const parseStat = (v: string) => {
  const m = v.match(/^(\d+)(.*)$/);
  return m ? { num: m[1], suffix: m[2] } : { num: v, suffix: '' };
};
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__stage">
    <figure class="hero__figure">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[640, 900, 1200, 1600]}
        sizes="(max-width: 899px) 100vw, 60vw"
        alt={isEn
          ? 'Milan van der Meulen speaking on stage against a yellow and blue backdrop.'
          : 'Milan van der Meulen spreekt op het podium met geel en blauw decor.'}
        priority
        class="hero__photo"
      />
    </figure>

    <div class="hero__panel">
      <p class="hero__eyebrow" style="--d: 1">{eyebrow}</p>
      <h1 id="hero-heading" class="hero__title" style="--d: 2">
        {headLead} <span class="hl">{lastWord}</span>
      </h1>
      <p class="hero__subtext" style="--d: 3">{subtext}</p>
      <div class="hero__ctas" role="group" aria-label={isEn ? 'Acties' : 'Actions'} style="--d: 4">
        <a id="hero-cta" href={contactHref} class="hero__cta hero__cta--primary">
          {ctaPrimary}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#verhaal" class="hero__cta hero__cta--ghost">{ctaSecondary}</a>
      </div>
    </div>

    <!-- Floating proof-card — overlaps the seam between panel and photo -->
    <div class="hero__proof">
      <p class="hero__proof-line">{proofLine}</p>
      <dl class="hero__stats" aria-label={isEn ? 'Track record' : 'Trackrecord'}>
        {stats.map((s) => {
          const { num, suffix } = parseStat(s.value);
          return (
            <div class="hero__stat">
              <dt class="hero__stat-value"><span data-countup={num} data-suffix={suffix}>{s.value}</span></dt>
              <dd class="hero__stat-label">{s.label}</dd>
            </div>
          );
        })}
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-bg);
    overflow: clip;
    padding-top: clamp(var(--space-md), 2.5vw, var(--space-xl));
    padding-bottom: clamp(var(--space-3xl), 5vw, var(--space-5xl));
  }
  .hero__stage {
    position: relative;
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── Photograph (right ~58%) ──────────────────────────────────────────── */
  .hero__figure {
    margin: 0;
    border-radius: clamp(16px, 1.6vw, 24px);
    overflow: hidden;
    background: var(--color-accent);
  }
  .hero__figure :global(picture) { display: block; width: 100%; height: 100%; }
  .hero__figure :global(img.hero__photo) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 16%; display: block;
    animation: heroMask 1100ms var(--ease-out) both;
  }

  /* ── Cream editorial panel (overlaps the photo) ───────────────────────── */
  .hero__panel {
    background: #FBFAF5;
    border: 1px solid var(--color-border);
    border-radius: clamp(16px, 1.6vw, 22px);
    padding: clamp(var(--space-lg), 3vw, var(--space-3xl));
    box-shadow: var(--shadow-card);
    display: flex; flex-direction: column;
    gap: clamp(var(--space-md), 1.4vw, var(--space-lg));
  }
  .hero__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .hero__title {
    font-size: clamp(2rem, 1.15rem + 2.5vw, 3.5rem);
    line-height: 1.02; letter-spacing: -0.03em; font-weight: 730;
    color: var(--color-text); margin: 0; max-width: 15ch; text-wrap: balance;
  }
  .hero__subtext { font-size: var(--text-lg); line-height: 1.5; color: var(--color-text-secondary); margin: 0; max-width: 40ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: center; margin-top: var(--space-xs); }
  .hero__cta {
    display: inline-flex; align-items: center; gap: var(--space-sm);
    height: 54px; padding-inline: var(--space-lg); border-radius: var(--radius-pill);
    font-size: var(--text-sm); font-weight: 600; text-decoration: none; cursor: pointer; border: 1px solid transparent;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .hero__cta--primary { background-color: var(--color-text); color: var(--color-bg); }
  .hero__cta--primary:hover { background-color: #000; transform: translateY(-2px); }
  .hero__cta--primary svg { transition: transform var(--duration-fast) var(--ease-out); }
  .hero__cta--primary:hover svg { transform: translateX(3px); }
  .hero__cta--ghost { background: transparent; color: var(--color-text); border-color: var(--line-on-light-strong); }
  .hero__cta--ghost:hover { border-color: var(--color-text); transform: translateY(-2px); }

  /* ── Floating dark proof-card ─────────────────────────────────────────── */
  .hero__proof {
    background: var(--color-ink);
    color: var(--color-dark-text);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-md), 1.6vw, var(--space-lg)) clamp(var(--space-lg), 2vw, var(--space-xl));
    box-shadow: var(--shadow-float);
    display: flex; flex-direction: column; gap: var(--space-md);
  }
  .hero__proof-line { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin: 0; }
  .hero__stats { display: grid; grid-template-columns: repeat(3, auto); gap: clamp(var(--space-md), 2vw, var(--space-xl)); margin: 0; }
  .hero__stat { display: flex; flex-direction: column; gap: 2px; }
  .hero__stat-value { font-weight: 720; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem); line-height: 1; letter-spacing: -0.03em; color: var(--color-dark-text); }
  .hero__stat-label { margin: 0; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; color: var(--color-dark-text-soft); }

  /* ── Desktop: asymmetric overlap composition (grid + one absolute card) ── */
  @media (min-width: 900px) {
    .hero__stage {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      align-items: center;
      min-height: clamp(540px, 74vh, 720px);
    }
    .hero__figure { grid-column: 6 / 13; grid-row: 1; height: clamp(500px, 72vh, 700px); }
    .hero__panel {
      grid-column: 1 / 7; grid-row: 1; z-index: 2;
      align-self: center;
      max-width: 560px;
    }
    /* Proof-card straddles the bottom seam between panel and photo. */
    .hero__proof {
      position: absolute; z-index: 3;
      left: clamp(34%, 38%, 42%);
      bottom: clamp(-18px, -1.4vw, 10px);
      width: min(420px, 42%);
    }
  }

  /* ── Mobile/tablet: photo leads, panel below, proof-card inline (simplified) */
  @media (max-width: 899px) {
    .hero__stage { display: flex; flex-direction: column; gap: var(--space-lg); }
    .hero__figure { order: -1; aspect-ratio: 16 / 11; }
    .hero__figure :global(img.hero__photo) { object-position: 55% 14%; }
    .hero__title { font-size: clamp(1.9rem, 1.2rem + 4vw, 2.7rem); max-width: 20ch; }
    .hero__subtext { font-size: var(--text-base); }
    .hero__proof { position: static; width: 100%; }
    .hero__panel { box-shadow: none; }
  }

  /* ── Entrance animation (fail-safe: element visible if animation disabled) ── */
  .hero__eyebrow, .hero__title, .hero__subtext, .hero__ctas {
    animation: heroRise 720ms var(--ease-out) both;
    animation-delay: calc(var(--d, 0) * 90ms + 120ms);
  }
  @keyframes heroMask {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__photo, .hero__eyebrow, .hero__title, .hero__subtext, .hero__ctas { animation: none !important; }
    .hero__cta, .hero__cta svg { transition: none; }
  }
</style>
