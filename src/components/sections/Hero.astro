---
/**
 * Hero.astro — Magazine-cover hero (HOME-02) · v2.1
 * The photograph is the dominant, near-page-wide visual plane. The authentic
 * yellow stage backdrop is the art direction: kept generous, echoed in the
 * primary CTA + accent line. Headline and stats sit over the open yellow/blue
 * area on the LEFT so Milan (right) is never covered by text, nav or buttons.
 *
 * Desktop: content overlays the full-bleed image (cover composition).
 * Mobile: large image with the character-crop around Milan (yellow kept),
 *         headline/CTAs/stats stacked below on cream for legibility.
 *
 * Preserves: locale strings (I18N), LCP eager photo (FND-10), a11y landmarks,
 * reduced-motion, honest base-safe hrefs.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Picture } from 'astro:assets';
import heroImage from '../../assets/photos/milan-hero-stage.jpg';
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const { eyebrow, h1, subtext, ctaPrimary, ctaSecondary, stats } = t.hero;

const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const contactHref = isEn
  ? getRelativeLocaleUrl('en', 'contact')
  : `${import.meta.env.BASE_URL}contact`;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__media">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[640, 1024, 1440, 1920, 2400]}
        sizes="100vw"
        alt={isEn
          ? 'Milan van der Meulen speaking on stage against a yellow and blue backdrop.'
          : 'Milan van der Meulen spreekt op het podium met geel en blauw decor.'}
        priority
        class="hero__photo"
      />
    </div>

    <div class="hero__lead">
      <p class="hero__eyebrow eyebrow">{eyebrow}</p>
      <h1 id="hero-heading" class="hero__title">{h1}</h1>
      <p class="hero__subtext">{subtext}</p>
      <div class="hero__ctas" role="group" aria-label={isEn ? 'Actions' : 'Acties'}>
        <a id="hero-cta" href={contactHref} class="hero__cta-primary btn btn--primary">{ctaPrimary}</a>
        <a href="#verhaal" class="hero__cta-secondary btn btn--secondary">{ctaSecondary}</a>
      </div>
    </div>

    <dl class="hero__stats" aria-label={isEn ? 'Track record' : 'Trackrecord'}>
      {stats.map((s) => (
        <div class="hero__stat">
          <dt class="hero__stat-value">{s.value}</dt>
          <dd class="hero__stat-label">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--space-sm), 1.6vw, var(--space-lg)) clamp(var(--space-2xl), 5vw, var(--space-4xl));
    background-color: var(--color-bg);
  }

  /* Near-page-wide stage. ~94vw on desktop (breaks out of the content container),
     capped so it stays composed on ultra-wide screens. The photo and the
     overlay content share one grid cell so text layers reliably over the image. */
  .hero__inner {
    width: min(1680px, 94vw);
    margin-inline: auto;
    display: grid;
    grid-template-areas: 'stack';
  }
  .hero__media, .hero__lead, .hero__stats { grid-area: stack; }

  /* ── Dominant photo plane ─────────────────────────────────────────────── */
  .hero__media {
    position: relative;
    width: 100%;
    border-radius: clamp(20px, 2vw, 34px);
    overflow: hidden;
    background-color: var(--color-accent); /* yellow shows through before load */
    height: clamp(560px, 78vh, 780px);
    z-index: 0;
  }
  .hero__media :global(picture) { display: block; width: 100%; height: 100%; }
  .hero__media :global(img.hero__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep Milan (right) + the generous yellow in frame, not cropped tight. */
    object-position: 52% 24%;
    display: block;
  }

  /* ── Lead (eyebrow, headline, intro, CTAs) — overlays the open left area ── */
  .hero__lead {
    align-self: start;
    justify-self: start;
    z-index: 2;
    margin: clamp(var(--space-lg), 3vw, var(--space-3xl));
    max-width: min(46%, 560px);
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-sm), 1.2vw, var(--space-md));
    color: var(--color-text); /* near-black on the bright yellow — brand contrast */
    pointer-events: none;
  }
  .hero__lead > * { pointer-events: auto; }
  .hero__eyebrow { margin: 0; color: var(--color-text); opacity: 0.72; }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 1rem + 4.6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 11ch;   /* keep the headline clear of Milan (right of frame) */
    text-wrap: balance;
    margin: 0;
  }

  .hero__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text);
    opacity: 0.82;
    max-width: 34ch;
    margin: 0;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    margin-top: var(--space-xs);
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 50px; padding: 0 var(--space-lg); border-radius: 10px;
    font-family: var(--font-body); font-size: 15px; font-weight: 600;
    letter-spacing: 0.005em; line-height: 1; text-decoration: none; cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  /* Primary CTA carries the photo's signature yellow. */
  .btn--primary { background-color: var(--color-accent); color: var(--color-text); border: 1px solid var(--color-accent); }
  .btn--primary:hover { background-color: var(--color-accent-dark); border-color: var(--color-accent-dark); transform: translateY(-1px); }
  /* Secondary reads on the bright backdrop: solid near-black. */
  .btn--secondary { background-color: var(--color-text); color: var(--color-bg); border: 1px solid var(--color-text); }
  .btn--secondary:hover { background-color: #000; transform: translateY(-1px); }

  /* ── Stats — over the open lower-left of the image ─────────────────────── */
  .hero__stats {
    align-self: end;
    justify-self: start;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(var(--space-lg), 2.4vw, var(--space-2xl));
    margin: clamp(var(--space-lg), 3vw, var(--space-3xl));
    padding-top: var(--space-sm);
    border-top: 2px solid var(--color-text);
  }
  .hero__stat { display: flex; flex-direction: column; gap: 0; }
  .hero__stat-value {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(1.6rem, 1rem + 1.5vw, 2.4rem); line-height: 1;
    letter-spacing: -0.02em; color: var(--color-text);
  }
  .hero__stat-label {
    margin: 0; font-family: var(--font-body); font-size: var(--text-xs);
    font-weight: 600; letter-spacing: 0.02em; color: var(--color-text); opacity: 0.72;
  }

  /* ── Mobile: big character-cropped photo, content stacked below on cream ── */
  @media (max-width: 767px) {
    /* Unstack the grid: big character-cropped photo, then content below on cream. */
    .hero__inner { display: block; }
    .hero__media {
      height: clamp(440px, 68vh, 600px);
    }
    .hero__media :global(img.hero__photo) {
      object-position: 60% 16%; /* crop around Milan, keep the yellow behind him */
    }
    .hero__lead {
      max-width: none;
      margin: var(--space-lg) var(--space-xs) 0;
    }
    .hero__title { font-size: clamp(2.4rem, 1rem + 8vw, 3.2rem); max-width: 18ch; }
    .hero__subtext { opacity: 0.7; color: var(--color-text-secondary); }
    .hero__stats {
      margin: var(--space-lg) var(--space-xs) 0;
      border-top: none;
      gap: var(--space-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn { transition: none; }
  }
</style>
