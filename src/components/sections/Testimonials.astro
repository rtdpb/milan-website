---
/**
 * Testimonials.astro — Deep dark testimonials · v4.0
 *
 * A deep ink band. One dominant quote set large in modern sans (no odd italics
 * on a text block), with a single yellow quote mark; two supporting testimonials
 * below in deliberately different formats. Exactly 3 supplied quotes — verbatim,
 * no fabricated stats or star ratings (D-08, HOME-11).
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const { eyebrow, heading, items } = t.testimonials;
type TestimonialItem = { quote: string; name: string; role: string };
const allItems = items as unknown as TestimonialItem[];
const [feature, ...supporting] = allItems;
---

<SectionWrapper id="getuigenissen" labelledBy="testimonials-heading" variant="ink">
  <div class="tst">
    <header class="tst__head" data-anim>
      <p class="tst__eyebrow">{eyebrow}</p>
      <h2 id="testimonials-heading" class="tst__heading">{heading}</h2>
    </header>

    <figure class="tst__feature" data-anim data-anim-variant="scale">
      <span class="tst__mark" aria-hidden="true">&ldquo;</span>
      <blockquote class="tst__feature-quote"><p>{feature.quote}</p></blockquote>
      <figcaption class="tst__attr tst__attr--dark">
        <cite class="tst__name">{feature.name}</cite>
        {feature.role && <span class="tst__role">{feature.role}</span>}
      </figcaption>
    </figure>

    <div class="tst__row">
      {supporting.map((c, i) => (
        <figure class={`tst__support ${i === 0 ? 'tst__support--card' : 'tst__support--rule'}`} data-anim data-anim-variant={i === 0 ? 'left' : 'right'} style={`--i: ${i + 1}`}>
          <blockquote class="tst__support-quote"><p>{c.quote}</p></blockquote>
          <figcaption class="tst__attr">
            <cite class="tst__name">{c.name}</cite>
            {c.role && <span class="tst__role">{c.role}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</SectionWrapper>

<style>
  .tst { display: flex; flex-direction: column; gap: clamp(var(--space-xl), 4vw, var(--space-3xl)); }
  .tst__head { display: flex; flex-direction: column; gap: var(--space-md); max-width: 40ch; }
  .tst__eyebrow { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin: 0; }
  .tst__heading { font-size: var(--text-3xl); margin: 0; color: var(--color-dark-text); }

  /* Featured */
  .tst__feature {
    position: relative; margin: 0;
    background: var(--color-ink-2);
    border: 1px solid var(--line-on-dark);
    border-radius: var(--radius-card);
    padding: clamp(var(--space-xl), 3.5vw, var(--space-3xl));
    overflow: hidden;
  }
  .tst__mark { display: block; font-family: var(--font-serif); font-size: clamp(3rem, 1.8rem + 4vw, 5rem); line-height: 0.6; color: var(--color-accent); height: 0.5em; user-select: none; }
  .tst__feature-quote { margin: 0; }
  .tst__feature-quote p {
    font-family: var(--font-sans); font-weight: 500;
    font-size: var(--text-2xl); line-height: 1.24; letter-spacing: -0.01em;
    color: var(--color-dark-text); margin: 0; max-width: 30ch;
  }

  .tst__attr { display: flex; flex-direction: column; gap: 2px; margin-top: var(--space-lg); padding-top: var(--space-md); border-top: 1px solid var(--line-on-light); }
  .tst__attr--dark { border-top-color: var(--line-on-dark); }
  .tst__name { font-style: normal; font-size: var(--text-base); font-weight: 600; color: inherit; }
  .tst__role { font-size: var(--text-sm); color: var(--color-text-secondary); }
  .tst__attr--dark .tst__role { color: var(--color-dark-text-soft); }
  .tst__feature .tst__name { color: var(--color-dark-text); }

  .tst__row { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  @media (min-width: 768px) { .tst__row { grid-template-columns: 1fr 1fr; gap: var(--space-xl); } }
  .tst__support { margin: 0; display: flex; flex-direction: column; color: var(--color-dark-text); }
  .tst__support-quote { margin: 0; flex: 1; }
  .tst__support-quote p { font-size: var(--text-lg); line-height: 1.4; color: var(--color-dark-text); margin: 0; }
  .tst__support .tst__name { color: var(--color-dark-text); }
  .tst__support .tst__attr { border-top-color: var(--line-on-dark); }
  .tst__support--card { background: var(--color-ink-2); border: 1px solid var(--line-on-dark); border-radius: var(--radius-lg); padding: clamp(var(--space-lg), 2.6vw, var(--space-2xl)); }
  .tst__support--rule { padding: clamp(var(--space-lg), 2.6vw, var(--space-2xl)); padding-left: var(--space-lg); border-left: 3px solid var(--color-accent); }
</style>
