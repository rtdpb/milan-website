---
/**
 * Testimonials.astro — 3-up dark cards with monogram avatars · v5.0 (gak feedback)
 *
 * Redesigned to match Milan's mockup: a 3-up row of dark cards, each with:
 *   - Circular initials-monogram avatar (top-left, aria-hidden — name in figcaption)
 *   - Yellow quote-mark
 *   - Verbatim quote text
 *   - Name + role beneath a thin divider rule
 * Followed by a prev/dots/next carousel control that drives a scroll-snap track on mobile.
 *
 * Avatar: NO photo assets — render initials derived from name (first letter of
 * each space-separated word, max 2, uppercase). A real <img> drops in later by
 * replacing the .tst__avatar-monogram span with an <img> inside .tst__avatar.
 *
 * Semantics: SectionWrapper variant="ink", labelledBy, figure/blockquote/figcaption/cite
 * preserved. i18n strings unchanged (verbatim quotes, eyebrow, heading).
 *
 * Carousel: scroll-snap track; desktop shows all 3 as static row; mobile: single-card.
 * JS island: prev/next arrows + dot indicators, IntersectionObserver active-dot tracking.
 * Respects prefers-reduced-motion for scroll behaviour and CSS transitions.
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import { Image } from 'astro:assets';
import { getStrings } from '../../i18n/utils';
import yangSooPhoto from '../../assets/photos/testimonials/yang-soo-kloosterhof.jpg';
import ruudPhoto from '../../assets/photos/testimonials/ruud-koornstra.jpg';
import type { ImageMetadata } from 'astro';

const locale = Astro.currentLocale ?? 'nl';
const isEn = locale === 'en';
const t = getStrings(locale);
const { eyebrow, heading, items } = t.testimonials;
type TestimonialItem = { quote: string; name: string; role: string };
const allItems = items as unknown as TestimonialItem[];

/** Map of real photos keyed by exact testimonial name string */
const photoMap: Record<string, ImageMetadata> = {
  'Yang Soo Kloosterhof': yangSooPhoto,
  'Ruud Koornstra': ruudPhoto,
};

/** Derive initials from a name (first letter of each word, max 2, uppercase). */
function initials(name: string): string {
  const words = name.trim().split(/\s+/);
  return words.slice(0, 2).map(w => w[0]?.toUpperCase() ?? '').join('');
}
---

<SectionWrapper id="getuigenissen" labelledBy="testimonials-heading" variant="ink">
  <div class="tst">
    <header class="tst__head" data-anim>
      <p class="tst__eyebrow">{eyebrow}</p>
      <h2 id="testimonials-heading" class="tst__heading">{heading}</h2>
    </header>

    <!-- Carousel track: scroll-snap on mobile, static 3-up on desktop -->
    <div class="tst__track" id="tst-track" role="list">
      {allItems.map((item, i) => (
        <figure class="tst__card" role="listitem" data-anim data-anim-variant="scale" style={`--i: ${i}`} id={`tst-card-${i}`}>
          <div class="tst__card-top">
            <!-- Avatar: real photo when available, initials monogram as fallback -->
            <span class="tst__avatar" aria-hidden="true">
              {photoMap[item.name] ? (
                <Image
                  src={photoMap[item.name]}
                  width={88}
                  height={88}
                  alt=""
                  class="tst__avatar-img"
                />
              ) : (
                <span class="tst__avatar-monogram">{initials(item.name)}</span>
              )}
            </span>
            <span class="tst__mark" aria-hidden="true">&ldquo;</span>
          </div>

          <blockquote class="tst__quote">
            <p>{item.quote}</p>
          </blockquote>

          <figcaption class="tst__attr">
            <cite class="tst__name">{item.name}</cite>
            {item.role && <span class="tst__role">{item.role}</span>}
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Prev / dots / next carousel control -->
    <div class="tst__nav" role="group" aria-label={isEn ? 'Testimonial navigation' : 'Testimonial navigatie'}>
      <button class="tst__arrow tst__arrow--prev" id="tst-prev" aria-label={isEn ? 'Previous' : 'Vorige'} type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <div class="tst__dots" role="list">
        {allItems.map((item, i) => (
          <button
            class={`tst__dot${i === 0 ? ' tst__dot--active' : ''}`}
            id={`tst-dot-${i}`}
            role="listitem"
            type="button"
            aria-label={`${isEn ? 'Slide' : 'Dia'} ${i + 1}: ${item.name}`}
            aria-current={i === 0 ? 'true' : 'false'}
          ></button>
        ))}
      </div>

      <button class="tst__arrow tst__arrow--next" id="tst-next" aria-label={isEn ? 'Next' : 'Volgende'} type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
      </button>
    </div>
  </div>
</SectionWrapper>

<script>
  (function () {
    'use strict';

    var track = document.getElementById('tst-track');
    var prevBtn = document.getElementById('tst-prev');
    var nextBtn = document.getElementById('tst-next');
    if (!track || !prevBtn || !nextBtn) return;

    var cards = Array.from(track.querySelectorAll('.tst__card'));
    var dots = Array.from(document.querySelectorAll('.tst__dot'));
    var count = cards.length;
    var current = 0;
    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function scrollBehavior(): ScrollBehavior {
      return prefersReduced ? 'auto' : 'smooth';
    }

    function goTo(index: number) {
      var target = cards[index] as HTMLElement;
      if (!target) return;
      current = index;
      target.scrollIntoView({ behavior: scrollBehavior(), block: 'nearest', inline: 'start' });
      updateDots(index);
    }

    function updateDots(activeIndex: number) {
      dots.forEach(function (dot, i) {
        dot.classList.toggle('tst__dot--active', i === activeIndex);
        dot.setAttribute('aria-current', i === activeIndex ? 'true' : 'false');
      });
    }

    prevBtn.addEventListener('click', function () {
      goTo((current - 1 + count) % count);
    });

    nextBtn.addEventListener('click', function () {
      goTo((current + 1) % count);
    });

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () { goTo(i); });
    });

    // IntersectionObserver: update active dot as the track scrolls
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            var idx = cards.indexOf(entry.target as HTMLElement);
            if (idx >= 0) {
              current = idx;
              updateDots(idx);
            }
          }
        });
      }, { root: track, threshold: 0.5 });

      cards.forEach(function (card) { observer.observe(card); });
    }
  })();
</script>

<style>
  .tst { display: flex; flex-direction: column; gap: clamp(var(--space-xl), 4vw, var(--space-3xl)); }
  .tst__head { display: flex; flex-direction: column; gap: var(--space-md); max-width: 40ch; }
  .tst__eyebrow { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin: 0; }
  .tst__heading { font-size: var(--text-3xl); margin: 0; color: var(--color-dark-text); }

  /* ── Scroll-snap track — mobile: single card; desktop: 3-up row ── */
  .tst__track {
    display: flex;
    gap: var(--space-lg);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    /* Negative margin trick to allow full-bleed scroll within constrained content width */
  }
  .tst__track::-webkit-scrollbar { display: none; }

  @media (min-width: 768px) {
    .tst__track {
      overflow-x: visible;
      scroll-snap-type: none;
    }
  }

  /* ── Dark card ── */
  .tst__card {
    flex: 0 0 min(calc(100% - var(--space-lg)), 340px);
    scroll-snap-align: start;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    background: var(--color-ink-2);
    border: 1px solid var(--line-on-dark);
    border-radius: var(--radius-card);
    padding: clamp(var(--space-lg), 2.4vw, var(--space-2xl));
    color: var(--color-dark-text);
  }
  @media (min-width: 768px) {
    .tst__card {
      flex: 1 1 0;
      scroll-snap-align: none;
    }
  }

  /* ── Avatar + quote-mark row ── */
  .tst__card-top { display: flex; align-items: flex-start; justify-content: space-between; }

  /* Avatar circle: monogram or photo */
  .tst__avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--color-ink); border: 1px solid var(--line-on-dark-strong);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    overflow: hidden; /* clips photo to circle */
  }
  .tst__avatar-monogram {
    font-size: var(--text-sm); font-weight: 700; letter-spacing: 0.04em;
    color: var(--color-dark-text-soft); text-transform: uppercase; user-select: none;
  }
  .tst__avatar-img {
    width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block;
  }

  /* Yellow quote-mark */
  .tst__mark {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 0.7;
    color: var(--color-accent);
    user-select: none;
  }

  /* ── Quote text ── */
  .tst__quote { margin: 0; flex: 1; }
  .tst__quote p { font-size: var(--text-base); line-height: 1.55; color: var(--color-dark-text); margin: 0; }

  /* ── Attribution beneath a thin divider ── */
  .tst__attr {
    display: flex; flex-direction: column; gap: 2px;
    padding-top: var(--space-md);
    border-top: 1px solid var(--line-on-dark);
    margin-top: auto;
  }
  .tst__name { font-style: normal; font-size: var(--text-sm); font-weight: 600; color: var(--color-dark-text); }
  .tst__role { font-size: var(--text-xs); color: var(--color-dark-text-soft); }

  /* ── Carousel control: prev / dots / next ── */
  .tst__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
  }

  .tst__arrow {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--color-ink-2); border: 1px solid var(--line-on-dark-strong);
    color: var(--color-dark-text-soft); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }
  .tst__arrow:hover { background: var(--color-ink); color: var(--color-dark-text); }
  .tst__arrow:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  .tst__dots { display: flex; align-items: center; gap: var(--space-sm); }
  .tst__dot {
    width: 8px; height: 8px; border-radius: 50%; padding: 0; border: none; cursor: pointer;
    background: var(--color-dark-text-soft); opacity: 0.5;
    transition: background-color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .tst__dot--active { background: var(--color-accent); opacity: 1; transform: scale(1.25); }
  .tst__dot:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .tst__arrow, .tst__dot { transition: none; }
  }
</style>
