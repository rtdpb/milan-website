---
/**
 * Timeline.astro — Milan's journey as visual credibility · v4.0
 *
 * A navy "documentary" band. Header: heading + a documentary photo and a small
 * custom "9 markets" dot-map SVG. Body: a robust left-rail vertical timeline —
 * decorative dots/line are the only absolutely-positioned elements; all text is
 * in normal flow. Numeric milestones count up; milestones reveal on scroll.
 */
import { Picture } from 'astro:assets';
import SectionWrapper from '../ui/SectionWrapper.astro';
import GrowthCurve from '../ui/GrowthCurve.astro';
import { getStrings } from '../../i18n/utils';
import journeyImg from '../../assets/photos/milan-energy-mission.jpg';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const tl = t.timeline;
---

<SectionWrapper id="tijdlijn" variant="navy" labelledBy="timeline-heading">
  <div class="tl">

    <header class="tl__head">
      <div class="tl__head-text" data-anim>
        <p class="tl__eyebrow">{tl.eyebrow}</p>
        <h2 id="timeline-heading" class="tl__heading">{tl.heading}</h2>
        <p class="tl__intro">{tl.intro}</p>

        <!--
          Headline stats row — three key Soly numbers (260821-m2d).
          9 markten / ~180 medewerkers / ~1M zonnepanelen
          Count-up uses the existing [data-countup] + new data-countup-prefix seam.
          Reduced-motion / no-JS: authored text is already the final value.
        -->
        <div class="tl__stats-row" aria-label={tl.eyebrow}>
          <div class="tl__headline-stat">
            <span class="tl__stat-num" data-countup="9">9</span>
            <span class="tl__stat-label">{tl.items[1]?.statLabel ?? 'markten'}</span>
          </div>
          <div class="tl__headline-stat">
            <span class="tl__stat-num" data-countup="180" data-countup-prefix="~">~180</span>
            <span class="tl__stat-label">{tl.items[2]?.statLabel ?? 'medewerkers'}</span>
          </div>
          <div class="tl__headline-stat">
            <span class="tl__stat-num" data-countup="1" data-countup-prefix="~" data-suffix="M">~1M</span>
            <span class="tl__stat-label">{tl.solarPanelsLabel}</span>
          </div>
        </div>

        <!--
          Growth curve SVG — draws itself on scroll via stroke-dashoffset.
          Trigger: parent [data-anim] wrapper; the existing IntersectionObserver
          adds .is-in which triggers the CSS transition in global.css.
          No new observer. Reduced-motion: shown fully drawn (global.css rule).
          (260821-m2d)
        -->
        <div data-anim class="tl__curve-wrap">
          <GrowthCurve ariaLabel={tl.growthCurveAriaLabel} />
        </div>
      </div>

      <figure class="tl__photo">
        <Picture
          src={journeyImg}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000]}
          sizes="(max-width: 900px) 92vw, 40vw"
          alt={isEn ? 'Milan on the main stage at a conference.' : 'Milan op het grote podium tijdens een conferentie.'}
          loading="lazy"
          class="tl__photo-img"
        />
      </figure>
    </header>

    <ol class="tl__list">
      {tl.items.map((item, i) => (
        <li class="tl__item" data-anim style={`--i: ${i}`}>
          <span class="tl__dot" aria-hidden="true"></span>
          <p class="tl__kicker">{item.kicker}</p>
          {item.stat && (
            <p class="tl__stat">
              <span class="tl__stat-num" data-countup={item.stat}>{item.stat}</span>
              <span class="tl__stat-label">{item.statLabel}</span>
            </p>
          )}
          <h3 class="tl__title">{item.title}</h3>
          <p class="tl__text">{item.text}</p>
        </li>
      ))}
    </ol>

  </div>
</SectionWrapper>

<style>
  .tl { display: flex; flex-direction: column; gap: clamp(var(--space-2xl), 5vw, var(--space-4xl)); }

  /* ── Header ───────────────────────────────────────────────────────────── */
  .tl__head { display: grid; grid-template-columns: 1fr; gap: clamp(var(--space-xl), 4vw, var(--space-3xl)); align-items: center; }
  @media (min-width: 900px) { .tl__head { grid-template-columns: 1.15fr 0.85fr; } }
  .tl__head-text { display: flex; flex-direction: column; gap: var(--space-md); }
  .tl__eyebrow { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin: 0; }
  .tl__heading { font-size: var(--text-3xl); color: var(--color-dark-text); margin: 0; max-width: 20ch; }
  .tl__intro { font-size: var(--text-lg); line-height: 1.55; color: var(--color-dark-text-soft); margin: 0; max-width: 46ch; }

  /* ── Headline stats row (260821-m2d) ─────────────────────────────────── */
  .tl__stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg) var(--space-xl);
    margin: var(--space-md) 0 0;
  }
  .tl__headline-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tl__headline-stat .tl__stat-num {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem);
    font-weight: 720;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-accent);
  }
  .tl__headline-stat .tl__stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dark-text-soft);
  }

  /* ── Growth curve wrapper ──────────────────────────────────────────── */
  .tl__curve-wrap { margin-top: var(--space-sm); }

  .tl__photo { margin: 0; border-radius: var(--radius-card); overflow: hidden; background: var(--color-navy-2); aspect-ratio: 4 / 3; }
  .tl__photo-img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; display: block; }

  /* ── Vertical timeline (single continuous left rail) ──────────────────── */
  .tl__list { list-style: none; margin: 0; padding: 0; max-width: 760px; }
  .tl__item {
    position: relative;
    padding-left: clamp(var(--space-xl), 4vw, var(--space-2xl));
    padding-bottom: clamp(var(--space-xl), 4vw, var(--space-3xl));
  }
  /* Rail line — decorative, drawn per item so it's continuous. */
  .tl__item::before {
    content: '';
    position: absolute;
    left: 7px; top: 6px; bottom: 0;
    width: 2px;
    background: var(--line-on-dark);
  }
  .tl__item:last-child { padding-bottom: 0; }
  .tl__item:last-child::before { display: none; }
  .tl__dot {
    position: absolute; left: 0; top: 4px;
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-navy);
  }
  .tl__kicker { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-dark-text-soft); margin: 0 0 var(--space-sm); }
  .tl__stat { display: flex; align-items: baseline; gap: var(--space-sm); margin: 0 0 var(--space-xs); }
  .tl__stat-num { font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem); font-weight: 720; letter-spacing: -0.03em; line-height: 1; color: var(--color-accent); }
  .tl__stat-label { font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-dark-text-soft); }
  .tl__title { font-size: var(--text-xl); line-height: 1.1; color: var(--color-dark-text); margin: 0 0 var(--space-sm); max-width: 24ch; }
  .tl__text { font-size: var(--text-base); line-height: 1.6; color: var(--color-dark-text-soft); margin: 0; max-width: 52ch; }
</style>
