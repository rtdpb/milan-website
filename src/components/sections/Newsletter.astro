---
/**
 * Newsletter.astro
 * Newsletter signup section — Sectie 5 (HOME-07).
 *
 * Source: PLAN 01-05 Task 1, UI-SPEC §NewsletterSection, CONTEXT D-09, D-12,
 *         HOME-07, HOME-10, FND-04, FND-06
 *         Phase 3 PLAN 03-02 Task 2: rewired to email-only Substack redirect (D-05, NEWS-02)
 *
 * Design decisions:
 * - D-05: naam field removed — the redirect cannot honestly carry a name into Substack.
 *   Only the email field remains. Single-field layout, max-width 480px centered.
 * - D-09 / NEWS-02: IS_SENTINEL drives disabled span vs live redirect anchor.
 *   Sentinel state: aria-disabled span (unchanged appearance from Phase 1).
 *   Live state: <a href={subscribeUrl} target="_blank" rel="noopener noreferrer">.
 * - D-12: No href="#" anywhere — disabled state uses aria-disabled + tabindex="-1".
 * - FND-06: Explicit <label> for email field, 16px font-size prevents iOS zoom, focus ring.
 * - SECTION is LIGHT (--color-bg), not dark — cream background section.
 *
 * Security note (T-01-04): redirect anchor carries rel="noopener noreferrer" (tab-napping).
 * No on-site success state — success is on Substack's hosted subscribe page.
 * No ?email= prefill — unconfirmed by Substack (RESEARCH A1/Pitfall 6); plain redirect only.
 */

import SectionWrapper from '../ui/SectionWrapper.astro';
import { getStrings } from '../../i18n/utils';
import { TODO_SUBSTACK_URL } from '../../config';

// Phase 4: locale-parameterized strings (I18N-02, D-02)
const t = getStrings(Astro.currentLocale);
const IS_SENTINEL = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
// CR-02: strip trailing slash before appending /subscribe — guards against double-slash URL
// if the supplied Substack URL ends with '/'. Defensive normalisation at every usage site.
const subscribeUrl = `${TODO_SUBSTACK_URL.replace(/\/$/, '')}/subscribe`;

const { heading, subtext, cta, disclaimer } = t.newsletter;
---

<SectionWrapper id="nieuwsbrief" labelledBy="newsletter-heading" variant="default">
  <div class="newsletter">

    <!-- ── Header block ──────────────────────────────────────────────────── -->
    <div class="newsletter__header">
      <h2 id="newsletter-heading" class="newsletter__heading">
        {heading}
      </h2>
      <p class="newsletter__subtext">
        {subtext}
      </p>
    </div>

    <!-- ── CTA: conditional sentinel vs live redirect ──────────────────────── -->
    <!--
      WR-06: the email field collected a value that was silently discarded (onsubmit="return false;"
      and the redirect anchor ignored the entered email — a false affordance). Fix: remove the
      email input entirely and replace the form with a direct CTA block. The redirect is honest —
      no field implies no email is being captured here; subscription happens on Substack's page.

      REDIRECT STATE (D-05, NEWS-02):
      IS_SENTINEL = true  → disabled aria-disabled span (no URL yet)
      IS_SENTINEL = false → <a href={subscribeUrl} target="_blank" rel="noopener noreferrer">
      No on-site success state. No ?email= prefill. No JS submit handler.
      Security note (T-01-04): rel="noopener noreferrer" on any target=_blank redirect.
    -->
    <div class="newsletter__cta-block">
      <!-- Submit: conditional sentinel vs live redirect (D-05, NEWS-02, WR-06)
           Sentinel state: aria-disabled span — no URL yet, honestly non-functional.
           Live state:     <a> redirect to Substack — new tab, rel="noopener noreferrer" (T-01-04).
           Security note (T-01-04): rel="noopener noreferrer" required on target="_blank" (tab-napping).
      -->
      {IS_SENTINEL ? (
        <span
          class="newsletter__submit newsletter__submit--disabled"
          role="button"
          aria-disabled="true"
          tabindex="-1"
          title={(Astro.currentLocale ?? 'nl') === 'en'
            ? 'Link follows once the Substack URL is known'
            : 'Link volgt zodra Substack-URL bekend is'}
          aria-describedby="newsletter-submit-note"
        >
          {cta}
        </span>
      ) : (
        <a
          href={subscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="newsletter__submit"
          aria-describedby="newsletter-submit-note"
        >
          {cta}
        </a>
      )}

      <!-- Screen-reader note: conditional on sentinel state.
           Sentinel state: "coming soon" with aria-live (correct — no action possible yet).
           Live state: redirect info without aria-live (link is functional, no announcement needed). -->
      {IS_SENTINEL ? (
        <p id="newsletter-submit-note" class="newsletter__submit-note" aria-live="polite">
          {(Astro.currentLocale ?? 'nl') === 'en'
            ? 'Signup will be available via Substack shortly.'
            : 'Aanmelden is binnenkort beschikbaar via Substack.'}
        </p>
      ) : (
        <p id="newsletter-submit-note" class="newsletter__submit-note">
          {(Astro.currentLocale ?? 'nl') === 'en'
            ? 'You will be redirected to Substack to subscribe.'
            : 'Je wordt doorgestuurd naar Substack om je in te schrijven.'}
        </p>
      )}
    </div>

    <!-- Disclaimer -->
    <p class="newsletter__disclaimer">
      {disclaimer}
    </p>

  </div>
</SectionWrapper>

<!-- Plausible goal: Newsletter: Subscribe — fires on click of the live Substack redirect anchor.
     Only wires the listener when the anchor is live (not the disabled span).
     The :not(.newsletter__submit--disabled) selector guards against firing on the sentinel state.
     Source: 05-RESEARCH.md §Pattern 3, 05-PATTERNS.md §Shared Patterns → Plausible event firing.
     GROW-01 / D-05. -->
<script>
  (function () {
    'use strict';
    // Target the live redirect anchor only — exclude the disabled sentinel span
    var subscribeAnchor = document.querySelector('.newsletter__submit:not(.newsletter__submit--disabled)');
    if (!subscribeAnchor) return; // IS_SENTINEL = true → disabled span rendered → no-op
    subscribeAnchor.addEventListener('click', function () {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if (typeof (window as any).plausible === 'function') {
        (window as any).plausible('Newsletter: Subscribe');
      }
    });
  })();
</script>

<style>
  /* ── Section layout ────────────────────────────────────────────────────────── */
  .newsletter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
    text-align: center;
    max-width: 680px;   /* reading measure — same as body text (UI-SPEC §Typography) */
    margin-inline: auto;
  }

  /* ── Header ───────────────────────────────────────────────────────────────── */
  .newsletter__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
  }

  .newsletter__heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);   /* 24–36px — section heading size (UI-SPEC) */
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .newsletter__heading {
      font-size: var(--text-3xl); /* Larger on desktop */
    }
  }

  .newsletter__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);  /* 16–18px body */
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 560px;
  }

  /* ── CTA block: replaces the form+email-field layout (WR-06) ────────────── */
  /* Centered flex column matching the old form layout. */
  .newsletter__cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    width: 100%;
  }

  /* ── Submit — shared base styles ─────────────────────────────────────────── */
  /* Applies to both <span> (sentinel disabled) and <a> (live redirect anchor). */
  .newsletter__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding-inline: var(--space-lg);  /* 24px — Button spec */
    border-radius: var(--radius-md);  /* 8px */
    font-family: var(--font-body);
    font-size: 0.9375rem;             /* 15px — CTA/Button */
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    border: none;
    background-color: var(--color-accent);  /* #FFDD11 */
    color: var(--color-text);               /* #1A1A18 */
    min-height: 44px;                       /* WCAG 2.5.5 touch target */
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform        var(--duration-fast) var(--ease-out);
  }

  /* ── Disabled / Sentinel state ───────────────────────────────────────────── */
  .newsletter__submit--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;  /* belt + suspenders */
  }

  /* ── Enabled anchor hover/focus (UI-SPEC §Surface 1, 03-PATTERNS lines 288-297) ── */
  /* Security note (T-01-04): this class only applies to the live <a> redirect. */
  .newsletter__submit:not(.newsletter__submit--disabled):hover {
    background-color: var(--color-accent-dark); /* #C9AC00 */
    transform: scale(1.02);
  }

  /* Focus ring on submit (a11y) */
  .newsletter__submit:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Submit note (screen reader) ─────────────────────────────────────────── */
  .newsletter__submit-note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
    font-style: italic;
  }

  /* ── Disclaimer ──────────────────────────────────────────────────────────── */
  .newsletter__disclaimer {
    font-family: var(--font-body);
    font-size: var(--text-xs);   /* 12–14px meta/caption */
    font-weight: 400;
    color: var(--color-text-secondary);
    margin: 0;
    font-style: italic;
  }
</style>
