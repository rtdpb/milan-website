---
/**
 * Newsletter.astro — Bold yellow statement section · v4.0
 *
 * A high-energy yellow signature band: large statement headline, supporting copy,
 * and one prominent ink CTA. HONEST (D-05/NEWS-02/WR-06): no name/email inputs that
 * would silently discard input — subscription happens on Substack. The affordance is
 * a single CTA (disabled sentinel span vs live redirect). No fake success state.
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import { getStrings } from '../../i18n/utils';
import { TODO_SUBSTACK_URL } from '../../config';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const IS_SENTINEL = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
const subscribeUrl = `${TODO_SUBSTACK_URL.replace(/\/$/, '')}/subscribe`;
const { statement, subtext, cta, disclaimer } = t.newsletter;
---

<SectionWrapper id="nieuwsbrief" labelledBy="newsletter-heading" variant="surface">
  <div class="nl">
    <div class="nl__text" data-anim>
      <p class="nl__eyebrow">{t.nav.nieuwsbrief}</p>
      <h2 id="newsletter-heading" class="nl__statement">{statement}</h2>
      <p class="nl__subtext">{subtext}</p>
    </div>

    <div class="nl__action" data-anim style="--i: 1">
      {IS_SENTINEL ? (
        <span
          class="nl__cta nl__cta--disabled"
          role="button" aria-disabled="true" tabindex="-1"
          title={isEn ? 'Link follows once the Substack URL is known' : 'Link volgt zodra Substack-URL bekend is'}
          aria-describedby="newsletter-submit-note"
        >{cta}</span>
      ) : (
        <a href={subscribeUrl} target="_blank" rel="noopener noreferrer" class="nl__cta" aria-describedby="newsletter-submit-note">
          {cta}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      )}

      {IS_SENTINEL ? (
        <p id="newsletter-submit-note" class="nl__note" aria-live="polite">
          {isEn ? 'Signup will be available via Substack shortly.' : 'Aanmelden is binnenkort beschikbaar via Substack.'}
        </p>
      ) : (
        <p id="newsletter-submit-note" class="nl__note">
          {isEn ? 'You will be redirected to Substack to subscribe.' : 'Je wordt doorgestuurd naar Substack om je in te schrijven.'}
        </p>
      )}
      <p class="nl__disclaimer">{disclaimer}</p>
    </div>
  </div>
</SectionWrapper>

<script>
  (function () {
    'use strict';
    var a = document.querySelector('.nl__cta:not(.nl__cta--disabled)');
    if (!a) return;
    a.addEventListener('click', function () {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if (typeof (window as any).plausible === 'function') (window as any).plausible('Newsletter: Subscribe');
    });
  })();
</script>

<style>
  .nl { display: grid; grid-template-columns: 1fr; gap: clamp(var(--space-xl), 4vw, var(--space-3xl)); align-items: end; }
  @media (min-width: 900px) { .nl { grid-template-columns: 1.4fr 0.6fr; } }

  .nl__text { display: flex; flex-direction: column; gap: var(--space-md); }
  .nl__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  /* Yellow used only as a small underline detail on the statement. */
  .nl__statement {
    font-size: var(--text-3xl); line-height: 1.04; letter-spacing: -0.02em; color: var(--color-text); margin: 0; max-width: 20ch;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat; background-position: 0 100%; background-size: 100% 0;
    padding-bottom: 2px;
  }
  .nl__subtext { font-size: var(--text-lg); line-height: 1.5; color: var(--color-text-secondary); margin: 0; max-width: 48ch; }

  .nl__action { display: flex; flex-direction: column; gap: var(--space-md); align-items: flex-start; }
  .nl__cta {
    display: inline-flex; align-items: center; gap: var(--space-sm);
    height: 58px; padding-inline: var(--space-xl);
    background: var(--color-accent); color: var(--color-accent-ink);
    border: none; border-radius: var(--radius-pill);
    font-size: var(--text-base); font-weight: 600; text-decoration: none; cursor: pointer; white-space: nowrap;
    transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }
  .nl__cta:not(.nl__cta--disabled):hover { transform: translateY(-2px); background: var(--color-accent-dark); }
  .nl__cta svg { transition: transform var(--duration-fast) var(--ease-out); }
  .nl__cta:not(.nl__cta--disabled):hover svg { transform: translateX(3px); }
  .nl__cta:focus-visible { outline: 2px solid var(--color-accent-ink); outline-offset: 3px; }
  .nl__cta--disabled { opacity: 0.45; cursor: not-allowed; pointer-events: none; }

  .nl__note { font-size: var(--text-xs); color: var(--color-text-secondary); margin: 0; }
  .nl__disclaimer { font-size: var(--text-xs); color: var(--color-text-secondary); opacity: 0.8; margin: 0; }

  @media (prefers-reduced-motion: reduce) { .nl__cta, .nl__cta svg { transition: none; } }
</style>
