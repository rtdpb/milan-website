---
/**
 * Newsletter.astro
 * Newsletter signup section — Sectie 5 (HOME-07).
 *
 * Source: PLAN 01-05 Task 1, UI-SPEC §NewsletterSection, CONTEXT D-09, D-12,
 *         HOME-07, HOME-10, FND-04, FND-06
 *         Phase 3 PLAN 03-02 Task 2: rewired to email-only Substack redirect (D-05, NEWS-02)
 *
 * Design decisions:
 * - D-05: naam field removed — the redirect cannot honestly carry a name into Substack.
 *   Only the email field remains. Single-field layout, max-width 480px centered.
 * - D-09 / NEWS-02: IS_SENTINEL drives disabled span vs live redirect anchor.
 *   Sentinel state: aria-disabled span (unchanged appearance from Phase 1).
 *   Live state: <a href={subscribeUrl} target="_blank" rel="noopener noreferrer">.
 * - D-12: No href="#" anywhere — disabled state uses aria-disabled + tabindex="-1".
 * - FND-06: Explicit <label> for email field, 16px font-size prevents iOS zoom, focus ring.
 * - SECTION is LIGHT (--color-bg), not dark — cream background section.
 *
 * Security note (T-01-04): redirect anchor carries rel="noopener noreferrer" (tab-napping).
 * No on-site success state — success is on Substack's hosted subscribe page.
 * No ?email= prefill — unconfirmed by Substack (RESEARCH A1/Pitfall 6); plain redirect only.
 */

import SectionWrapper from '../ui/SectionWrapper.astro';
import { nl } from '../../i18n/nl';
import { TODO_SUBSTACK_URL } from '../../config';

const IS_SENTINEL = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
const subscribeUrl = `${TODO_SUBSTACK_URL}/subscribe`;

const { heading, subtext, labelEmail, cta, disclaimer } = nl.newsletter;
---

<SectionWrapper id="nieuwsbrief" labelledBy="newsletter-heading" variant="default">
  <div class="newsletter">

    <!-- ── Header block ──────────────────────────────────────────────────── -->
    <div class="newsletter__header">
      <h2 id="newsletter-heading" class="newsletter__heading">
        {heading}
      </h2>
      <p class="newsletter__subtext">
        {subtext}
      </p>
    </div>

    <!-- ── Signup form ───────────────────────────────────────────────────── -->
    <!--
      REDIRECT STATE (D-05, NEWS-02):
      IS_SENTINEL = true  → disabled aria-disabled span (no URL yet)
      IS_SENTINEL = false → <a href={subscribeUrl} target="_blank" rel="noopener noreferrer">
      No on-site success state. No ?email= prefill. No JS submit handler.
      onsubmit="return false;" stays — form is never submitted on-site.
      Security note (T-01-04): rel="noopener noreferrer" on any target=_blank redirect.
    -->
    <form
      class="newsletter__form"
      aria-label="Nieuwsbrief aanmelden — versturen opent Substack in een nieuw tabblad"
      novalidate
      onsubmit="return false;"
    >
      <!-- Single email field, centered (D-05: naam removed, single-field layout) -->
      <div class="newsletter__fields newsletter__fields--single">

        <!-- Mailadres field — explicit label (FND-06, a11y) -->
        <div class="newsletter__field-group">
          <label for="nl-email" class="newsletter__label">
            {labelEmail}
          </label>
          <input
            id="nl-email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="jouw@email.nl"
            required
            class="newsletter__input"
          />
        </div>

      </div>
      <!-- End field row -->

      <!-- Submit: conditional sentinel vs live redirect (D-05, NEWS-02)
           Sentinel state: aria-disabled span — same visual as Phase 1, honestly non-functional.
           Live state:     <a> redirect to Substack — new tab, rel="noopener noreferrer" (T-01-04).
           No ?email= prefill (RESEARCH A1/Pitfall 6 unconfirmed — plain redirect is the honest default).
           Security note (T-01-04): rel="noopener noreferrer" required on target="_blank" (tab-napping).
      -->
      {IS_SENTINEL ? (
        <span
          class="newsletter__submit newsletter__submit--disabled"
          role="button"
          aria-disabled="true"
          tabindex="-1"
          data-placeholder={TODO_SUBSTACK_URL}
          title="Link volgt zodra Substack-URL bekend is"
          aria-describedby="newsletter-submit-note"
        >
          {cta}
        </span>
      ) : (
        <a
          href={subscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="newsletter__submit"
          aria-describedby="newsletter-submit-note"
        >
          {cta}
        </a>
      )}

      <!-- Screen-reader note: conditional on sentinel state (CR-03).
           Sentinel state: "coming soon" with aria-live (correct — no action possible yet).
           Live state: redirect info without aria-live (link is functional, no announcement needed). -->
      {IS_SENTINEL ? (
        <p id="newsletter-submit-note" class="newsletter__submit-note" aria-live="polite">
          Aanmelden is binnenkort beschikbaar via Substack.
        </p>
      ) : (
        <p id="newsletter-submit-note" class="newsletter__submit-note">
          Je wordt doorgestuurd naar Substack om je in te schrijven.
        </p>
      )}

    </form>

    <!-- Disclaimer -->
    <p class="newsletter__disclaimer">
      {disclaimer}
    </p>

  </div>
</SectionWrapper>

<style>
  /* ── Section layout ────────────────────────────────────────────────────────── */
  .newsletter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
    text-align: center;
    max-width: 680px;   /* reading measure — same as body text (UI-SPEC §Typography) */
    margin-inline: auto;
  }

  /* ── Header ───────────────────────────────────────────────────────────────── */
  .newsletter__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
  }

  .newsletter__heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);   /* 24–36px — section heading size (UI-SPEC) */
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .newsletter__heading {
      font-size: var(--text-3xl); /* Larger on desktop */
    }
  }

  .newsletter__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);  /* 16–18px body */
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 560px;
  }

  /* ── Form container ───────────────────────────────────────────────────────── */
  .newsletter__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    width: 100%;
  }

  /* ── Fields row: single field, centered (D-05: naam removed) ─────────────── */
  .newsletter__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
  }

  /* Single-field layout: constrained width + centered (UI-SPEC §Surface 1) */
  .newsletter__fields--single {
    max-width: 480px;
    margin-inline: auto;
  }

  /* ── Individual field group (label + input) ──────────────────────────────── */
  .newsletter__field-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
    text-align: left;
  }

  /* ── Label ────────────────────────────────────────────────────────────────── */
  .newsletter__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);   /* 14–16px label size */
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  /* ── Input fields (UI-SPEC §NewsletterSection, FND-06) ───────────────────── */
  .newsletter__input {
    /* UI-SPEC: border 1px --color-border, border-radius 8px, height 48px,
       --space-md horizontal padding, font-size 16px (iOS zoom prevention) */
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);  /* 8px */
    height: 48px;
    padding-inline: var(--space-md);  /* 16px */
    font-family: var(--font-body);
    font-size: 1rem;                  /* 16px FIXED — prevents iOS zoom (FND-06) */
    font-weight: 400;
    color: var(--color-text);
    background-color: var(--color-bg);
    width: 100%;
    box-sizing: border-box;
    outline: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow   var(--duration-fast) var(--ease-out);
  }

  .newsletter__input::placeholder {
    color: var(--color-text-secondary);
  }

  /* Focus ring: 2px --color-accent with 2px offset (UI-SPEC §Form Input Focus States, FND-06) */
  .newsletter__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  /* ── Submit — shared base styles ─────────────────────────────────────────── */
  /* Applies to both <span> (sentinel disabled) and <a> (live redirect anchor). */
  .newsletter__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding-inline: var(--space-lg);  /* 24px — Button spec */
    border-radius: var(--radius-md);  /* 8px */
    font-family: var(--font-body);
    font-size: 0.9375rem;             /* 15px — CTA/Button */
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    border: none;
    background-color: var(--color-accent);  /* #FFDD11 */
    color: var(--color-text);               /* #1A1A18 */
    min-height: 44px;                       /* WCAG 2.5.5 touch target */
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform        var(--duration-fast) var(--ease-out);
  }

  /* ── Disabled / Sentinel state ───────────────────────────────────────────── */
  .newsletter__submit--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;  /* belt + suspenders */
  }

  /* ── Enabled anchor hover/focus (UI-SPEC §Surface 1, 03-PATTERNS lines 288-297) ── */
  /* Security note (T-01-04): this class only applies to the live <a> redirect. */
  .newsletter__submit:not(.newsletter__submit--disabled):hover {
    background-color: var(--color-accent-dark); /* #C9AC00 */
    transform: scale(1.02);
  }

  /* Focus ring on submit (a11y) */
  .newsletter__submit:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Submit note (screen reader) ─────────────────────────────────────────── */
  .newsletter__submit-note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
    font-style: italic;
  }

  /* ── Disclaimer ──────────────────────────────────────────────────────────── */
  .newsletter__disclaimer {
    font-family: var(--font-body);
    font-size: var(--text-xs);   /* 12–14px meta/caption */
    font-weight: 400;
    color: var(--color-text-secondary);
    margin: 0;
    font-style: italic;
  }
</style>
