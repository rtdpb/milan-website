---
/**
 * PressStrip.astro — "Benoemd in" credibility strip
 *
 * Layout: the label sits on the LEFT, vertically centred, and the outlet logos
 * run to the RIGHT of it in a subtle continuous marquee (feedback). Each outlet
 * renders as a monochrome SVG wordmark logo (pressLogos.ts) in the strip's quiet
 * grey — swap any entry for the outlet's official SVG when assets arrive. Falls
 * back to the plain outlet name if no logo is defined. Motion pauses on hover and
 * is disabled under prefers-reduced-motion.
 */
import { getStrings } from '../../i18n/utils';
import { pressLogos } from './pressLogos';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const logos = t.pressStrip.logos;
---

<section class="press" aria-label={isEn ? 'Media coverage' : 'Media-uitingen'}>
  <div class="press__inner">
    <p class="press__label">{t.pressStrip.eyebrow}</p>
    <div class="press__marquee" role="list" aria-label={isEn ? 'Media coverage of Milan van der Meulen' : 'Media-uitingen van Milan van der Meulen'}>
      <div class="press__track">
        {logos.map((o) => (
          <span class="press__name" role="listitem">
            {pressLogos[o]
              ? (<><Fragment set:html={pressLogos[o]} /><span class="sr-only">{o}</span></>)
              : o}
          </span>
        ))}
        {logos.map((o) => (
          <span class="press__name" aria-hidden="true">
            {pressLogos[o] ? <Fragment set:html={pressLogos[o]} /> : o}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .press {
    background-color: var(--color-bg);
    border-top: 1px solid var(--line-on-light);
    border-bottom: 1px solid var(--line-on-light);
    padding-block: clamp(var(--space-lg), 2.5vw, var(--space-xl));
    overflow: clip;
  }
  /* Row: label left (vertically centred) · names running to the right. */
  .press__inner {
    max-width: var(--max-width); width: 100%; margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex; align-items: center;
    gap: clamp(var(--space-md), 3vw, var(--space-2xl));
  }
  .press__label {
    flex-shrink: 0; margin: 0; white-space: nowrap;
    font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-text-tertiary);
  }
  .press__marquee {
    position: relative; flex: 1 1 0; min-width: 0; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 88%, transparent);
            mask-image: linear-gradient(90deg, #000 0%, #000 88%, transparent);
  }
  .press__track {
    display: flex; align-items: center; width: max-content;
    gap: clamp(var(--space-2xl), 6vw, var(--space-5xl));
    padding-right: clamp(var(--space-2xl), 6vw, var(--space-5xl));
    animation: pressScroll 38s linear infinite;
  }
  .press__marquee:hover .press__track { animation-play-state: paused; }
  .press__name {
    display: inline-flex; align-items: center;
    color: var(--color-text); opacity: 0.42; white-space: nowrap; line-height: 1;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .press__name:hover { opacity: 0.85; }
  /* Logos scale by height; width follows the SVG's aspect ratio. currentColor
     inherits the grey above, so each logo stays monochrome in the strip. */
  .press__name :global(svg) {
    height: clamp(22px, 1rem + 0.9vw, 30px); width: auto; display: block;
    overflow: visible;
  }
  @keyframes pressScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .press__track { animation: none; flex-wrap: wrap; width: auto; row-gap: var(--space-sm); padding-right: 0; }
    .press__marquee { -webkit-mask-image: none; mask-image: none; }
    .press__name[aria-hidden='true'] { display: none; }
  }
</style>
