---
/**
 * PressStrip.astro — "Bekend van" credibility marquee · v3.0 redesign
 *
 * An understated, premium monochrome wordmark marquee. Names are REAL media
 * that featured Milan (MT Sprout, Quote, NOS, EenVandaag, Telegraaf, De
 * Ondernemer). The track scrolls slowly and continuously; motion pauses on
 * hover and is fully disabled under prefers-reduced-motion.
 *
 * INTERNAL NOTE (not shown to visitors): wordmarks are set in type pending real
 * vector logos — swap each <span> for the outlet SVG when supplied. No public
 * "logo volgt" marker is displayed.
 */
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const logos = t.pressStrip.logos;
---

<section class="press" aria-labelledby="press-eyebrow">
  <div class="press__head">
    <p id="press-eyebrow" class="press__eyebrow">{t.pressStrip.eyebrow}</p>
  </div>

  <div
    class="press__marquee"
    role="list"
    aria-label={isEn ? 'Media coverage of Milan van der Meulen' : 'Media-uitingen van Milan van der Meulen'}
  >
    <div class="press__track">
      {logos.map((outlet) => (
        <span class="press__wordmark" role="listitem">{outlet}</span>
      ))}
      {/* Duplicate set for seamless loop — hidden from assistive tech. */}
      {logos.map((outlet) => (
        <span class="press__wordmark" aria-hidden="true">{outlet}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .press {
    background-color: var(--color-bg);
    border-top: 1px solid var(--line-on-light);
    border-bottom: 1px solid var(--line-on-light);
    padding-block: clamp(var(--space-xl), 4vw, var(--space-3xl));
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    overflow: clip;
  }

  .press__head {
    max-width: var(--max-width);
    margin-inline: auto;
    width: 100%;
    padding-inline: var(--gutter);
  }
  .press__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin: 0;
  }

  /* Edge-faded viewport for the moving track. */
  .press__marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .press__track {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-2xl), 7vw, var(--space-5xl));
    width: max-content;
    padding-inline: clamp(var(--space-2xl), 7vw, var(--space-5xl));
    animation: pressScroll 42s linear infinite;
  }
  .press__marquee:hover .press__track { animation-play-state: paused; }

  .press__wordmark {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    opacity: 0.4;
    white-space: nowrap;
    line-height: 1;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .press__wordmark:hover { opacity: 0.8; }

  @keyframes pressScroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .press__track {
      animation: none;
      /* Static, legible row when motion is off — wrap and centre. */
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-md);
      width: auto;
      max-width: var(--max-width);
      margin-inline: auto;
    }
    .press__marquee {
      -webkit-mask-image: none;
              mask-image: none;
    }
    /* Static mode: drop the duplicated (aria-hidden) set — show each name once. */
    .press__wordmark[aria-hidden='true'] { display: none; }
  }
</style>
