---
/**
 * PressStrip.astro — "Bekend van" credibility band (HOME-03) · v2.0 redesign
 *
 * Clean, credible wordmark strip (replaces the placeholder pills). The outlet
 * names are REAL media that featured Milan (MT Sprout, Quote, NOS, EenVandaag,
 * Telegraaf, De Ondernemer) — rendered as understated wordmarks, not chips.
 *
 * INTERNAL NOTE (not shown to visitors, per v2.0 brief): these are text
 * wordmarks pending real vector logos. Swap each <span> for the outlet's SVG
 * when the assets are supplied. No public "logo volgt" marker is displayed.
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
---

<SectionWrapper id="bekend-van" variant="surface" labelledBy="press-strip-eyebrow" class="press-strip-wrapper">
  <div class="press-strip">
    <p id="press-strip-eyebrow" class="press-strip__eyebrow">{t.pressStrip.eyebrow}</p>

    <ul
      class="press-strip__logos"
      aria-label={isEn ? 'Media coverage of Milan van der Meulen' : 'Media-uitingen van Milan van der Meulen'}
    >
      {t.pressStrip.logos.map((outlet) => (
        <li class="press-strip__item">
          <span class="press-strip__wordmark">{outlet}</span>
        </li>
      ))}
    </ul>
  </div>
</SectionWrapper>

<style>
  :global(.press-strip-wrapper) {
    --section-padding-y: clamp(var(--space-lg), 3vw, var(--space-2xl));
    border-bottom: 1px solid var(--color-border);
  }

  .press-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  @media (min-width: 900px) {
    .press-strip {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2xl);
    }
  }

  .press-strip__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    white-space: nowrap;
    flex-shrink: 0;
    margin: 0;
  }

  .press-strip__logos {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-lg), 3vw, var(--space-3xl));
    list-style: none;
    margin: 0;
    padding: 0;
    /* Mobile overflow: quiet horizontal scroll rather than clipping. */
    overflow-x: auto;
    max-width: 100%;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .press-strip__logos::-webkit-scrollbar { display: none; }

  .press-strip__item { flex-shrink: 0; }

  .press-strip__wordmark {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.1rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    opacity: 0.55;
    white-space: nowrap;
    line-height: 1;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .press-strip__wordmark:hover { opacity: 0.9; }
</style>
