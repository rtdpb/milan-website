---
/**
 * Samenwerken.astro — Three ways to work together · source-locked
 *
 * Copy is verbatim from Input homepage Milan.docx §Sectie 2 (label + title +
 * body + CTA per card). Controlled grid, three distinct moods, yellow used only
 * as a restrained detail (the "Gratis" tag + small accents), never a full fill.
 *
 * Routes preserved:
 *   Nieuwsbrief → /nieuwsbrief · Presentatie → /contact?type=lezing · Coaching → /contact?type=coaching
 * No text overlaps a photo (photos sit in their own cell / on top of cards).
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Picture } from 'astro:assets';
import SectionWrapper from '../ui/SectionWrapper.astro';
import { getStrings } from '../../i18n/utils';
import speakingImg from '../../assets/photos/milan-speaking-graph.jpg';
import networkingImg from '../../assets/photos/milan-networking.jpg';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const s = t.samenwerken;

const newsletterHref = isEn ? getRelativeLocaleUrl('en', 'newsletter') : `${import.meta.env.BASE_URL}nieuwsbrief`;
const lezingHref = isEn ? `${getRelativeLocaleUrl('en', 'contact')}?type=lezing` : `${import.meta.env.BASE_URL}contact?type=lezing`;
const coachingHref = isEn ? `${getRelativeLocaleUrl('en', 'contact')}?type=coaching` : `${import.meta.env.BASE_URL}contact?type=coaching`;

const arrow = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
const [news, talk, coach] = s.cards;
---

<SectionWrapper id="samenwerken" variant="default" labelledBy="samenwerken-heading">
  <div class="sw">
    <header class="sw__head" data-anim>
      <h2 id="samenwerken-heading" class="sw__heading">{s.heading}</h2>
      <p class="sw__subtext">{s.subtext}</p>
    </header>

    <div class="sw__grid" role="list" aria-label={s.ariaLabel}>

      <!-- 01 Nieuwsbrief — cream card, yellow details only -->
      <a href={newsletterHref} class="sw__card sw__card--news" role="listitem" data-anim data-anim-variant="scale">
        <div class="sw__news-visual" aria-hidden="true">
          <svg viewBox="0 0 120 84" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="8" y="10" width="104" height="66" rx="8" fill="#16181D" opacity="0.06"/>
            <rect x="2" y="4" width="104" height="66" rx="8" fill="#FFFFFF" stroke="#DCD6C8"/>
            <rect x="14" y="16" width="46" height="6" rx="3" fill="#FFDD11"/>
            <rect x="14" y="30" width="80" height="4" rx="2" fill="#16181D" opacity="0.85"/>
            <rect x="14" y="40" width="80" height="4" rx="2" fill="#16181D" opacity="0.35"/>
            <rect x="14" y="50" width="60" height="4" rx="2" fill="#16181D" opacity="0.35"/>
          </svg>
        </div>
        <div class="sw__card-body">
          <span class="sw__label-row">
            <span class="sw__label">{news.label}</span>
            {news.tag && <span class="sw__tag">{news.tag}</span>}
          </span>
          <h3 class="sw__card-title">{news.title}</h3>
          <p class="sw__card-desc">{news.description}</p>
          <span class="sw__cta-btn sw__cta-btn--ink">{news.cta}<Fragment set:html={arrow} /></span>
        </div>
      </a>

      <!-- 02 Presentatie — navy card, photo on top, text below -->
      <a href={lezingHref} class="sw__card sw__card--talk" role="listitem" data-anim data-anim-variant="scale">
        <div class="sw__talk-media">
          <Picture src={speakingImg} formats={['avif', 'webp']} widths={[500, 800, 1100]}
            sizes="(max-width: 760px) 92vw, 56vw"
            alt={isEn ? 'Milan presenting on stage.' : 'Milan geeft een presentatie op het podium.'}
            loading="lazy" class="sw__talk-img" />
        </div>
        <div class="sw__card-body">
          <span class="sw__label sw__label--light">{talk.label}</span>
          <h3 class="sw__card-title sw__card-title--light">{talk.title}</h3>
          <p class="sw__card-desc sw__card-desc--light">{talk.description}</p>
          <span class="sw__cta-btn sw__cta-btn--light">{talk.cta}<Fragment set:html={arrow} /></span>
        </div>
      </a>

      <!-- 03 1:1 Coaching — premium ink, portrait + exclusivity -->
      <a href={coachingHref} class="sw__card sw__card--coach" role="listitem" data-anim data-anim-variant="scale">
        <div class="sw__coach-media">
          <Picture src={networkingImg} formats={['avif', 'webp']} widths={[400, 700, 900]}
            sizes="(max-width: 900px) 92vw, 40vw"
            alt={isEn ? 'Milan in conversation with entrepreneurs.' : 'Milan in gesprek met ondernemers.'}
            loading="lazy" class="sw__coach-img" />
        </div>
        <div class="sw__coach-content">
          <div class="sw__coach-top">
            <span class="sw__label sw__label--light">{coach.label}</span>
            <span class="sw__scarcity"><span class="sw__scarcity-dot" aria-hidden="true"></span>{s.exclusiveLabel}</span>
          </div>
          <h3 class="sw__card-title sw__card-title--light sw__coach-title">{coach.title}</h3>
          <p class="sw__card-desc sw__card-desc--light">{coach.description}</p>
          <span class="sw__cta-btn">{coach.cta}<Fragment set:html={arrow} /></span>
        </div>
      </a>

    </div>
  </div>
</SectionWrapper>

<style>
  .sw { display: flex; flex-direction: column; gap: clamp(var(--space-xl), 4vw, var(--space-3xl)); }
  .sw__head { display: flex; flex-direction: column; gap: var(--space-md); max-width: 54ch; }
  .sw__heading { font-size: var(--text-3xl); margin: 0; }
  .sw__subtext { font-size: var(--text-lg); line-height: 1.55; color: var(--color-text-secondary); margin: 0; }

  /* 3 cards side by side (feedback: "naast elkaar"): nieuwsbrief in de lichte
     kleur, spreker + coaching in de donkere kleurstelling. Stacks on mobile. */
  .sw__grid { display: grid; grid-template-columns: 1fr; gap: clamp(var(--space-md), 2vw, var(--space-lg)); }
  @media (min-width: 900px) { .sw__grid { grid-template-columns: repeat(3, 1fr); align-items: stretch; } }

  .sw__card {
    position: relative; display: flex; flex-direction: column;
    border-radius: var(--radius-card); overflow: hidden; text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .sw__card:hover { transform: translateY(-4px); }
  .sw__card-body { display: flex; flex-direction: column; gap: var(--space-sm); padding: clamp(var(--space-lg), 2.4vw, var(--space-2xl)); flex: 1; }
  .sw__label-row { display: flex; align-items: center; gap: var(--space-sm); }
  .sw__label { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-secondary); }
  .sw__label--light { color: var(--color-dark-text-soft); }
  .sw__tag { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-ink); background: var(--color-accent); padding: 2px 8px; border-radius: var(--radius-pill); }
  .sw__card-title { font-size: var(--text-xl); line-height: 1.1; margin: 0; color: var(--color-text); hyphens: auto; overflow-wrap: break-word; }
  .sw__card-title--light { color: var(--color-dark-text); }
  .sw__card-desc { font-size: var(--text-base); line-height: 1.55; margin: 0; color: var(--color-text-secondary); }
  .sw__card-desc--light { color: var(--color-dark-text-soft); }
  /* Prominent pill CTAs — these actions (subscribe / book) are the whole point. */
  .sw__cta-btn {
    display: inline-flex; align-items: center; gap: var(--space-sm);
    align-self: flex-start; margin-top: auto;
    height: 52px; padding-inline: var(--space-lg);
    background: var(--color-accent); color: var(--color-accent-ink);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm); font-weight: 700; white-space: nowrap;
    transition: background-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .sw__cta-btn--ink { background: var(--color-text); color: var(--color-bg); }
  .sw__cta-btn--light { background: var(--color-dark-text); color: var(--color-ink); }
  .sw__cta-btn :global(svg) { transition: transform var(--duration-fast) var(--ease-out); }
  .sw__card:hover .sw__cta-btn { transform: translateY(-2px); }
  .sw__card:hover .sw__cta-btn :global(svg) { transform: translateX(4px); }
  .sw__card--news:hover .sw__cta-btn--ink { background: #000; }
  .sw__card--talk:hover .sw__cta-btn--light { background: #fff; }

  /* 01 Newsletter — light card (feedback: nieuwsbrief in de lichte kleur) */
  .sw__card--news { background: var(--color-surface); border: 1px solid var(--color-border); }
  .sw__news-visual {
    display: flex; align-items: center; justify-content: center;
    padding: clamp(var(--space-lg), 2.4vw, var(--space-2xl));
  }
  .sw__news-visual svg { width: min(200px, 62%); height: auto; display: block; }
  .sw__news-visual { aspect-ratio: 16 / 10; background: rgba(20, 22, 29, 0.035); }

  /* 02 Presentatie — navy, photo on top */
  .sw__card--talk { background: var(--color-navy); }
  .sw__talk-media { position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-navy-2); }
  .sw__talk-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; }

  /* 03 Coaching — ink premium (same vertical card shape as the other two) */
  .sw__card--coach { background: var(--color-ink); }
  .sw__coach-media { position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; }
  .sw__coach-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .sw__coach-content { display: flex; flex-direction: column; gap: var(--space-sm); flex: 1; padding: clamp(var(--space-lg), 2.4vw, var(--space-2xl)); }
  .sw__coach-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); flex-wrap: wrap; }
  .sw__coach-title { font-size: var(--text-xl); max-width: 18ch; }
  .sw__scarcity { display: inline-flex; align-items: center; gap: var(--space-sm); padding: 6px 14px; border: 1px solid var(--line-on-dark-strong); border-radius: var(--radius-pill); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-dark-text); }
  .sw__scarcity-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }
  /* Coaching CTA sits at the bottom of the card (equal-height 3-up row). */
  .sw__coach-content .sw__cta-btn { margin-top: auto; }
  .sw__card--coach:hover .sw__cta-btn { background: var(--color-accent-dark); }

  @media (prefers-reduced-motion: reduce) { .sw__card, .sw__cta-btn, .sw__cta-btn :global(svg) { transition: none; } }
</style>
