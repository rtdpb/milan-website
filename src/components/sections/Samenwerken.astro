---
/**
 * Samenwerken.astro — Three ways to work together, as "pricing"-style cards.
 *
 * Feedback round (#12 + gak): present the services as pricing-style feature-list cards.
 * Card 0 (Newsletter): light style, non-anchor container, inline Substack email form,
 *   subtext paragraph (no checkmarks), eyebrow 'Een dosis inspiratie', big title 'Nieuwsbrief'.
 * Card 1 (Presentatie): dark, eyebrow 'Een uniek ondernemersverhaal', title 'Presentatie'.
 * Card 2 (Coaching): dark, scarcity dot green + pulsing.
 *
 * Honesty rule: the Newsletter form is a real GET form to Substack; no fake success state.
 * Yellow used sparingly — CTA buttons, Gratis tag, checkmarks only.
 * Green scarcity dot for availability (var(--color-success)), pulsing.
 *
 * Routes: Presentatie → /contact?type=lezing · Coaching → /contact?type=coaching
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import SectionWrapper from '../ui/SectionWrapper.astro';
import { getStrings } from '../../i18n/utils';
import { TODO_SUBSTACK_URL } from '../../config';

const t = getStrings(Astro.currentLocale);
const isEn = (Astro.currentLocale ?? 'nl') === 'en';
const s = t.samenwerken;

const lezingHref = isEn ? `${getRelativeLocaleUrl('en', 'contact')}?type=lezing` : `${import.meta.env.BASE_URL}contact?type=lezing`;
const coachingHref = isEn ? `${getRelativeLocaleUrl('en', 'contact')}?type=coaching` : `${import.meta.env.BASE_URL}contact?type=coaching`;
// hrefs[0] is unused (card 0 is a non-anchor container with inline form)
const hrefs = ['', lezingHref, coachingHref];

// Substack subscribe URL — mirrors Newsletter.astro pattern
const subscribeUrl = `${TODO_SUBSTACK_URL.replace(/\/$/, '')}/subscribe`;
const isSubstackSentinel = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';

const arrow = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
const check = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
---

<SectionWrapper id="samenwerken" variant="default" labelledBy="samenwerken-heading">
  <div class="sw">
    <header class="sw__head" data-anim>
      <h2 id="samenwerken-heading" class="sw__heading kin">{s.heading}</h2>
      <p class="sw__subtext">{s.subtext}</p>
    </header>

    <div class="sw__grid" role="list" aria-label={s.ariaLabel}>
      {s.cards.map((card, i: number) => (
        i === 0 ? (
          /* ── Card 0: Newsletter — non-anchor (cannot nest form inside <a>) ── */
          <div class="sw__card sw__card--light" role="listitem" data-anim data-anim-variant="scale" style={`--i: ${i}`}>
            <div class="sw__card-head">
              <span class="sw__label-row">
                <span class="sw__label">{card.label}</span>
                {card.tag && <span class="sw__tag">{card.tag}</span>}
              </span>
              <h3 class="sw__title">{card.title}</h3>
            </div>

            {/* Subtext paragraph is the ONLY body copy on the Newsletter card
                (replaces both the tagline and the checkmark list per feedback). */}
            {card.subtext && <p class="sw__subtext-para">{card.subtext}</p>}

            {/* Inline email form — real GET form to Substack, no fake success state */}
            {isSubstackSentinel ? (
              <span
                class="sw__cta sw__cta--disabled"
                role="button"
                aria-disabled="true"
                tabindex="-1"
                title={isEn ? 'Link follows once the Substack URL is known' : 'Link volgt zodra Substack-URL bekend is'}
              >{card.cta}<Fragment set:html={arrow} /></span>
            ) : (
              <form class="sw__nl-form" action={subscribeUrl} method="get" target="_blank">
                <label class="sr-only" for="sw-nl-email">{s.labelEmail}</label>
                <input
                  id="sw-nl-email"
                  class="sw__nl-input"
                  type="email"
                  name="email"
                  required
                  placeholder={s.labelEmail}
                  autocomplete="email"
                />
                <button type="submit" class="sw__cta">
                  {card.cta}<Fragment set:html={arrow} />
                </button>
              </form>
            )}
          </div>
        ) : (
          /* ── Cards 1 & 2: anchor cards (Presentatie, Coaching) ── */
          <a href={hrefs[i]} class="sw__card" role="listitem" data-anim data-anim-variant="scale" style={`--i: ${i}`}>
            <div class="sw__card-head">
              <span class="sw__label-row">
                <span class="sw__label">{card.label}</span>
                {card.tag && <span class="sw__tag">{card.tag}</span>}
                {i === 2 && (
                  <span class="sw__scarcity"><span class="sw__scarcity-dot" aria-hidden="true"></span>{s.exclusiveLabel}</span>
                )}
              </span>
              <h3 class="sw__title">{card.title}</h3>
              <p class="sw__tagline">{card.tagline}</p>
            </div>

            <ul class="sw__features">
              {card.features.map((f: string) => (
                <li><Fragment set:html={check} /><span>{f}</span></li>
              ))}
            </ul>

            <span class="sw__cta">{card.cta}<Fragment set:html={arrow} /></span>
          </a>
        )
      ))}
    </div>
  </div>
</SectionWrapper>

<script>
  (function () {
    'use strict';
    // Bind the Plausible goal to this section's newsletter form only.
    var form = document.querySelector('.sw__nl-form');
    if (!form) return;
    form.addEventListener('submit', function () {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if (typeof (window as any).plausible === 'function') (window as any).plausible('Newsletter: Subscribe');
    });
  })();
</script>

<style>
  .sw { display: flex; flex-direction: column; gap: clamp(var(--space-xl), 4vw, var(--space-3xl)); }
  .sw__head { display: flex; flex-direction: column; gap: var(--space-md); max-width: 54ch; }
  .sw__heading { font-size: var(--text-3xl); margin: 0; }
  .sw__subtext { font-size: var(--text-lg); line-height: 1.55; color: var(--color-text-secondary); margin: 0; }

  /* Pricing-style cards; stack on mobile. On desktop the free Newsletter card
     (light) sits on the left spanning both rows, and the two paid services
     (Presentatie + Coaching, dark) stack vertically on the right so the accent
     falls on them (feedback #12: nieuwsbrief licht, spreker/coaching donker). */
  .sw__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  @media (min-width: 900px) {
    .sw__grid { grid-template-columns: 0.9fr 1.1fr; align-items: stretch; }
    .sw__card--light { grid-column: 1; grid-row: 1 / span 2; }
  }

  /* Paid services use the dark "1:1 coaching" style. */
  .sw__card {
    display: flex; flex-direction: column; gap: var(--space-lg);
    background: var(--color-ink); border-radius: var(--radius-card);
    padding: clamp(var(--space-lg), 2.4vw, var(--space-2xl));
    height: 100%; text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  /* Hover only for anchor cards (not the Newsletter div) */
  a.sw__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); }

  .sw__card-head { display: flex; flex-direction: column; gap: var(--space-sm); }
  .sw__label-row { display: flex; align-items: center; gap: var(--space-sm); flex-wrap: wrap; }
  .sw__label { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-dark-text-soft); }
  .sw__tag { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-ink); background: var(--color-accent); padding: 2px 8px; border-radius: var(--radius-pill); }
  .sw__scarcity { display: inline-flex; align-items: center; gap: var(--space-sm); padding: 4px 12px; border: 1px solid var(--line-on-dark-strong); border-radius: var(--radius-pill); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-dark-text); }

  /* ── Scarcity dot: green + pulsing (availability signal) ── */
  .sw__scarcity-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-success);
    animation: sw-dot-pulse 2s ease-in-out infinite;
  }
  @keyframes sw-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 60%, transparent); }
    50%       { opacity: 0.75; transform: scale(1.3); box-shadow: 0 0 0 4px transparent; }
  }

  .sw__title { font-size: var(--text-2xl); line-height: 1.08; margin: 0; color: var(--color-dark-text); hyphens: auto; }
  .sw__tagline { font-size: var(--text-base); line-height: 1.5; color: var(--color-dark-text-soft); margin: 0; }

  /* ── Light variant (Newsletter) — quiet card so the dark paid cards pop. ── */
  .sw__card--light { background: var(--color-bg); border: 1px solid var(--line-on-light); }
  .sw__card--light .sw__label { color: var(--color-text-secondary); }
  .sw__card--light .sw__title { color: var(--color-text); }
  .sw__card--light .sw__tagline { color: var(--color-text-secondary); }

  /* ── Newsletter subtext paragraph (replaces checkmarks on card 0) ── */
  .sw__subtext-para { font-size: var(--text-base); line-height: 1.6; color: var(--color-text-secondary); margin: 0; }

  /* ── Inline email form (Newsletter card) ── */
  .sw__nl-form { display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: center; margin-top: auto; }
  .sw__nl-input {
    flex: 1 1 200px; min-width: 0; height: 52px; padding-inline: var(--space-lg);
    border: 1px solid var(--line-on-light-strong); border-radius: var(--radius-pill);
    background: var(--color-bg); color: var(--color-text);
    font-family: inherit; font-size: var(--text-base); line-height: 1;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .sw__nl-input::placeholder { color: var(--color-text-secondary); opacity: 0.8; }
  .sw__nl-input:focus-visible { outline: none; border-color: var(--color-text); }

  .sw__features { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-sm); }
  .sw__features li { display: flex; align-items: flex-start; gap: var(--space-sm); font-size: var(--text-base); line-height: 1.4; color: var(--color-dark-text); }
  .sw__features :global(svg) { color: var(--color-accent); flex-shrink: 0; margin-top: 3px; }

  .sw__cta {
    display: inline-flex; align-items: center; gap: var(--space-sm);
    align-self: flex-start; margin-top: auto;
    height: 52px; padding-inline: var(--space-lg);
    background: var(--color-accent); color: var(--color-accent-ink);
    border: none; border-radius: var(--radius-pill); cursor: pointer;
    font-family: inherit; font-size: var(--text-sm); font-weight: 700; white-space: nowrap; text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .sw__cta--disabled { opacity: 0.45; cursor: not-allowed; pointer-events: none; }
  a.sw__card:hover .sw__cta,
  .sw__nl-form:focus-within ~ .sw__cta,
  .sw__nl-form button.sw__cta:hover { transform: translateY(-2px); background: var(--color-accent-dark); }
  .sw__cta :global(svg) { transition: transform var(--duration-fast) var(--ease-out); }
  a.sw__card:hover .sw__cta :global(svg) { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .sw__card, .sw__cta, .sw__cta :global(svg), .sw__nl-input { transition: none; }
    .sw__scarcity-dot { animation: none; }
  }
</style>
