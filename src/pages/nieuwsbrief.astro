---
/**
 * nieuwsbrief.astro — Newsletter landing page (NEWS-01)
 *
 * Source: PLAN 03-02 Task 3, 03-UI-SPEC.md §Surface 2, 03-PATTERNS.md §nieuwsbrief.astro
 *         CONTEXT D-01, D-02, D-04, D-05, D-06, D-07, NEWS-01, NEWS-02
 *
 * Section order (UI-SPEC §Surface 2):
 *   1. Hero (default) — eyebrow, H1, subtext, primary CTA (sentinel-gated)
 *   2. Value-prop (surface) — nl.nieuwsbrief.valueProps 3-tile row
 *   3. Signup (default) — Newsletter.astro reused (rewired Phase 3 redirect)
 *   4. Archive (default) — archiveArticles (up to 10 items), same grid as Articles.astro
 *   5. Social proof — OMITTED (no newsletter-specific quote exists — HOME-11, UI-SPEC §2e)
 *
 * SEO: unique title + description from nl.nieuwsbrief.pageTitle / pageDesc.
 * Dark band rule: NO dark band on this page — all sections are default or surface.
 *   (Coaching has one dark band; nieuwsbrief is fully editorial/light — UI-SPEC §2a)
 * Yellow rule: primary CTA button only (D-02); no yellow backgrounds or decorations.
 * Internal hrefs: import.meta.env.BASE_URL prefix (PATTERNS.md §BASE_URL, CR-01).
 * External links: target="_blank" rel="noopener noreferrer" (T-3-01, T-01-04).
 *
 * Sentinel guard (IS_SENTINEL):
 *   - true  → archive renders nl.articles.items as placeholder cards (D-04)
 *   - false → fetch ${TODO_SUBSTACK_URL}/feed (maxItems 10); on empty → D-06 fallback
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';
import Card from '../components/ui/Card.astro';
import RevealOnScroll from '../components/ui/RevealOnScroll.astro';
import PlaceholderBadge from '../components/ui/PlaceholderBadge.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { getStrings } from '../i18n/utils';
import { TODO_SUBSTACK_URL } from '../config';
import { fetchSubstackFeed, parseFeed, type ArticleCard, type PlaceholderCard } from '../lib/rss';
import feedSnapshot from '../data/substack-feed.xml?raw';

// Phase 4: locale-parameterized strings (Astro.currentLocale is 'nl' at root)
const t = getStrings(Astro.currentLocale);

// ── Sentinel guard — decides placeholder vs live feed ───────────────────────
const IS_SENTINEL = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
const subscribeUrl = `${TODO_SUBSTACK_URL.replace(/\/$/, '')}/subscribe`;
const substackPublicationUrl = TODO_SUBSTACK_URL;

// Archive: REAL issues only — hidden until the Substack feed has posts. No
// placeholder cards (client: articles may only appear once we actually have them).
let archiveArticles: ArticleCard[] | PlaceholderCard[] = [];
if (!IS_SENTINEL) {
  archiveArticles = await fetchSubstackFeed(`${TODO_SUBSTACK_URL}/feed`, 10);
  // CI can't reach Substack (403 from the datacenter IP) — fall back to the
  // committed snapshot so the archive still renders (`npm run articles:pull`).
  if (archiveArticles.length === 0) archiveArticles = parseFeed(feedSnapshot, 10);
}
const hasArchive = archiveArticles.length > 0;
---

<BaseLayout title={t.nieuwsbrief.pageTitle} description={t.nieuwsbrief.pageDesc} nlSlug="nieuwsbrief" enSlug="newsletter">

  <!-- 1. Hero: typographic hero, no photo (UI-SPEC §2a: light editorial typographic hero) -->
  <SectionWrapper id="nieuwsbrief-hero" labelledBy="nieuwsbrief-hero-heading" variant="default">
    <div class="nieuwsbrief-hero">
      <p class="nieuwsbrief-hero__eyebrow">{t.nieuwsbrief.eyebrow}</p>
      <h1 id="nieuwsbrief-hero-heading" class="nieuwsbrief-hero__heading">
        {t.nieuwsbrief.heading}
      </h1>
      <p class="nieuwsbrief-hero__subtext">{t.nieuwsbrief.subtext}</p>
      <div class="nieuwsbrief-hero__ctas">
        {IS_SENTINEL ? (
          <span
            class="nieuwsbrief-hero__cta nieuwsbrief-hero__cta--disabled"
            role="button"
            aria-disabled="true"
            tabindex="-1"
            title="Binnenkort beschikbaar via Substack"
          >
            {t.nieuwsbrief.cta}
          </span>
        ) : (
          <form
            class="nieuwsbrief-hero__form"
            action={subscribeUrl}
            method="get"
            target="_blank"
          >
            <label class="sr-only" for="nb-hero-email">{t.nieuwsbrief.labelEmail}</label>
            <input
              id="nb-hero-email"
              type="email"
              name="email"
              required
              placeholder={t.nieuwsbrief.labelEmail}
              autocomplete="email"
              class="nieuwsbrief-hero__input"
            />
            <button type="submit" class="nieuwsbrief-hero__cta">
              {t.nieuwsbrief.cta}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </form>
        )}
      </div>
    </div>
  </SectionWrapper>

  <!-- 2. Value-prop: lightweight 3-tile row (UI-SPEC §2b) — no Card, no yellow -->
  <SectionWrapper id="nieuwsbrief-waarde" labelledBy="nieuwsbrief-waarde-heading" variant="surface">
    <div class="nieuwsbrief-waarde">
      <h2 id="nieuwsbrief-waarde-heading" class="visually-hidden">Wat je krijgt</h2>
      <div class="nieuwsbrief-waarde__tiles">
        {t.nieuwsbrief.valueProps.map((prop: { label: string; description: string }) => (
          <div class="nieuwsbrief-waarde__tile">
            <p class="nieuwsbrief-waarde__tile-label">{prop.label}</p>
            <p class="nieuwsbrief-waarde__tile-desc">{prop.description}</p>
          </div>
        ))}
      </div>
    </div>
  </SectionWrapper>

  <!-- 3. Signup: reuse Newsletter.astro as-is (rewired Phase 3 redirect — NEWS-02) -->
  <!-- No duplication of signup markup — same component used on homepage -->
  <Newsletter />

  <!-- 4. Archive: recent issues grid — only when the feed has real posts (no placeholders) -->
  {hasArchive && (
  <SectionWrapper id="nieuwsbrief-archief" labelledBy="nieuwsbrief-archief-heading" variant="default">
    <div class="nieuwsbrief-archief">

      <h2 id="nieuwsbrief-archief-heading" class="nieuwsbrief-archief__heading">
        {t.nieuwsbrief.archiveHeading}
      </h2>

      <!-- Article cards grid — same 1→2→3 responsive layout as Articles.astro (FND-04) -->
      <div class="nieuwsbrief-archief__grid" role="list">

        {archiveArticles.map((article, i) => (
          <div class="nieuwsbrief-archief__card-wrapper" role="listitem">
            <RevealOnScroll delay={i * 80}>
              <Card class="nieuwsbrief-archief__card">

                <!-- Placeholder badge — only when isPlaceholder (D-04, D-06) -->
                {article.isPlaceholder && (
                  <div class="nieuwsbrief-archief__badge-row">
                    <PlaceholderBadge />
                  </div>
                )}

                <!-- Category eyebrow -->
                <p class="nieuwsbrief-archief__category">
                  {article.category}
                </p>

                <!-- Article title — text-wrap:balance for RSS untrusted-length titles -->
                <h3 class="nieuwsbrief-archief__title">
                  {article.title}
                </h3>

                <!-- Excerpt — capped at 160 chars in rss.ts (T-3-02) -->
                <p class="nieuwsbrief-archief__excerpt">
                  {article.excerpt}
                </p>

                <!-- Meta row: date + read time -->
                <div class="nieuwsbrief-archief__meta">
                  <span class="nieuwsbrief-archief__date">{article.date}</span>
                  <span class="nieuwsbrief-archief__separator" aria-hidden="true">·</span>
                  <span class="nieuwsbrief-archief__read-time">{article.readTime}</span>
                </div>

                <!-- "Lees verder" — disabled when placeholder (D-12, HOME-10),
                     real external link with aria-label when live (T-3-01, a11y) -->
                {article.isPlaceholder ? (
                  <span
                    class="nieuwsbrief-archief__read-more"
                    role="link"
                    aria-disabled="true"
                    tabindex="-1"
                    title="Binnenkort beschikbaar"
                    aria-label={`Lees "${article.title}" — binnenkort beschikbaar`}
                  >
                    {t.common.readMore}
                  </span>
                ) : (
                  <a
                    href={(article as ArticleCard).href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="nieuwsbrief-archief__read-more nieuwsbrief-archief__read-more--enabled"
                    aria-label={`Lees "${article.title}" op Substack`}
                  >
                    {t.common.readMore}
                  </a>
                )}

              </Card>
            </RevealOnScroll>
          </div>
        ))}

      </div>
      <!-- End article cards grid -->

      <!-- "Alle artikelen" — disabled when IS_SENTINEL, external anchor when live (D-07, T-3-01) -->
      <div class="nieuwsbrief-archief__see-all-row">
        {IS_SENTINEL ? (
          <span
            class="nieuwsbrief-archief__see-all"
            role="link"
            aria-disabled="true"
            tabindex="-1"
            title="Binnenkort beschikbaar"
          >
            {t.articles.seeAll}
            <span class="nieuwsbrief-archief__see-all-arrow" aria-hidden="true">→</span>
          </span>
        ) : (
          <a
            href={substackPublicationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="nieuwsbrief-archief__see-all nieuwsbrief-archief__see-all--enabled"
          >
            {t.articles.seeAll}
            <span class="nieuwsbrief-archief__see-all-arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>

    </div>
  </SectionWrapper>
  )}

  <!-- 5. Social proof — OMITTED per UI-SPEC §2e and HOME-11:
       No newsletter-specific quote exists. Must never fabricate or repurpose an off-topic one. -->

</BaseLayout>

<script>
  (function () {
    'use strict';
    var form = document.querySelector('.nieuwsbrief-hero__form');
    if (!form) return;
    form.addEventListener('submit', function () {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if (typeof (window as any).plausible === 'function') {
        (window as any).plausible('Newsletter: Subscribe');
      }
    });
  })();
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  /* Same layout contract as coaching.astro hero (D-03 / PATTERNS §nieuwsbrief.astro) */
  .nieuwsbrief-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 720px;
    padding-block: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .nieuwsbrief-hero {
      padding-block: var(--space-4xl);
    }
  }

  .nieuwsbrief-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .nieuwsbrief-hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);   /* 48–88px — Display H1 (UI-SPEC §Typography) */
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .nieuwsbrief-hero__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);  /* 16–18px body */
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 640px;
    margin: 0;
  }

  .nieuwsbrief-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  /* ── Hero inline email form ───────────────────────────────────────────── */
  .nieuwsbrief-hero__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    width: 100%;
    max-width: 520px;
  }

  .nieuwsbrief-hero__input {
    flex: 1 1 240px;
    min-width: 0;
    height: 54px;
    padding-inline: var(--space-lg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: 1rem; /* 16px — prevents iOS zoom */
    line-height: 1;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .nieuwsbrief-hero__input::placeholder {
    color: var(--color-text-secondary);
    opacity: 0.8;
  }

  .nieuwsbrief-hero__input:focus-visible {
    outline: none;
    border-color: var(--color-text);
  }

  .nieuwsbrief-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    height: 54px;
    padding-inline: var(--space-xl);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border: none;
    border-radius: var(--radius-pill);
    font-family: inherit;
    font-size: var(--text-base);
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .nieuwsbrief-hero__cta:not(.nieuwsbrief-hero__cta--disabled):hover {
    transform: translateY(-2px);
    background-color: var(--color-accent-dark);
  }

  .nieuwsbrief-hero__cta svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .nieuwsbrief-hero__cta:not(.nieuwsbrief-hero__cta--disabled):hover svg {
    transform: translateX(3px);
  }

  .nieuwsbrief-hero__cta:focus-visible {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 3px;
  }

  .nieuwsbrief-hero__cta--disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* sr-only utility (for the hero email label) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .nieuwsbrief-hero__cta,
    .nieuwsbrief-hero__cta svg,
    .nieuwsbrief-hero__input {
      transition: none;
    }
  }

  /* ── Value-prop tiles ─────────────────────────────────────────────────── */
  /* Lightweight: no Card, flex row-wrap (UI-SPEC §2b) */
  .nieuwsbrief-waarde {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .nieuwsbrief-waarde__tiles {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .nieuwsbrief-waarde__tiles {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2xl);
    }
  }

  .nieuwsbrief-waarde__tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
    min-width: 200px;
  }

  .nieuwsbrief-waarde__tile-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);   /* 14–16px label */
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .nieuwsbrief-waarde__tile-desc {
    font-family: var(--font-body);
    font-size: var(--text-base);  /* 16–18px body */
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Archive section ──────────────────────────────────────────────────── */
  .nieuwsbrief-archief {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .nieuwsbrief-archief__heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);   /* 24–36px section heading */
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .nieuwsbrief-archief__heading {
      font-size: var(--text-3xl);
    }
  }

  /* ── Cards grid: 1 col mobile → 2 col tablet → 3 col desktop (FND-04) ── */
  .nieuwsbrief-archief__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) {
    .nieuwsbrief-archief__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .nieuwsbrief-archief__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }

  .nieuwsbrief-archief__card-wrapper {
    height: 100%;
  }

  /* Card inner layout via :global (same pattern as Articles.astro) */
  :global(.nieuwsbrief-archief__card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
    position: relative;
  }

  /* ── Placeholder badge row ────────────────────────────────────────────── */
  .nieuwsbrief-archief__badge-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: calc(-1 * var(--space-xs));
  }

  /* ── Category eyebrow ────────────────────────────────────────────────── */
  .nieuwsbrief-archief__category {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Article title ────────────────────────────────────────────────────── */
  .nieuwsbrief-archief__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);   /* 20–28px subheading */
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;   /* handles long RSS titles (E3/E4 backstop) */
  }

  /* ── Excerpt ─────────────────────────────────────────────────────────── */
  .nieuwsbrief-archief__excerpt {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1;  /* Pushes meta + read-more to bottom */
  }

  /* ── Meta row ─────────────────────────────────────────────────────────── */
  .nieuwsbrief-archief__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .nieuwsbrief-archief__separator {
    opacity: 0.5;
  }

  /* ── "Lees verder" — base styles (shared disabled + enabled) ──────────── */
  .nieuwsbrief-archief__read-more {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    min-height: 44px;       /* WCAG 2.5.5 touch target */
    align-self: flex-start;
    padding-block: var(--space-sm);
    /* Disabled state */
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Enabled "Lees verder" link */
  .nieuwsbrief-archief__read-more--enabled {
    opacity: 1;
    cursor: pointer;
  }

  .nieuwsbrief-archief__read-more--enabled:hover {
    text-decoration: underline;
  }

  .nieuwsbrief-archief__read-more--enabled:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── "Alle artikelen" row ────────────────────────────────────────────── */
  .nieuwsbrief-archief__see-all-row {
    display: flex;
    justify-content: center;
    padding-top: var(--space-md);
  }

  .nieuwsbrief-archief__see-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    min-height: 44px;
    padding-block: var(--space-sm);
    /* Disabled state */
    opacity: 0.5;
    cursor: not-allowed;
  }

  .nieuwsbrief-archief__see-all--enabled {
    opacity: 1;
    cursor: pointer;
  }

  .nieuwsbrief-archief__see-all--enabled:hover .nieuwsbrief-archief__see-all-arrow {
    transform: translateX(4px);
  }

  .nieuwsbrief-archief__see-all--enabled:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nieuwsbrief-archief__see-all-arrow {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  /* ── Visually hidden utility (for value-prop section heading — a11y) ─── */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
