---
/**
 * boek.astro — Book / Pre-order page — NL (BOOK-01, Phase 5)
 *
 * Source: PLAN 05-01 Task 3, 05-PATTERNS.md §boek.astro, 05-UI-SPEC.md §1,
 *         05-CONTEXT.md D-01 (honest teaser), D-02 (dual capture), D-03 (checkout seam)
 *
 * Section order:
 *   1. #boek-hero   (default / light) — eyebrow + H1 + body + Substack CTA primary
 *   2. #boek-teaser (dark)            — honest statement about the book (one dark band)
 *   3. #boek-capture (default / light)— Substack redirect + "of" separator + BookInterestForm
 *
 * Honesty rules (HOME-10, D-01, D-03):
 * - IS_CHECKOUT_SENTINEL true → checkout block OMITTED entirely (never a disabled button)
 * - IS_SUBSTACK_SENTINEL true → Substack CTA renders as disabled span (never href="#")
 * - Hero Substack CTA anchor carries id="boek-hero-cta" for Plan 02 StickyCTA observer
 *
 * hreflang: explicit nlSlug="boek" + enSlug="book" passed to BaseLayout
 * (BaseHead effectiveNlSlug/enSlug pattern — same as spreker/speaking pair)
 *
 * Internal hrefs: import.meta.env.BASE_URL prefix (GitHub Pages subpath safe, no href="#")
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';
import Button from '../components/ui/Button.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import BookInterestForm from '../components/forms/BookInterestForm.astro';
import StickyCTA from '../components/ui/StickyCTA.astro';
import { getStrings } from '../i18n/utils';
import {
  TODO_BOOK_CHECKOUT_URL,
  TODO_SUBSTACK_URL,
} from '../config';

const t = getStrings(Astro.currentLocale);
const IS_CHECKOUT_SENTINEL = TODO_BOOK_CHECKOUT_URL === 'TODO_BOOK_CHECKOUT_URL';
const IS_SUBSTACK_SENTINEL  = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
// CR-02: strip trailing slash before appending /subscribe — guards against double-slash URL
// if the supplied Substack URL ends with '/'. The config comment instructs this but has no
// runtime guard; defensive normalisation is applied at every usage site.
const subscribeUrl = `${TODO_SUBSTACK_URL.replace(/\/$/, '')}/subscribe`;
---

<BaseLayout
  title={t.boek.pageTitle}
  description={t.boek.pageDesc}
  nlSlug="boek"
  enSlug="book"
>

  <!-- 1. Hero: eyebrow + H1 + body paragraphs + Substack CTA primary -->
  <SectionWrapper id="boek-hero" labelledBy="boek-hero-heading" variant="default">
    <div class="boek-hero">
      <p class="boek-hero__eyebrow">{t.boek.eyebrow}</p>
      <h1 id="boek-hero-heading" class="boek-hero__heading">
        {t.boek.heading}
      </h1>
      <div class="boek-hero__body">
        {t.boek.body.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <p class="boek-hero__subtext">{t.boek.subtext}</p>
      <div class="boek-hero__ctas">
        <!-- IS_SUBSTACK_SENTINEL: disabled span when Substack URL not yet configured (UI-SPEC §2a, HOME-10) -->
        {IS_SUBSTACK_SENTINEL ? (
          <span
            id="boek-hero-cta"
            class="btn btn--primary btn--disabled"
            role="button"
            aria-disabled="true"
            tabindex="-1"
            title={t.common.disabledTooltip}
          >
            {t.boek.ctaSubstack}
          </span>
        ) : (
          <a
            id="boek-hero-cta"
            href={subscribeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
          >
            {t.boek.ctaSubstack}
          </a>
        )}
        <!-- Checkout seam (D-03): OMIT block entirely while TODO_BOOK_CHECKOUT_URL unreplaced -->
        {!IS_CHECKOUT_SENTINEL && (
          <Button href={TODO_BOOK_CHECKOUT_URL} variant="ghost" external>
            {t.boek.checkoutCta}
          </Button>
        )}
      </div>
    </div>
  </SectionWrapper>

  <!-- 2. Dark teaser band: one per page (UI-SPEC §1 dark band rule, no purchase button here) -->
  <SectionWrapper id="boek-teaser" labelledBy="boek-teaser-heading" variant="dark">
    <div class="boek-teaser">
      <p class="boek-teaser__eyebrow">{t.boek.eyebrow}</p>
      <h2 id="boek-teaser-heading" class="boek-teaser__heading">
        {t.boek.heading}
      </h2>
      <p class="boek-teaser__body">{t.boek.body[0]}</p>
    </div>
  </SectionWrapper>

  <!-- 3. Interest capture: Substack redirect + "of" separator + BookInterestForm -->
  <SectionWrapper id="boek-capture" labelledBy="boek-capture-heading" variant="default">
    <div class="boek-capture">
      <h2 id="boek-capture-heading" class="boek-capture__heading">{t.boek.formHeading}</h2>
      <p class="boek-capture__subtext">{t.boek.subtext}</p>

      <!-- Primary Substack affordance (IS_SENTINEL guard) -->
      <div class="boek-capture__primary">
        {IS_SUBSTACK_SENTINEL ? (
          <span
            class="btn btn--primary btn--disabled"
            role="button"
            aria-disabled="true"
            tabindex="-1"
            title={t.common.disabledTooltip}
          >
            {t.boek.ctaSubstack}
          </span>
        ) : (
          <a
            href={subscribeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
          >
            {t.boek.ctaSubstack}
          </a>
        )}
      </div>

      <!-- "of" separator between primary Substack affordance and secondary form -->
      <p class="boek-capture__separator" aria-hidden="true">{t.boek.orSeparator}</p>

      <!-- Secondary: Web3Forms BookInterestForm (2-field, 7-state, XSS-safe) -->
      <BookInterestForm />
    </div>
  </SectionWrapper>

  <!-- Newsletter section reused at the bottom -->
  <Newsletter />

  <!--
    StickyCTA — appears when the book hero CTA (#boek-hero-cta) scrolls out of view.
    targetId "boek-hero-cta" is set on the Substack CTA anchor in the hero section above.
    Fires 'Sticky CTA: Click' Plausible goal on click. D-07 / GROW-01.
    Note: when IS_SUBSTACK_SENTINEL is true, #boek-hero-cta is a disabled <span>
    (not an <a>); the observer still watches it and the sticky CTA still shows.
  -->
  <StickyCTA
    label={t.boek.stickyCta}
    href={`${import.meta.env.BASE_URL}contact`}
    targetId="boek-hero-cta"
  />

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .boek-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 720px;
    padding-block: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .boek-hero {
      padding-block: var(--space-4xl);
    }
  }

  .boek-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* H1: --text-5xl fluid clamp reflows at 320px viewport (backstop requirement) */
  .boek-hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 300;
    line-height: 1.1;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .boek-hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 640px;
  }

  .boek-hero__body p {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .boek-hero__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 560px;
  }

  .boek-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  /* ── Dark teaser band (one per page — dark band rule) ────────────────── */
  .boek-teaser {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 720px;
  }

  .boek-teaser__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dark-text);
    /* Yellow accent eyebrow in dark section — D-02 rule: one per dark section */
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-sm);
    margin: 0;
  }

  .boek-teaser__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-dark-text);
    text-wrap: balance;
    margin: 0;
  }

  .boek-teaser__body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-dark-text);
    opacity: 0.85;
    margin: 0;
    max-width: 640px;
  }

  /* ── Interest capture section ────────────────────────────────────────── */
  .boek-capture {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 640px;
    padding-block: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .boek-capture {
      padding-block: var(--space-3xl);
    }
  }

  .boek-capture__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .boek-capture__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .boek-capture__primary {
    display: flex;
    align-items: flex-start;
  }

  /* "of" / "or" visual separator between affordances */
  .boek-capture__separator {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-secondary);
    margin: 0;
    letter-spacing: 0.02em;
  }
</style>
