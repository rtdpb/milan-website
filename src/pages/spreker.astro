---
/**
 * spreker.astro — Speaker landing page (rebuilt from client feedback round)
 *
 * Sections (feedbackronde/Spreker.docx):
 *   1. Full-bleed stage header with overlaid title "Een verhaal dat blijft hangen"
 *   2. "Benoemd in" press strip
 *   3. Intro (3 paragraphs)
 *   4. Voor wie / Wat je krijgt (two info blocks)
 *   5. Booking band → Athenas (exclusive booking partner)
 *   6. Testimonials (4)
 *   7. "Eerder gesproken bij" (organisations)
 *   8. Awards & milestones
 *   9. Samenwerken (the 3 services) reused
 *
 * The stage/speaking photo is on-context here (unlike coaching). Booking CTAs
 * point at the external Athenas page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';
import PressStrip from '../components/sections/PressStrip.astro';
import Samenwerken from '../components/sections/Samenwerken.astro';
import { Picture } from 'astro:assets';
import heroSrc from '../assets/photos/milan-speaking-graph.jpg';
import { getStrings } from '../i18n/utils';
import { ATHENAS_URL } from '../config';
import { speakerLogoFiles, speakerLogoSquare } from '../components/sections/speakerLogos';

const t = getStrings(Astro.currentLocale);
const s = t.spreker;
const base = import.meta.env.BASE_URL;
const arrow = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<BaseLayout title={s.pageTitle} description={s.pageDesc} nlSlug="spreker" enSlug="speaking">

  <!-- 1. Full-bleed stage header -->
  <header class="shero anim-kenburns">
    <Picture
      src={heroSrc}
      formats={['avif', 'webp']}
      widths={[768, 1200, 1600, 2000, 2400]}
      sizes="100vw"
      alt={s.heroImageAlt}
      priority
      class="shero__img"
    />
    <div class="shero__scrim"></div>
    <div class="shero__inner">
      <p class="shero__eyebrow">{s.eyebrow}</p>
      <h1 class="shero__title">{s.heroTitle}</h1>
      <a class="shero__cta" href={ATHENAS_URL} target="_blank" rel="noopener noreferrer">
        {s.ctaPrimary}<Fragment set:html={arrow} />
      </a>
    </div>
  </header>

  <!-- 2. Benoemd in -->
  <PressStrip />

  <!-- 3. Intro -->
  <SectionWrapper id="spreker-intro" variant="default">
    <div class="sintro" data-anim>
      {s.intro.map((p: string) => <p>{p}</p>)}
    </div>
  </SectionWrapper>

  <!-- 4. Voor wie / Wat je krijgt -->
  <SectionWrapper id="spreker-info" variant="surface">
    <div class="info">
      {s.infoBlocks.map((b, i: number) => (
        <div class="info__block" data-anim style={`--i: ${i}`}>
          <h2 class="info__title">{b.title}</h2>
          <p class="info__text">{b.text}</p>
        </div>
      ))}
    </div>
  </SectionWrapper>

  <!-- 5. Booking (Athenas) -->
  <SectionWrapper id="spreker-booking" variant="dark" labelledBy="spreker-booking-heading">
    <div class="booking" data-anim>
      <div class="booking__text">
        <h2 id="spreker-booking-heading" class="booking__heading">{s.bookingHeading}</h2>
        <p class="booking__body">{s.bookingText}</p>
      </div>
      <a class="booking__cta" href={ATHENAS_URL} target="_blank" rel="noopener noreferrer">
        {s.ctaPrimary}<Fragment set:html={arrow} />
      </a>
    </div>
  </SectionWrapper>

  <!-- 6. Testimonials -->
  <SectionWrapper id="spreker-testimonials" variant="default" labelledBy="spreker-testimonials-heading">
    <h2 id="spreker-testimonials-heading" class="sec-heading" data-anim>{s.testimonialsHeading}</h2>
    <div class="quotes">
      {s.testimonials.map((q, i: number) => (
        <figure class="quote" data-anim style={`--i: ${i}`}>
          <blockquote class="quote__text">{q.quote}</blockquote>
          <figcaption class="quote__by">
            <span class="quote__name">{q.name}</span>
            {q.role && <span class="quote__role">{q.role}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </SectionWrapper>

  <!-- 7. Eerder gesproken bij — dark logo-card grid + yellow CTA card + divider -->
  <SectionWrapper id="spreker-spokenat" variant="ink" labelledBy="spreker-spokenat-heading">
    <div class="sat__intro" data-anim>
      <p class="sat__eyebrow">{s.spokenAtEyebrow}</p>
      <h2 id="spreker-spokenat-heading" class="sat__heading">{s.spokenAtHeading}</h2>
      <p class="sat__subtext">{s.spokenAtSubtext}</p>
    </div>

    <div class="sat__grid" data-anim style="--i: 1">
      {s.spokenAt.map((org: string) => (
        <div class={`sat__card${speakerLogoFiles[org] ? '' : ' sat__card--textonly'}`}>
          {speakerLogoFiles[org]
            ? (<span class="sat__logo-wrap"><img class={`sat__logo${speakerLogoSquare[org] ? ' sat__logo--mark' : ''}`} src={base + speakerLogoFiles[org]} alt="" aria-hidden="true" loading="lazy" /></span>)
            : null}
          <span class="sat__org">{org}</span>
        </div>
      ))}
      {/* Final cell: yellow-outlined "Boek lezing" CTA card */}
      <a class="sat__card sat__card--cta" href={ATHENAS_URL} target="_blank" rel="noopener noreferrer">
        <span class="sat__cta-label">{s.spokenAtCta}</span>
        <Fragment set:html={arrow} />
      </a>
    </div>

    <div class="sat__more" data-anim style="--i: 2">
      <span class="sat__more-line" aria-hidden="true"></span>
      <span class="sat__more-text">{s.spokenAtMore}</span>
      <span class="sat__more-line" aria-hidden="true"></span>
    </div>
  </SectionWrapper>

  <!-- 8. Awards & milestones -->
  <SectionWrapper id="spreker-awards" variant="default" labelledBy="spreker-awards-heading">
    <h2 id="spreker-awards-heading" class="sec-heading" data-anim>{s.awardsHeading}</h2>
    <ul class="awards" data-anim>
      {s.awards.map((a) => (
        <li class="award">
          <span class="award__title">{a.title}</span>
          <span class="award__meta">{a.by} · {a.date}</span>
        </li>
      ))}
    </ul>
  </SectionWrapper>

  <!-- 9. The 3 services -->
  <Samenwerken />

</BaseLayout>

<style>
  .sec-heading { font-size: var(--text-3xl); line-height: 1.08; margin: 0 0 clamp(var(--space-lg), 3vw, var(--space-2xl)); color: var(--color-text); }

  /* ── 1. Stage header (full-bleed overlay) ─────────────────────────────── */
  .shero { position: relative; width: 100%; min-height: clamp(420px, 66vh, 620px); display: flex; align-items: flex-end; overflow: clip; }
  .shero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .shero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,18,21,0.15) 0%, rgba(16,18,21,0.35) 45%, rgba(16,18,21,0.85) 100%); }
  .shero__inner { position: relative; width: 100%; max-width: var(--max-width); margin-inline: auto; padding: var(--gutter); padding-bottom: clamp(var(--space-xl), 4vw, var(--space-3xl)); display: flex; flex-direction: column; gap: var(--space-md); align-items: flex-start; }
  .shero__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin: 0; }
  .shero__title { font-size: clamp(2.4rem, 1.2rem + 4vw, 4.25rem); line-height: 1.02; letter-spacing: -0.03em; font-weight: 730; color: var(--color-dark-text); margin: 0; max-width: 18ch; text-wrap: balance; }
  .shero__cta { display: inline-flex; align-items: center; gap: var(--space-sm); height: 54px; padding-inline: var(--space-xl); border-radius: var(--radius-pill); background: var(--color-accent); color: var(--color-accent-ink); font-size: var(--text-sm); font-weight: 700; text-decoration: none; margin-top: var(--space-sm); transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out); }
  .shero__cta:hover { transform: translateY(-2px); background: var(--color-accent-dark); }
  .shero__cta :global(svg) { transition: transform var(--duration-fast) var(--ease-out); }
  .shero__cta:hover :global(svg) { transform: translateX(3px); }

  /* ── 3. Intro ─────────────────────────────────────────────────────────── */
  .sintro { display: flex; flex-direction: column; gap: var(--space-lg); max-width: 68ch; }
  .sintro p { font-size: var(--text-lg); line-height: 1.6; color: var(--color-text-secondary); margin: 0; }
  .sintro p:first-child { color: var(--color-text); font-weight: 500; }

  /* ── 4. Info blocks ───────────────────────────────────────────────────── */
  .info { display: grid; grid-template-columns: 1fr; gap: clamp(var(--space-lg), 4vw, var(--space-2xl)); }
  @media (min-width: 760px) { .info { grid-template-columns: 1fr 1fr; } }
  .info__block { display: flex; flex-direction: column; gap: var(--space-sm); }
  .info__title { font-size: var(--text-xl); margin: 0; color: var(--color-text); }
  .info__text { font-size: var(--text-base); line-height: 1.65; color: var(--color-text-secondary); margin: 0; }

  /* ── 5. Booking band ──────────────────────────────────────────────────── */
  .booking { display: flex; flex-direction: column; gap: var(--space-lg); align-items: flex-start; }
  @media (min-width: 760px) { .booking { flex-direction: row; align-items: center; justify-content: space-between; gap: var(--space-2xl); } }
  .booking__heading { font-size: var(--text-2xl); margin: 0 0 var(--space-sm); color: var(--color-dark-text); }
  .booking__body { font-size: var(--text-base); line-height: 1.6; color: var(--color-dark-text-soft); margin: 0; max-width: 60ch; }
  .booking__cta { display: inline-flex; align-items: center; gap: var(--space-sm); flex-shrink: 0; height: 56px; padding-inline: var(--space-xl); border-radius: var(--radius-pill); background: var(--color-accent); color: var(--color-accent-ink); font-size: var(--text-base); font-weight: 700; text-decoration: none; transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out); }
  .booking__cta:hover { transform: translateY(-2px); background: var(--color-accent-dark); }
  .booking__cta :global(svg) { transition: transform var(--duration-fast) var(--ease-out); }
  .booking__cta:hover :global(svg) { transform: translateX(3px); }

  /* ── 6. Testimonials ──────────────────────────────────────────────────── */
  .quotes { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  @media (min-width: 760px) { .quotes { grid-template-columns: 1fr 1fr; } }
  .quote { margin: 0; display: flex; flex-direction: column; gap: var(--space-md); background: var(--color-surface); border-radius: var(--radius-card); padding: clamp(var(--space-lg), 2.5vw, var(--space-xl)); }
  .quote__text { margin: 0; font-size: var(--text-base); line-height: 1.6; color: var(--color-text); }
  .quote__by { display: flex; flex-direction: column; gap: 2px; }
  .quote__name { font-size: var(--text-sm); font-weight: 700; color: var(--color-text); }
  .quote__role { font-size: var(--text-xs); color: var(--color-text-secondary); }

  /* ── 7. Eerder gesproken bij — dark logo-card grid (Milan's design) ────── */
  .sat__intro { display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: clamp(var(--space-lg), 3vw, var(--space-2xl)); max-width: 52ch; }
  .sat__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin: 0; }
  .sat__heading { font-size: var(--text-3xl); line-height: 1.08; margin: 0; color: var(--color-dark-text); }
  .sat__subtext { font-size: var(--text-base); line-height: 1.6; color: var(--color-dark-text-soft); margin: 0; }

  /* 4-col grid on desktop → 2-col tablet → 1-col mobile */
  .sat__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-sm); }
  @media (min-width: 560px) { .sat__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-md); } }
  @media (min-width: 960px) { .sat__grid { grid-template-columns: repeat(4, 1fr); } }

  /* Card: logo left, org name right, left-aligned and vertically centred. */
  .sat__card {
    display: flex; flex-direction: row; align-items: center; justify-content: flex-start;
    gap: var(--space-md); text-align: left;
    background: var(--color-ink-2); border: 1px solid var(--line-on-dark);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-md), 1.6vw, var(--space-lg));
    min-height: 84px;
  }
  /* Text-only fallback (no logo file yet) — centre the name so the cell stays balanced. */
  .sat__card--textonly { justify-content: center; text-align: center; }

  /* Logo: fixed slot, forced to pure white so the grid stays monochrome. */
  .sat__logo-wrap { flex-shrink: 0; width: 64px; display: flex; align-items: center; justify-content: center; }
  .sat__logo {
    max-width: 100%; max-height: 30px; width: auto; height: auto; display: block;
    filter: brightness(0) invert(1); opacity: 0.92;
  }
  /* Square icon-marks read small at wordmark height — give them a bit more. */
  .sat__logo--mark { max-height: 42px; }

  .sat__org { font-size: var(--text-sm); font-weight: 600; color: var(--color-dark-text-soft); line-height: 1.3; }

  /* Yellow-outlined CTA card — final grid cell (fills on hover). */
  .sat__card--cta {
    background: transparent; border: 1.5px solid var(--color-accent);
    flex-direction: row; justify-content: center; align-items: center;
    gap: var(--space-sm); text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .sat__card--cta:hover { background: var(--color-accent); transform: translateY(-3px); }
  .sat__cta-label { font-size: var(--text-sm); font-weight: 700; color: var(--color-accent); white-space: nowrap; transition: color var(--duration-fast) var(--ease-out); }
  .sat__card--cta :global(svg) { color: var(--color-accent); transition: transform var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out); }
  .sat__card--cta:hover .sat__cta-label,
  .sat__card--cta:hover :global(svg) { color: var(--color-accent-ink); }
  .sat__card--cta:hover :global(svg) { transform: translateX(3px); }

  /* "EN VELE ANDEREN" divider */
  .sat__more { display: flex; align-items: center; gap: var(--space-md); margin-top: clamp(var(--space-lg), 3vw, var(--space-xl)); }
  .sat__more-line { flex: 1; height: 1px; background: var(--line-on-dark); }
  .sat__more-text { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-dark-text-soft); white-space: nowrap; flex-shrink: 0; }

  /* ── 8. Awards ────────────────────────────────────────────────────────── */
  .awards { list-style: none; margin: 0; padding: 0; max-width: 760px; border-top: 1px solid var(--line-on-light); }
  .award { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-lg); padding: var(--space-md) 0; border-bottom: 1px solid var(--line-on-light); }
  .award__title { font-size: var(--text-base); font-weight: 600; color: var(--color-text); }
  .award__meta { font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-secondary); white-space: nowrap; flex-shrink: 0; }

  @media (prefers-reduced-motion: reduce) {
    .shero__cta, .shero__cta :global(svg), .booking__cta, .booking__cta :global(svg) { transition: none; }
  }
</style>
