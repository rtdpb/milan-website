---
/**
 * spreker.astro — Spreker landing page (PAGE-02)
 *
 * Source: PLAN 02-02 Task 2, 02-UI-SPEC.md §/spreker (PAGE-02), D-07, D-12
 *
 * Section order (UI-SPEC §/spreker):
 *   1. Hero — eyebrow, H1, subtext, primary CTA (Boek lezing), speaking photo right column
 *   2. PressStrip — reused credibility band directly below hero
 *   3. Aanbod / Topics — SectionWrapper dark (one dark band per page), 3 Cards staggered
 *   4. Testimonial — single Oranjewoud Export Academy card (nl.testimonials.items[2], D-07)
 *   5. CTA band — Boek lezing → /contact?type=lezing
 *   6. Newsletter — reused Newsletter.astro
 *
 * SEO (D-12): unique title + description via BaseLayout → BaseHead.
 * Dark band rule: exactly ONE dark band (the aanbod section) per page.
 * Yellow rule: primary CTA button only (D-02).
 * Internal hrefs: import.meta.env.BASE_URL prefix (PATTERNS.md §BASE_URL, no href="#").
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import RevealOnScroll from '../components/ui/RevealOnScroll.astro';
import PressStrip from '../components/sections/PressStrip.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { Picture } from 'astro:assets';
import speakingSrc from '../assets/photos/milan-speaking-graph.jpg';
import { nl } from '../i18n/nl';

const { pageTitle, pageDesc, eyebrow, heading, body, aanbodHeading, aanbodEyebrow, aanbodCards, testimonialEyebrow, ctaHeading, ctaPrimary, speakingAlt } = nl.spreker;
const testimonial = nl.testimonials.items[2]; // Oranjewoud Export Academy — speaking-relevant (D-07)
---

<BaseLayout title={pageTitle} description={pageDesc}>

  <!-- 1. Hero: eyebrow, H1, subtext, primary CTA + speaking photo in right column -->
  <SectionWrapper id="spreker-hero" labelledBy="spreker-hero-heading" variant="default">
    <div class="spreker-hero">
      <div class="spreker-hero__text">
        <p class="spreker-hero__eyebrow">{eyebrow}</p>
        <h1 id="spreker-hero-heading" class="spreker-hero__heading">
          {heading}
        </h1>
        <div class="spreker-hero__body">
          {body.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>
        <div class="spreker-hero__ctas">
          <Button href={`${import.meta.env.BASE_URL}contact?type=lezing`} variant="primary">
            {ctaPrimary}
          </Button>
        </div>
      </div>

      <!-- Speaking photo: right column on tablet+ (UI-SPEC §/spreker hero) -->
      <div class="spreker-hero__photo">
        <Picture
          src={speakingSrc}
          formats={['avif', 'webp']}
          widths={[400, 600, 800]}
          sizes="(max-width: 768px) 90vw, (max-width: 1200px) 45vw, 520px"
          loading="eager"
          fetchpriority="high"
          alt={speakingAlt}
          class="spreker-hero__img"
        />
      </div>
    </div>
  </SectionWrapper>

  <!-- 2. PressStrip: credibility band directly below hero (UI-SPEC §/spreker) -->
  <PressStrip />

  <!-- 3. Aanbod / Topics: ONE dark band per page (UI-SPEC dark band rule) -->
  <SectionWrapper id="spreker-aanbod" labelledBy="spreker-aanbod-heading" variant="dark">
    <div class="spreker-aanbod">
      <p class="spreker-aanbod__eyebrow">{aanbodEyebrow}</p>
      <h2 id="spreker-aanbod-heading" class="spreker-aanbod__heading">
        {aanbodHeading}
      </h2>
      <div class="spreker-aanbod__cards">
        {aanbodCards.map((card: { title: string; description: string }, i: number) => (
          <RevealOnScroll delay={i * 80}>
            <Card variant="dark">
              <div class="spreker-card">
                <h3 class="spreker-card__title">{card.title}</h3>
                <p class="spreker-card__description">{card.description}</p>
              </div>
            </Card>
          </RevealOnScroll>
        ))}
      </div>
    </div>
  </SectionWrapper>

  <!-- 4. Testimonial: single Oranjewoud Export Academy card (D-07, verbatim attribution) -->
  <SectionWrapper id="spreker-testimonial" labelledBy="spreker-testimonial-heading" variant="default">
    <div class="spreker-testimonial">
      <p class="spreker-testimonial__eyebrow">{testimonialEyebrow}</p>
      <h2 id="spreker-testimonial-heading" class="visually-hidden">Testimonial</h2>
      <RevealOnScroll>
        <Card variant="dark">
          <div class="testimonial-card">
            <blockquote class="testimonial-card__quote">
              <p>"{testimonial.quote}"</p>
            </blockquote>
            <footer class="testimonial-card__attribution">
              <span class="testimonial-card__name">{testimonial.name}</span>
              <span class="testimonial-card__role">{testimonial.role}</span>
            </footer>
          </div>
        </Card>
      </RevealOnScroll>
    </div>
  </SectionWrapper>

  <!-- 5. CTA band: terminal conversion section -->
  <SectionWrapper id="spreker-cta" labelledBy="spreker-cta-heading" variant="surface">
    <div class="spreker-cta">
      <h2 id="spreker-cta-heading" class="spreker-cta__heading">
        {ctaHeading}
      </h2>
      <Button href={`${import.meta.env.BASE_URL}contact?type=lezing`} variant="primary">
        {ctaPrimary}
      </Button>
    </div>
  </SectionWrapper>

  <!-- 6. Newsletter: reused section (UI-SPEC §/spreker) -->
  <Newsletter />

</BaseLayout>

<style>
  /* ── Hero: split layout — text left, photo right on tablet+ ─────────── */
  .spreker-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
    padding-block: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .spreker-hero {
      grid-template-columns: 1fr 1fr;
      padding-block: var(--space-4xl);
    }
  }

  .spreker-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .spreker-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .spreker-hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .spreker-hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 540px;
  }

  .spreker-hero__body p {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .spreker-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  /* ── Hero photo ────────────────────────────────────────────────────────── */
  .spreker-hero__photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* Mobile: show below text at reduced size */
  @media (max-width: 767px) {
    .spreker-hero__photo {
      max-width: 480px;
    }
  }

  .spreker-hero__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  /* ── Aanbod section (dark band — the ONE dark band per page) ──────────── */
  .spreker-aanbod {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .spreker-aanbod__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* Yellow accent on eyebrow in dark section — D-02 rule: one per dark section */
    color: var(--color-dark-text);
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-sm);
    margin: 0;
  }

  .spreker-aanbod__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-dark-text);
    margin: 0;
    text-wrap: balance;
  }

  .spreker-aanbod__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .spreker-aanbod__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Aanbod card content ─────────────────────────────────────────────── */
  .spreker-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .spreker-card__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-dark-text);
    margin: 0;
  }

  .spreker-card__description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-dark-text);
    opacity: 0.85;
    margin: 0;
  }

  /* ── Testimonial section ──────────────────────────────────────────────── */
  .spreker-testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 640px;
  }

  .spreker-testimonial__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Testimonial card content ────────────────────────────────────────── */
  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .testimonial-card__quote {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-dark-text);
  }

  .testimonial-card__quote p {
    margin: 0;
  }

  .testimonial-card__attribution {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial-card__name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-dark-text);
  }

  .testimonial-card__role {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-dark-text);
    opacity: 0.7;
  }

  /* ── CTA band ────────────────────────────────────────────────────────── */
  .spreker-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    text-align: center;
    padding-block: var(--space-2xl);
  }

  .spreker-cta__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  /* ── Visually hidden utility ─────────────────────────────────────────── */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
