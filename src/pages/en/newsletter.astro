---
/**
 * src/pages/en/newsletter.astro — EN Newsletter page (route: /en/newsletter)
 * NL analog: src/pages/nieuwsbrief.astro (NL slug: nieuwsbrief)
 *
 * Thin EN wrapper. Astro.currentLocale resolves to 'en' for all /en/* pages.
 *
 * Four EN page-wrapper transformations (04-PATTERNS.md §EN page wrappers):
 *   1. Import paths use ../../ (one level deeper due to en/ subdirectory)
 *   2. import {getStrings} from '../../i18n/utils' + const t = getStrings(Astro.currentLocale)
 *   3. nl.nieuwsbrief.* → t.nieuwsbrief.*
 *   4. Internal CTAs use getRelativeLocaleUrl('en', <en-slug>)
 *
 * Translated slug: nlSlug="nieuwsbrief" enSlug="newsletter" — passed to BaseLayout
 * so BaseHead emits correct hreflang alternates (/nieuwsbrief ↔ /en/newsletter).
 *
 * D-02: the "written in Dutch" note appears in t.nieuwsbrief.subtext (from en.ts).
 *
 * Phase 4: I18N-02, D-02, D-06
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';
import PlaceholderBadge from '../../components/ui/PlaceholderBadge.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { getStrings } from '../../i18n/utils';
import { TODO_SUBSTACK_URL } from '../../config';
import { fetchSubstackFeed, parseFeed, type ArticleCard, type PlaceholderCard } from '../../lib/rss';
import feedSnapshot from '../../data/substack-feed.xml?raw';

// Astro.currentLocale is 'en' automatically for /en/* pages at build time.
const t = getStrings(Astro.currentLocale);

// ── Sentinel guard — decides placeholder vs live feed ───────────────────────
const IS_SENTINEL = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
const subscribeUrl = `${TODO_SUBSTACK_URL}/subscribe`;
const substackPublicationUrl = TODO_SUBSTACK_URL;

// Archive: REAL issues only — hidden until the Substack feed has posts. No
// placeholder cards (client: articles only appear once we actually have them).
// Mirrors the NL nieuwsbrief.astro path.
let archiveArticles: ArticleCard[] | PlaceholderCard[] = [];
if (!IS_SENTINEL) {
  archiveArticles = await fetchSubstackFeed(`${TODO_SUBSTACK_URL}/feed`, 10);
  // CI can't reach Substack (403 from the datacenter IP) — fall back to the
  // committed snapshot so the archive still renders (`npm run articles:pull`).
  if (archiveArticles.length === 0) archiveArticles = parseFeed(feedSnapshot, 10);
}
const hasArchive = archiveArticles.length > 0;
---

<BaseLayout title={t.nieuwsbrief.pageTitle} description={t.nieuwsbrief.pageDesc} nlSlug="nieuwsbrief" enSlug="newsletter">

  <!-- 1. Hero: typographic hero, no photo (light editorial) -->
  <SectionWrapper id="nieuwsbrief-hero" labelledBy="nieuwsbrief-hero-heading" variant="default">
    <div class="nieuwsbrief-hero">
      <p class="nieuwsbrief-hero__eyebrow">{t.nieuwsbrief.eyebrow}</p>
      <h1 id="nieuwsbrief-hero-heading" class="nieuwsbrief-hero__heading">
        {t.nieuwsbrief.heading}
      </h1>
      <!-- D-02: subtext contains "Written in Dutch" (from en.ts nieuwsbrief.subtext) -->
      <p class="nieuwsbrief-hero__subtext">{t.nieuwsbrief.subtext}</p>
      <div class="nieuwsbrief-hero__ctas">
        <Button
          href={IS_SENTINEL ? undefined : subscribeUrl}
          variant="primary"
          disabled={IS_SENTINEL}
          {...(!IS_SENTINEL && { external: true })}
        >
          {t.nieuwsbrief.cta}
        </Button>
      </div>
    </div>
  </SectionWrapper>

  <!-- 2. Value-prop: lightweight 3-tile row -->
  <SectionWrapper id="nieuwsbrief-waarde" labelledBy="nieuwsbrief-waarde-heading" variant="surface">
    <div class="nieuwsbrief-waarde">
      <h2 id="nieuwsbrief-waarde-heading" class="visually-hidden">What you get</h2>
      <div class="nieuwsbrief-waarde__tiles">
        {t.nieuwsbrief.valueProps.map((prop: { label: string; description: string }) => (
          <div class="nieuwsbrief-waarde__tile">
            <p class="nieuwsbrief-waarde__tile-label">{prop.label}</p>
            <p class="nieuwsbrief-waarde__tile-desc">{prop.description}</p>
          </div>
        ))}
      </div>
    </div>
  </SectionWrapper>

  <!-- 3. Signup: reuse Newsletter.astro as-is (EN text via Astro.currentLocale) -->
  <Newsletter />

  <!-- 4. Archive: recent issues grid (up to 10 items) — only when the feed has real posts -->
  {hasArchive && (
  <SectionWrapper id="nieuwsbrief-archief" labelledBy="nieuwsbrief-archief-heading" variant="default">
    <div class="nieuwsbrief-archief">

      <h2 id="nieuwsbrief-archief-heading" class="nieuwsbrief-archief__heading">
        {t.nieuwsbrief.archiveHeading}
      </h2>

      <!-- Article cards grid — same 1→2→3 responsive layout as NL page -->
      <div class="nieuwsbrief-archief__grid" role="list">

        {archiveArticles.map((article, i) => (
          <div class="nieuwsbrief-archief__card-wrapper" role="listitem">
            <RevealOnScroll delay={i * 80}>
              <Card class="nieuwsbrief-archief__card">

                <!-- Placeholder badge — only when isPlaceholder (D-04, D-06) -->
                {article.isPlaceholder && (
                  <div class="nieuwsbrief-archief__badge-row">
                    <PlaceholderBadge />
                  </div>
                )}

                <!-- Category eyebrow -->
                <p class="nieuwsbrief-archief__category">
                  {article.category}
                </p>

                <!-- Article title -->
                <h3 class="nieuwsbrief-archief__title">
                  {article.title}
                </h3>

                <!-- Excerpt -->
                <p class="nieuwsbrief-archief__excerpt">
                  {article.excerpt}
                </p>

                <!-- Meta row: date + read time -->
                <div class="nieuwsbrief-archief__meta">
                  <span class="nieuwsbrief-archief__date">{article.date}</span>
                  <span class="nieuwsbrief-archief__separator" aria-hidden="true">·</span>
                  <span class="nieuwsbrief-archief__read-time">{article.readTime}</span>
                </div>

                <!-- "Read more" — disabled when placeholder, real link when live -->
                {article.isPlaceholder ? (
                  <span
                    class="nieuwsbrief-archief__read-more"
                    role="link"
                    aria-disabled="true"
                    tabindex="-1"
                    title={t.common.disabledTooltip}
                    aria-label={`Read "${article.title}" — ${t.common.disabledTooltip}`}
                  >
                    {t.common.readMore}
                  </span>
                ) : (
                  <a
                    href={(article as ArticleCard).href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="nieuwsbrief-archief__read-more nieuwsbrief-archief__read-more--enabled"
                    aria-label={`Read "${article.title}" on Substack`}
                  >
                    {t.common.readMore}
                  </a>
                )}

              </Card>
            </RevealOnScroll>
          </div>
        ))}

      </div>
      <!-- End article cards grid -->

      <!-- "All articles" — disabled when IS_SENTINEL, external anchor when live -->
      <div class="nieuwsbrief-archief__see-all-row">
        {IS_SENTINEL ? (
          <span
            class="nieuwsbrief-archief__see-all"
            role="link"
            aria-disabled="true"
            tabindex="-1"
            title={t.common.disabledTooltip}
          >
            {t.articles.seeAll}
            <span class="nieuwsbrief-archief__see-all-arrow" aria-hidden="true">→</span>
          </span>
        ) : (
          <a
            href={substackPublicationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="nieuwsbrief-archief__see-all nieuwsbrief-archief__see-all--enabled"
          >
            {t.articles.seeAll}
            <span class="nieuwsbrief-archief__see-all-arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>

    </div>
  </SectionWrapper>
  )}

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .nieuwsbrief-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 720px;
    padding-block: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .nieuwsbrief-hero {
      padding-block: var(--space-4xl);
    }
  }

  .nieuwsbrief-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .nieuwsbrief-hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .nieuwsbrief-hero__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 640px;
    margin: 0;
  }

  .nieuwsbrief-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  /* ── Value-prop tiles ─────────────────────────────────────────────────── */
  .nieuwsbrief-waarde {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .nieuwsbrief-waarde__tiles {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .nieuwsbrief-waarde__tiles {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2xl);
    }
  }

  .nieuwsbrief-waarde__tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
    min-width: 200px;
  }

  .nieuwsbrief-waarde__tile-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .nieuwsbrief-waarde__tile-desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Archive section ──────────────────────────────────────────────────── */
  .nieuwsbrief-archief {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .nieuwsbrief-archief__heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .nieuwsbrief-archief__heading {
      font-size: var(--text-3xl);
    }
  }

  /* ── Cards grid: 1 col mobile → 2 col tablet → 3 col desktop ── */
  .nieuwsbrief-archief__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) {
    .nieuwsbrief-archief__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .nieuwsbrief-archief__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }

  .nieuwsbrief-archief__card-wrapper {
    height: 100%;
  }

  /* Card inner layout via :global */
  :global(.nieuwsbrief-archief__card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
    position: relative;
  }

  /* ── Placeholder badge row ────────────────────────────────────────────── */
  .nieuwsbrief-archief__badge-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: calc(-1 * var(--space-xs));
  }

  /* ── Category eyebrow ────────────────────────────────────────────────── */
  .nieuwsbrief-archief__category {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Article title ────────────────────────────────────────────────────── */
  .nieuwsbrief-archief__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  /* ── Excerpt ─────────────────────────────────────────────────────────── */
  .nieuwsbrief-archief__excerpt {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1;
  }

  /* ── Meta row ─────────────────────────────────────────────────────────── */
  .nieuwsbrief-archief__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .nieuwsbrief-archief__separator {
    opacity: 0.5;
  }

  /* ── "Read more" — base styles ────────────────────────────────────────── */
  .nieuwsbrief-archief__read-more {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    min-height: 44px;
    align-self: flex-start;
    padding-block: var(--space-sm);
    opacity: 0.5;
    cursor: not-allowed;
  }

  .nieuwsbrief-archief__read-more--enabled {
    opacity: 1;
    cursor: pointer;
  }

  .nieuwsbrief-archief__read-more--enabled:hover {
    text-decoration: underline;
  }

  .nieuwsbrief-archief__read-more--enabled:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── "All articles" row ────────────────────────────────────────────── */
  .nieuwsbrief-archief__see-all-row {
    display: flex;
    justify-content: center;
    padding-top: var(--space-md);
  }

  .nieuwsbrief-archief__see-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    min-height: 44px;
    padding-block: var(--space-sm);
    opacity: 0.5;
    cursor: not-allowed;
  }

  .nieuwsbrief-archief__see-all--enabled {
    opacity: 1;
    cursor: pointer;
  }

  .nieuwsbrief-archief__see-all--enabled:hover .nieuwsbrief-archief__see-all-arrow {
    transform: translateX(4px);
  }

  .nieuwsbrief-archief__see-all--enabled:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nieuwsbrief-archief__see-all-arrow {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  /* ── Visually hidden utility ─────────────────────────────────────────── */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
