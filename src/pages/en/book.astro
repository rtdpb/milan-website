---
/**
 * src/pages/en/book.astro — Book / Pre-order page — EN (BOOK-01, Phase 5)
 *
 * Thin EN wrapper mirroring src/pages/boek.astro's component tree.
 * Astro.currentLocale resolves to 'en' automatically for all /en/* pages.
 *
 * Four EN page-wrapper transformations (04-PATTERNS.md §EN page wrappers):
 *   1. Import paths use ../../ (one level deeper due to en/ subdirectory)
 *   2. import { getStrings } from '../../i18n/utils' + const t = getStrings(Astro.currentLocale)
 *   3. t.boek.* keys used (same namespace, EN copy from en.ts)
 *   4. Internal CTAs use getRelativeLocaleUrl('en', <slug>) — never manual concatenation
 *
 * Explicit nlSlug="boek" + enSlug="book" passed to BaseLayout for hreflang
 * (EN slug 'book' differs from NL slug 'boek' — same pattern as spreker/speaking pair)
 *
 * Source: PLAN 05-01 Task 3, 05-PATTERNS.md §en/book.astro, 05-UI-SPEC.md §1
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import Button from '../../components/ui/Button.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import BookInterestForm from '../../components/forms/BookInterestForm.astro';
import { getStrings } from '../../i18n/utils';
import { TODO_BOOK_CHECKOUT_URL, TODO_SUBSTACK_URL } from '../../config';

// Astro.currentLocale is 'en' automatically for /en/* pages at build time.
const t = getStrings(Astro.currentLocale);
const IS_CHECKOUT_SENTINEL = TODO_BOOK_CHECKOUT_URL === 'TODO_BOOK_CHECKOUT_URL';
const IS_SUBSTACK_SENTINEL  = TODO_SUBSTACK_URL === 'TODO_SUBSTACK_URL';
const subscribeUrl = `${TODO_SUBSTACK_URL}/subscribe`;
---

<BaseLayout
  title={t.boek.pageTitle}
  description={t.boek.pageDesc}
  nlSlug="boek"
  enSlug="book"
>

  <!-- 1. Hero: eyebrow + H1 + body paragraphs + Substack CTA primary -->
  <SectionWrapper id="boek-hero" labelledBy="boek-hero-heading" variant="default">
    <div class="boek-hero">
      <p class="boek-hero__eyebrow">{t.boek.eyebrow}</p>
      <h1 id="boek-hero-heading" class="boek-hero__heading">
        {t.boek.heading}
      </h1>
      <div class="boek-hero__body">
        {t.boek.body.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <p class="boek-hero__subtext">{t.boek.subtext}</p>
      <div class="boek-hero__ctas">
        <!-- IS_SUBSTACK_SENTINEL: disabled span when Substack URL not yet configured (UI-SPEC §2a, HOME-10) -->
        {IS_SUBSTACK_SENTINEL ? (
          <span
            id="boek-hero-cta"
            class="btn btn--primary btn--disabled"
            role="button"
            aria-disabled="true"
            tabindex="-1"
            title={t.common.disabledTooltip}
          >
            {t.boek.ctaSubstack}
          </span>
        ) : (
          <a
            id="boek-hero-cta"
            href={subscribeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
          >
            {t.boek.ctaSubstack}
          </a>
        )}
        <!-- Checkout seam (D-03): OMIT block entirely while TODO_BOOK_CHECKOUT_URL unreplaced -->
        {!IS_CHECKOUT_SENTINEL && (
          <Button href={TODO_BOOK_CHECKOUT_URL} variant="ghost" external>
            {t.boek.checkoutCta}
          </Button>
        )}
      </div>
    </div>
  </SectionWrapper>

  <!-- 2. Dark teaser band: one per page (UI-SPEC §1 dark band rule, no purchase button here) -->
  <SectionWrapper id="boek-teaser" labelledBy="boek-teaser-heading" variant="dark">
    <div class="boek-teaser">
      <p class="boek-teaser__eyebrow">{t.boek.eyebrow}</p>
      <h2 id="boek-teaser-heading" class="boek-teaser__heading">
        {t.boek.heading}
      </h2>
      <p class="boek-teaser__body">{t.boek.body[0]}</p>
    </div>
  </SectionWrapper>

  <!-- 3. Interest capture: Substack redirect + "or" separator + BookInterestForm -->
  <SectionWrapper id="boek-capture" labelledBy="boek-capture-heading" variant="default">
    <div class="boek-capture">
      <h2 id="boek-capture-heading" class="boek-capture__heading">{t.boek.formHeading}</h2>
      <p class="boek-capture__subtext">{t.boek.subtext}</p>

      <!-- Primary Substack affordance (IS_SENTINEL guard) -->
      <div class="boek-capture__primary">
        {IS_SUBSTACK_SENTINEL ? (
          <span
            class="btn btn--primary btn--disabled"
            role="button"
            aria-disabled="true"
            tabindex="-1"
            title={t.common.disabledTooltip}
          >
            {t.boek.ctaSubstack}
          </span>
        ) : (
          <a
            href={subscribeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
          >
            {t.boek.ctaSubstack}
          </a>
        )}
      </div>

      <!-- "or" separator between primary Substack affordance and secondary form -->
      <p class="boek-capture__separator" aria-hidden="true">{t.boek.orSeparator}</p>

      <!-- Secondary: Web3Forms BookInterestForm (2-field, 7-state, XSS-safe) -->
      <BookInterestForm />
    </div>
  </SectionWrapper>

  <!-- Newsletter section reused at the bottom -->
  <Newsletter />

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .boek-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 720px;
    padding-block: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .boek-hero {
      padding-block: var(--space-4xl);
    }
  }

  .boek-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* H1: --text-5xl fluid clamp reflows at 320px viewport (backstop requirement) */
  .boek-hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 300;
    line-height: 1.1;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .boek-hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 640px;
  }

  .boek-hero__body p {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .boek-hero__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 560px;
  }

  .boek-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  /* ── Dark teaser band ────────────────────────────────────────────────── */
  .boek-teaser {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 720px;
  }

  .boek-teaser__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dark-text);
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-sm);
    margin: 0;
  }

  .boek-teaser__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-dark-text);
    text-wrap: balance;
    margin: 0;
  }

  .boek-teaser__body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-dark-text);
    opacity: 0.85;
    margin: 0;
    max-width: 640px;
  }

  /* ── Interest capture section ────────────────────────────────────────── */
  .boek-capture {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 640px;
    padding-block: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .boek-capture {
      padding-block: var(--space-3xl);
    }
  }

  .boek-capture__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .boek-capture__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .boek-capture__primary {
    display: flex;
    align-items: flex-start;
  }

  .boek-capture__separator {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-secondary);
    margin: 0;
    letter-spacing: 0.02em;
  }
</style>
