---
/**
 * src/pages/en/contact.astro — EN Contact page (route: /en/contact)
 * NL analog: src/pages/contact.astro (NL slug: contact)
 *
 * Thin EN wrapper. Astro.currentLocale resolves to 'en' for all /en/* pages.
 *
 * Four EN page-wrapper transformations (04-PATTERNS.md §EN page wrappers):
 *   1. Import paths use ../../ (one level deeper due to en/ subdirectory)
 *   2. import {getStrings} from '../../i18n/utils' + const t = getStrings(Astro.currentLocale)
 *   3. nl.contact.* → t.contact.* (inside ContactForm via getStrings(Astro.currentLocale))
 *   4. No internal CTA hrefs on this page — no slug translation needed
 *
 * No nlSlug/enSlug override needed — 'contact' is the same in both locales.
 *
 * SECURITY NOTE (T-2-02, T-2-04, T-2-05):
 * The Web3Forms action URL, honeypot, and ?type= option VALUES in ContactForm.astro
 * are byte-for-byte unchanged. Only the label strings change via getStrings('en').
 * No new input surface is introduced by this EN wrapper.
 *
 * Phase 4: I18N-02, D (honesty — Web3Forms routing unchanged)
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { getStrings } from '../../i18n/utils';

// Astro.currentLocale is 'en' automatically for /en/* pages at build time.
const t = getStrings(Astro.currentLocale);
const { pageTitle, pageDesc, heading, subtext } = t.contact;
---

<BaseLayout title={pageTitle} description={pageDesc}>

  <!-- Header + form in one aligned 640px column, tight gap between them -->
  <!-- ContactForm reads getStrings(Astro.currentLocale) = 'en' automatically -->
  <SectionWrapper id="contact-form-section" labelledBy="contact-heading" variant="default">
    <div class="contact-col">
      <div class="contact-header">
        <h1 id="contact-heading" class="contact-header__heading">
          {heading}
        </h1>
        <p class="contact-header__subtext">
          {subtext}
        </p>
      </div>
      <ContactForm />
    </div>
  </SectionWrapper>

  <!-- Newsletter: reused at bottom (UI-SPEC §/contact) -->
  <Newsletter />

</BaseLayout>

<style>
  /* ── Aligned column: header + form share one 640px left-aligned column,
        with a tightened gap between the heading block and the form. ──────── */
  .contact-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 640px;
  }

  /* ── Page header ──────────────────────────────────────────────────────── */
  .contact-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-header__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);   /* display size, same as homepage H1 */
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .contact-header__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);  /* 16–18px */
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

</style>
