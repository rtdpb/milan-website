---
/**
 * src/pages/en/coaching.astro — EN Coaching page (route: /en/coaching)
 *
 * Thin EN wrapper mirroring src/pages/coaching.astro's component tree.
 * Astro.currentLocale resolves to 'en' automatically for all /en/* pages.
 * All section components call getStrings('en') internally via Astro.currentLocale —
 * no prop-drilling required (RESEARCH §Pattern 2, §Pattern 3).
 *
 * Four EN page-wrapper transformations (04-PATTERNS.md §EN page wrappers):
 *   1. Import paths use ../../ (one level deeper due to en/ subdirectory)
 *   2. import {getStrings} from '../../i18n/utils' + const t = getStrings(Astro.currentLocale)
 *   3. nl.coaching.* → t.coaching.*
 *   4. Internal CTAs use getRelativeLocaleUrl('en', <en-slug>) — never manual concatenation
 *
 * No nlSlug/enSlug override needed — 'coaching' is the same in both locales.
 *
 * Phase 4: I18N-02
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import RevealOnScroll from '../../components/ui/RevealOnScroll.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { Picture } from 'astro:assets';
import networkingSrc from '../../assets/photos/milan-networking.jpg';
import { getStrings } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Astro.currentLocale is 'en' automatically for /en/* pages at build time.
const t = getStrings(Astro.currentLocale);
const { pageTitle, pageDesc, eyebrow, heading, body, offerHeading, offerEyebrow, offerCards, testimonialEyebrow, ctaHeading, ctaPrimary, ctaSecondary, networkingAlt } = t.coaching;
const testimonial = t.testimonials.items[0]; // Yang Soo Kloosterhof — coaching-relevant (D-07)
---

<BaseLayout title={pageTitle} description={pageDesc}>

  <!-- 1. Hero: typographic hero, no hero photo (UI-SPEC §/coaching: typographic hero) -->
  <SectionWrapper id="coaching-hero" labelledBy="coaching-hero-heading" variant="default">
    <div class="coaching-hero">
      <p class="coaching-hero__eyebrow">{eyebrow}</p>
      <h1 id="coaching-hero-heading" class="coaching-hero__heading">
        {heading}
      </h1>
      <div class="coaching-hero__body">
        {body.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="coaching-hero__ctas">
        <Button href={getRelativeLocaleUrl('en', 'contact') + '?type=coaching'} variant="primary">
          {ctaPrimary}
        </Button>
        <Button href={getRelativeLocaleUrl('en', 'about')} variant="ghost">
          {ctaSecondary}
        </Button>
      </div>
    </div>
  </SectionWrapper>

  <!-- 2. Offer / Approach: ONE dark band for this page (UI-SPEC dark band rule) -->
  <SectionWrapper id="coaching-offer" labelledBy="coaching-offer-heading" variant="dark">
    <div class="coaching-offer">
      <p class="coaching-offer__eyebrow">{offerEyebrow}</p>
      <h2 id="coaching-offer-heading" class="coaching-offer__heading">
        {offerHeading}
      </h2>
      <div class="coaching-offer__cards">
        {offerCards.map((card: { title: string; description: string }, i: number) => (
          <RevealOnScroll delay={i * 80}>
            <Card variant="dark">
              <div class="coaching-card">
                <h3 class="coaching-card__title">{card.title}</h3>
                <p class="coaching-card__description">{card.description}</p>
              </div>
            </Card>
          </RevealOnScroll>
        ))}
      </div>

      <!-- Supporting photo: networking context image (UI-SPEC §Image Pipeline) -->
      <RevealOnScroll delay={240}>
        <div class="coaching-offer__photo">
          <Picture
            src={networkingSrc}
            formats={['avif', 'webp']}
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1200px) 40vw, 420px"
            loading="lazy"
            alt={networkingAlt}
            class="coaching-offer__img"
          />
        </div>
      </RevealOnScroll>
    </div>
  </SectionWrapper>

  <!-- 3. Testimonial: single Yang Soo Kloosterhof card (D-07, verbatim attribution) -->
  <SectionWrapper id="coaching-testimonial" labelledBy="coaching-testimonial-heading" variant="default">
    <div class="coaching-testimonial">
      <p class="coaching-testimonial__eyebrow">{testimonialEyebrow}</p>
      <h2 id="coaching-testimonial-heading" class="visually-hidden">Testimonial</h2>
      <RevealOnScroll>
        <Card variant="default">
          <div class="testimonial-card">
            <blockquote class="testimonial-card__quote">
              <p>"{testimonial.quote}"</p>
            </blockquote>
            <footer class="testimonial-card__attribution">
              <span class="testimonial-card__name">{testimonial.name}</span>
              <span class="testimonial-card__role">{testimonial.role}</span>
            </footer>
          </div>
        </Card>
      </RevealOnScroll>
    </div>
  </SectionWrapper>

  <!-- 4. CTA band: terminal conversion section -->
  <SectionWrapper id="coaching-cta" labelledBy="coaching-cta-heading" variant="surface">
    <div class="coaching-cta">
      <h2 id="coaching-cta-heading" class="coaching-cta__heading">
        {ctaHeading}
      </h2>
      <div class="coaching-cta__actions">
        <Button href={getRelativeLocaleUrl('en', 'contact') + '?type=coaching'} variant="primary">
          {ctaPrimary}
        </Button>
        <Button href={getRelativeLocaleUrl('en', 'about')} variant="ghost">
          {ctaSecondary}
        </Button>
      </div>
    </div>
  </SectionWrapper>

  <!-- 5. Newsletter: reused section (UI-SPEC §/coaching) -->
  <Newsletter />

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .coaching-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 720px;
    padding-block: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .coaching-hero {
      padding-block: var(--space-4xl);
    }
  }

  .coaching-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .coaching-hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .coaching-hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 640px;
  }

  .coaching-hero__body p {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .coaching-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  /* ── Offer section (dark band) ────────────────────────────────────────── */
  .coaching-offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .coaching-offer__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* Yellow accent on eyebrow in dark section — D-02 rule: one per dark section */
    color: var(--color-dark-text);
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-sm);
    margin: 0;
  }

  .coaching-offer__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-dark-text);
    margin: 0;
    text-wrap: balance;
  }

  .coaching-offer__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .coaching-offer__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Offer card content ─────────────────────────────────────────────── */
  .coaching-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .coaching-card__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-dark-text);
    margin: 0;
  }

  .coaching-card__description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-dark-text);
    opacity: 0.85;
    margin: 0;
  }

  /* ── Photo (supporting context) ──────────────────────────────────────── */
  .coaching-offer__photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 480px;
  }

  .coaching-offer__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  /* ── Testimonial section ──────────────────────────────────────────────── */
  .coaching-testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 640px;
  }

  .coaching-testimonial__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Testimonial card content ────────────────────────────────────────── */
  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .testimonial-card__quote {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text);
  }

  .testimonial-card__quote p {
    margin: 0;
  }

  .testimonial-card__attribution {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial-card__name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .testimonial-card__role {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  /* ── CTA band ────────────────────────────────────────────────────────── */
  .coaching-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    text-align: center;
    padding-block: var(--space-2xl);
  }

  .coaching-cta__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .coaching-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    justify-content: center;
  }

  /* ── Visually hidden utility ─────────────────────────────────────────── */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
