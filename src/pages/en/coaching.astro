---
/**
 * src/pages/en/coaching.astro — EN Coaching page (route: /en/coaching)
 * Mirrors src/pages/coaching.astro with EN strings + locale-aware hrefs.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import Button from '../../components/ui/Button.astro';
import PressStrip from '../../components/sections/PressStrip.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { Picture } from 'astro:assets';
import heroSrc from '../../assets/photos/milan-story-portrait.jpg';
import { getStrings } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { INTRO_CALL_URL } from '../../config';

const t = getStrings(Astro.currentLocale);
const c = t.coaching;
const contactCoaching = getRelativeLocaleUrl('en', 'contact') + '?type=coaching';
const verhaalHref = getRelativeLocaleUrl('en', 'about');

const pkgHref = [INTRO_CALL_URL, contactCoaching];
const pkgExternal = [true, false];

const arrow = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<BaseLayout title={c.pageTitle} description={c.pageDesc}>

  <header class="chero">
    <div class="chero__inner">
      <div class="chero__text">
        <p class="chero__eyebrow">{c.eyebrow}</p>
        <h1 class="chero__title">{c.heroTitle}</h1>
      </div>
      <figure class="chero__figure">
        <Picture
          src={heroSrc}
          formats={['avif', 'webp']}
          widths={[400, 600, 900, 1200]}
          sizes="(max-width: 820px) 92vw, 42vw"
          alt={c.heroImageAlt}
          priority
          class="chero__img"
        />
      </figure>
    </div>
  </header>

  <PressStrip />

  <SectionWrapper id="coaching-intro" variant="default">
    <div class="cintro" data-anim>
      {c.intro.map((p: string) => <p>{p}</p>)}
    </div>
  </SectionWrapper>

  <SectionWrapper id="coaching-packages" variant="surface" labelledBy="coaching-packages-heading">
    <h2 id="coaching-packages-heading" class="sec-heading" data-anim>{c.packagesHeading}</h2>
    <div class="pkgs">
      {c.packages.map((pkg, i: number) => (
        <article class={`pkg${i === 1 ? ' pkg--feature' : ''}`} data-anim data-anim-variant="scale" style={`--i: ${i}`}>
          <h3 class="pkg__name">{pkg.name}</h3>
          <p class="pkg__price">{pkg.price ?? c.priceOnRequest}</p>
          <p class="pkg__desc">{pkg.desc}</p>
          <ul class="pkg__features">
            {pkg.features.map((f: string) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a
            class={`pkg__cta${i === 1 ? ' pkg__cta--primary' : ''}`}
            href={pkgHref[i]}
            {...(pkgExternal[i] ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {pkg.cta}<Fragment set:html={arrow} />
          </a>
        </article>
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="coaching-reviews" variant="default" labelledBy="coaching-reviews-heading">
    <h2 id="coaching-reviews-heading" class="sec-heading" data-anim>{c.reviewsHeading}</h2>
    <div class="reviews">
      {c.reviews.map((r, i: number) => (
        <figure class="review" data-anim style={`--i: ${i}`}>
          <blockquote class="review__quote">{r.quote}</blockquote>
          <figcaption class="review__by">
            <span class="review__name">{r.name}</span>
            {r.role && <span class="review__role">{r.role}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="coaching-traject" variant="dark" labelledBy="coaching-traject-heading">
    <h2 id="coaching-traject-heading" class="sec-heading sec-heading--light" data-anim>{c.trajectHeading}</h2>
    <ol class="traject">
      {c.trajectSteps.map((s, i: number) => (
        <li class="traject__step" data-anim style={`--i: ${i}`}>
          <span class="traject__label">{s.label}</span>
          <h3 class="traject__title">{s.title}</h3>
          <p class="traject__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </SectionWrapper>

  <SectionWrapper id="coaching-faq" variant="default" labelledBy="coaching-faq-heading">
    <h2 id="coaching-faq-heading" class="sec-heading" data-anim>{c.faqHeading}</h2>
    <div class="faq" data-anim>
      {c.faq.map((item) => (
        <details class="faq__item">
          <summary class="faq__q">
            {item.q}
            <svg class="faq__chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="faq__a">{item.a}</p>
        </details>
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="coaching-cta" variant="surface" labelledBy="coaching-cta-heading">
    <div class="ccta">
      <h2 id="coaching-cta-heading" class="ccta__heading">{c.ctaHeading}</h2>
      <div class="ccta__actions">
        <Button href={contactCoaching} variant="primary">{c.ctaPrimary}</Button>
        <Button href={verhaalHref} variant="ghost">{c.ctaSecondary}</Button>
      </div>
    </div>
  </SectionWrapper>

  <Newsletter />

</BaseLayout>

<style>
  .sec-heading { font-size: var(--text-3xl); line-height: 1.08; margin: 0 0 clamp(var(--space-lg), 3vw, var(--space-2xl)); color: var(--color-text); }
  .sec-heading--light { color: var(--color-dark-text); }

  .chero { background: var(--color-bg); }
  .chero__inner { max-width: var(--max-width); margin-inline: auto; padding: var(--gutter); padding-block: clamp(var(--space-xl), 4vw, var(--space-3xl)); display: grid; grid-template-columns: 1fr; gap: clamp(var(--space-xl), 4vw, var(--space-2xl)); align-items: center; }
  @media (min-width: 820px) { .chero__inner { grid-template-columns: 1.1fr 0.9fr; } }
  .chero__text { display: flex; flex-direction: column; gap: var(--space-md); }
  .chero__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .chero__title { font-size: clamp(2.5rem, 1.2rem + 4vw, 4.25rem); line-height: 1.02; letter-spacing: -0.03em; font-weight: 730; color: var(--color-text); margin: 0; max-width: 15ch; text-wrap: balance; }
  .chero__figure { margin: 0; border-radius: var(--radius-card); overflow: hidden; background: var(--color-surface); aspect-ratio: 4 / 5; max-height: min(64vh, 580px); justify-self: end; width: 100%; }
  .chero__img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block; }

  .cintro { display: flex; flex-direction: column; gap: var(--space-lg); max-width: 68ch; }
  .cintro p { font-size: var(--text-lg); line-height: 1.6; color: var(--color-text-secondary); margin: 0; }
  .cintro p:first-child { color: var(--color-text); font-weight: 500; }

  .pkgs { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); align-items: start; }
  @media (min-width: 820px) { .pkgs { grid-template-columns: 1fr 1fr; } }
  .pkg { display: flex; flex-direction: column; gap: var(--space-md); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: clamp(var(--space-lg), 3vw, var(--space-2xl)); height: 100%; }
  .pkg--feature { background: var(--color-ink); border-color: transparent; }
  .pkg__name { font-size: var(--text-xl); margin: 0; color: var(--color-text); }
  .pkg--feature .pkg__name { color: var(--color-dark-text); }
  .pkg__price { font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .pkg--feature .pkg__price { color: var(--color-accent); }
  .pkg__desc { font-size: var(--text-base); line-height: 1.6; color: var(--color-text-secondary); margin: 0; }
  .pkg--feature .pkg__desc { color: var(--color-dark-text-soft); }
  .pkg__features { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-sm); }
  .pkg__features li { display: flex; align-items: flex-start; gap: var(--space-sm); font-size: var(--text-base); color: var(--color-text); }
  .pkg--feature .pkg__features li { color: var(--color-dark-text); }
  .pkg__features svg { color: var(--color-accent); flex-shrink: 0; margin-top: 3px; }
  .pkg__cta { display: inline-flex; align-items: center; gap: var(--space-sm); align-self: flex-start; margin-top: auto; height: 52px; padding-inline: var(--space-lg); border-radius: var(--radius-pill); font-size: var(--text-sm); font-weight: 700; text-decoration: none; border: 1px solid var(--line-on-light-strong); color: var(--color-text); background: transparent; transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out); }
  .pkg__cta:hover { transform: translateY(-2px); border-color: var(--color-text); }
  .pkg--feature .pkg__cta { color: var(--color-ink); border-color: transparent; }
  .pkg__cta--primary { background: var(--color-accent); color: var(--color-accent-ink) !important; border-color: transparent; }
  .pkg__cta--primary:hover { background: var(--color-accent-dark); }
  .pkg__cta :global(svg) { transition: transform var(--duration-fast) var(--ease-out); }
  .pkg__cta:hover :global(svg) { transform: translateX(3px); }

  .reviews { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  @media (min-width: 820px) { .reviews { grid-template-columns: 1fr 1fr; } }
  .review { margin: 0; display: flex; flex-direction: column; gap: var(--space-md); background: var(--color-surface); border-radius: var(--radius-card); padding: clamp(var(--space-lg), 2.5vw, var(--space-xl)); }
  .review__quote { margin: 0; font-size: var(--text-base); line-height: 1.6; color: var(--color-text); }
  .review__by { display: flex; flex-direction: column; gap: 2px; }
  .review__name { font-size: var(--text-sm); font-weight: 700; color: var(--color-text); }
  .review__role { font-size: var(--text-xs); color: var(--color-text-secondary); }

  .traject { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  @media (min-width: 820px) { .traject { grid-template-columns: repeat(3, 1fr); gap: var(--space-xl); } }
  .traject__step { display: flex; flex-direction: column; gap: var(--space-sm); padding-top: var(--space-md); border-top: 2px solid var(--line-on-dark-strong); }
  .traject__label { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent); }
  .traject__title { font-size: var(--text-xl); margin: 0; color: var(--color-dark-text); }
  .traject__text { font-size: var(--text-base); line-height: 1.6; color: var(--color-dark-text-soft); margin: 0; }

  .faq { max-width: 800px; border-top: 1px solid var(--line-on-light); }
  .faq__item { border-bottom: 1px solid var(--line-on-light); }
  .faq__q { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); cursor: pointer; list-style: none; padding: var(--space-lg) 0; font-size: var(--text-lg); font-weight: 600; color: var(--color-text); }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__chev { flex-shrink: 0; transition: transform var(--duration-fast) var(--ease-out); }
  .faq__item[open] .faq__chev { transform: rotate(180deg); }
  .faq__a { margin: 0 0 var(--space-lg); font-size: var(--text-base); line-height: 1.65; color: var(--color-text-secondary); max-width: 68ch; }

  .ccta { display: flex; flex-direction: column; align-items: center; gap: var(--space-xl); text-align: center; }
  .ccta__heading { font-size: var(--text-3xl); line-height: 1.1; margin: 0; color: var(--color-text); text-wrap: balance; }
  .ccta__actions { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; }

  @media (prefers-reduced-motion: reduce) {
    .pkg__cta, .pkg__cta :global(svg), .faq__chev { transition: none; }
  }
</style>
