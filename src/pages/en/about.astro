---
/**
 * src/pages/en/about.astro — EN "My Story" page (route: /en/about)
 * NL analog: src/pages/mijn-verhaal.astro (NL slug: mijn-verhaal)
 *
 * Thin EN wrapper. Astro.currentLocale resolves to 'en' for all /en/* pages.
 *
 * Four EN page-wrapper transformations (04-PATTERNS.md §EN page wrappers):
 *   1. Import paths use ../../ (one level deeper due to en/ subdirectory)
 *   2. import {getStrings} from '../../i18n/utils' + const t = getStrings(Astro.currentLocale)
 *   3. nl.mijnVerhaal.* → t.mijnVerhaal.*
 *   4. Internal CTAs use getRelativeLocaleUrl('en', <en-slug>)
 *
 * Translated slug: nlSlug="mijn-verhaal" enSlug="about" — passed to BaseLayout
 * so BaseHead emits correct hreflang alternates (/mijn-verhaal ↔ /en/about).
 *
 * Story.astro isMijnVerhaalPage guard already extended to match /about (Plan 01 deviation).
 *
 * Phase 4: I18N-02, D-06
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Story from '../../components/sections/Story.astro';
import Timeline from '../../components/sections/Timeline.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import Button from '../../components/ui/Button.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { getStrings } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Astro.currentLocale is 'en' automatically for /en/* pages at build time.
const t = getStrings(Astro.currentLocale);
const mv = t.mijnVerhaal;
---

<BaseLayout
  title={mv.pageTitle}
  description={mv.pageDesc}
  nlSlug="mijn-verhaal"
  enSlug="about"
>

  <!--
    Opening dark band — the Story.astro component reused wholesale.
    id="verhaal" is the in-page anchor. On this page it becomes the page-top band.
    The teaser link inside Story.astro is conditionally hidden on this page
    (Story.astro guard extended to match /about in Plan 01).
  -->
  <Story />

  <!-- Timeline — Soly journey (moved here from the homepage). -->
  <Timeline />

  <!-- ── Arc 1: The beginning ──────────────────────────────────────────── -->
  <SectionWrapper id="verhaal-start" labelledBy="verhaal-start-heading" variant="default">
    <div class="verhaal-section">
      <p class="verhaal-eyebrow">{mv.arc1Eyebrow}</p>
      <h2 id="verhaal-start-heading" class="verhaal-heading">{mv.arc1Heading}</h2>
      <div class="prose">
        {mv.arc1Body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </SectionWrapper>

  <!-- ── Arc 2: International expansion ──────────────────────────────── -->
  <SectionWrapper id="verhaal-expansie" labelledBy="verhaal-expansie-heading" variant="surface">
    <div class="verhaal-section">
      <p class="verhaal-eyebrow">{mv.arc2Eyebrow}</p>
      <h2 id="verhaal-expansie-heading" class="verhaal-heading">{mv.arc2Heading}</h2>
      <div class="prose">
        {mv.arc2Body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </SectionWrapper>

  <!-- ── Arc 3: The bankruptcy ─────────────────────────────────────────── -->
  <SectionWrapper id="verhaal-faillissement" labelledBy="verhaal-faillissement-heading" variant="default">
    <div class="verhaal-section">
      <p class="verhaal-eyebrow">{mv.arc3Eyebrow}</p>
      <h2 id="verhaal-faillissement-heading" class="verhaal-heading">{mv.arc3Heading}</h2>
      <div class="prose">
        {mv.arc3Body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </SectionWrapper>

  <!-- ── Arc 4: Today ───────────────────────────────────────────────────── -->
  <SectionWrapper id="verhaal-vandaag" labelledBy="verhaal-vandaag-heading" variant="surface">
    <div class="verhaal-section">
      <p class="verhaal-eyebrow">{mv.arc4Eyebrow}</p>
      <h2 id="verhaal-vandaag-heading" class="verhaal-heading">{mv.arc4Heading}</h2>
      <div class="prose">
        {mv.arc4Body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </SectionWrapper>

  <!-- ── Terminal CTA: into the lead flow ──────────────────────────────── -->
  <SectionWrapper id="verhaal-cta" labelledBy="verhaal-cta-heading" variant="default">
    <div class="verhaal-cta-section">
      <p class="verhaal-eyebrow verhaal-cta-eyebrow">{mv.ctaEyebrow}</p>
      <h2 id="verhaal-cta-heading" class="verhaal-heading verhaal-cta-heading">{mv.ctaHeading}</h2>
      <div class="verhaal-cta-row">
        <!--
          Primary CTA routes into the EN contact form with type=coaching pre-selected.
          Uses getRelativeLocaleUrl so base path is handled automatically (04-PATTERNS.md).
        -->
        <Button
          href={getRelativeLocaleUrl('en', 'contact') + '?type=coaching'}
          variant="primary"
        >
          {mv.ctaPrimary}
        </Button>
        <!--
          Ghost secondary — links to the EN Speaking page.
          getRelativeLocaleUrl used for EN-internal link (04-PATTERNS.md §Internal href).
        -->
        <Button
          href={getRelativeLocaleUrl('en', 'speaking')}
          variant="secondary"
        >
          {mv.ctaSecondary}
        </Button>
      </div>
    </div>
  </SectionWrapper>

  <!-- ── Newsletter — reused bottom section ────────────────────────────── -->
  <Newsletter />

</BaseLayout>

<style>
  /* ── Shared verhaal section layout ─────────────────────────────────── */
  .verhaal-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);   /* 32px between eyebrow → heading → prose */
    max-width: 800px;       /* section container cap */
  }

  /* ── Eyebrow label ──────────────────────────────────────────────────── */
  .verhaal-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  /* ── Section heading ────────────────────────────────────────────────── */
  .verhaal-heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .verhaal-heading {
      font-size: var(--text-3xl);
    }
  }

  /* ── Prose column — reading-measure constraint (UI-SPEC §Typography) ── */
  /* max-width: 680px for all long-form narrative columns */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);   /* 24px between paragraphs */
    max-width: 680px;       /* Reading measure (UI-SPEC §Long-form prose constraint) */
  }

  .prose p {
    font-family: var(--font-body);
    font-size: var(--text-base);   /* 16–18px — body size */
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  /* ── Terminal CTA section ───────────────────────────────────────────── */
  .verhaal-cta-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 680px;
  }

  .verhaal-cta-eyebrow {
    /* Inherits .verhaal-eyebrow — no override needed */
  }

  .verhaal-cta-heading {
    /* Inherits .verhaal-heading */
  }

  .verhaal-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);   /* 16px between buttons */
    align-items: center;
  }
</style>
