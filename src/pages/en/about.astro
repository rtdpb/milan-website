---
/**
 * src/pages/en/about.astro — EN "My Story" page (route: /en/about)
 * Mirrors src/pages/mijn-verhaal.astro with EN strings.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import Story from '../../components/sections/Story.astro';
import Timeline from '../../components/sections/Timeline.astro';
import Samenwerken from '../../components/sections/Samenwerken.astro';
import { Picture } from 'astro:assets';
import heroSrc from '../../assets/photos/milan-hero-stage.jpg';
import { getStrings } from '../../i18n/utils';

const t = getStrings(Astro.currentLocale);
const mv = t.mijnVerhaal;
const awards = t.spreker.awards;
const awardsHeading = t.spreker.awardsHeading;
const extArrow = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>`;
---

<BaseLayout title={mv.pageTitle} description={mv.pageDesc} nlSlug="mijn-verhaal" enSlug="about">

  <header class="mhero">
    <Picture
      src={heroSrc}
      formats={['avif', 'webp']}
      widths={[768, 1200, 1600, 2000, 2400]}
      sizes="100vw"
      alt={mv.heroImageAlt}
      priority
      class="mhero__img"
    />
    <div class="mhero__scrim"></div>
    <div class="mhero__inner">
      <p class="mhero__eyebrow">{mv.heroEyebrow}</p>
      <h1 class="mhero__title">{mv.heroTitle}</h1>
    </div>
  </header>

  <Story />

  <SectionWrapper id="verhaal-media" variant="surface" labelledBy="verhaal-media-heading">
    <h2 id="verhaal-media-heading" class="sec-heading" data-anim>{mv.mediaHeading}</h2>
    <ul class="media" data-anim>
      {mv.media.map((m) => (
        <li>
          <a class="media__item" href={m.url} target="_blank" rel="noopener noreferrer">
            <span class="media__outlet">{m.outlet}</span>
            <span class="media__title">{m.title}</span>
            <Fragment set:html={extArrow} />
          </a>
        </li>
      ))}
    </ul>
  </SectionWrapper>

  <Timeline />

  <SectionWrapper id="verhaal-awards" variant="default" labelledBy="verhaal-awards-heading">
    <h2 id="verhaal-awards-heading" class="sec-heading" data-anim>{awardsHeading}</h2>
    <ul class="awards" data-anim>
      {awards.map((a) => (
        <li class="award">
          <span class="award__title">{a.title}</span>
          <span class="award__meta">{a.by} · {a.date}</span>
        </li>
      ))}
    </ul>
  </SectionWrapper>

  <Samenwerken />

</BaseLayout>

<style>
  .sec-heading { font-size: var(--text-3xl); line-height: 1.08; margin: 0 0 clamp(var(--space-lg), 3vw, var(--space-2xl)); color: var(--color-text); }

  .mhero { position: relative; width: 100%; min-height: clamp(420px, 66vh, 620px); display: flex; align-items: flex-end; overflow: clip; }
  .mhero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; }
  .mhero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,18,21,0.10) 0%, rgba(16,18,21,0.35) 45%, rgba(16,18,21,0.82) 100%); }
  .mhero__inner { position: relative; width: 100%; max-width: var(--max-width); margin-inline: auto; padding: var(--gutter); padding-bottom: clamp(var(--space-xl), 4vw, var(--space-3xl)); display: flex; flex-direction: column; gap: var(--space-sm); }
  .mhero__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin: 0; }
  .mhero__title { font-size: clamp(2.5rem, 1.2rem + 4.4vw, 4.5rem); line-height: 1.0; letter-spacing: -0.03em; font-weight: 730; color: var(--color-dark-text); margin: 0; max-width: 16ch; text-wrap: balance; }

  .media { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: var(--space-sm); }
  @media (min-width: 760px) { .media { grid-template-columns: 1fr 1fr; gap: var(--space-md); } }
  .media__item { display: flex; align-items: baseline; gap: var(--space-md); padding: var(--space-md) var(--space-lg); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); text-decoration: none; transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out); }
  .media__item:hover { transform: translateY(-2px); border-color: var(--line-on-light-strong); }
  .media__outlet { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-secondary); white-space: nowrap; flex-shrink: 0; min-width: 9ch; }
  .media__title { font-size: var(--text-sm); color: var(--color-text); line-height: 1.35; flex: 1; }
  .media__item :global(svg) { color: var(--color-text-secondary); flex-shrink: 0; align-self: center; transition: transform var(--duration-fast) var(--ease-out); }
  .media__item:hover :global(svg) { transform: translate(2px, -2px); }

  .awards { list-style: none; margin: 0; padding: 0; max-width: 760px; border-top: 1px solid var(--line-on-light); }
  .award { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-lg); padding: var(--space-md) 0; border-bottom: 1px solid var(--line-on-light); }
  .award__title { font-size: var(--text-base); font-weight: 600; color: var(--color-text); }
  .award__meta { font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-secondary); white-space: nowrap; flex-shrink: 0; }

  @media (prefers-reduced-motion: reduce) {
    .media__item, .media__item :global(svg) { transition: none; }
  }
</style>
