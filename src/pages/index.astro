---
/**
 * index.astro — Dutch Homepage (NL default locale, route: /)
 *
 * Full homepage assembly — Plan 01-06.
 * Section order (docx canonical order, CONTEXT.md §Section order):
 *   BaseLayout (provides Header/Nav + Footer)
 *   └─ Hero           — LCP image, H1, CTAs, USPs (Plan 01)
 *   └─ PressStrip     — "Bekend van" slim credibility band (Plan 03)
 *   └─ Samenwerken    — 3-card commitment ladder (Plan 03)
 *   └─ Testimonials   — mixed-size mosaic, 3 supplied quotes (Plan 04)
 *   └─ Story          — dark band personal story, id="verhaal" (Plan 04)
 *   └─ Newsletter     — Substack signup, honest disabled submit (Plan 05)
 *   └─ Articles       — 3 placeholder article cards (Plan 05)
 *
 * This is the NL default route — no /nl/ prefix (D-16, FND-09).
 * Phase-4 EN expansion will add prefixDefaultLocale: true; NL moves to /nl/*.
 *
 * CTA anchor: hero secondary "Mijn verhaal" targets #verhaal → Story section id.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import PressStrip from '../components/sections/PressStrip.astro';
import Samenwerken from '../components/sections/Samenwerken.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Story from '../components/sections/Story.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import Articles from '../components/sections/Articles.astro';
---

<BaseLayout
  title="Milan van der Meulen — Founder Coach & Spreker"
  description="Milan van der Meulen is een ervaren ondernemer, founder coach en spreker. Hij hielp Soly groeien naar 9 landen en 180 medewerkers. Nu helpt hij andere founders schalen zonder zichzelf te verliezen."
>
  <!--
    Hero section — LCP image, H1, CTAs ("Mijn verhaal" anchors to #verhaal), USPs.
    Above-the-fold. Eager + fetchpriority=high for LCP (FND-07, HOME-02).
  -->
  <Hero />

  <!--
    PressStrip — "Bekend van" slim credibility band (HOME-03, D-06).
    Sits directly under the hero (slim, adjacent visual).
    Logo chips are text/wordmark placeholders — swap when real assets arrive (D-11).
  -->
  <PressStrip />

  <!--
    Samenwerken — 3-card commitment ladder (HOME-04, D-07).
    Card order: Nieuwsbrief (01) → Presentatie/Lezing (02) → 1:1 Coaching (03).
    All CTAs honestly disabled (HOME-10, D-12).
  -->
  <Samenwerken />

  <!--
    Testimonials — mixed-size mosaic, 3 supplied quotes (HOME-05, D-08).
    Verbatim attributions: Yang Soo Kloosterhof, Ruud Koornstra, Oranjewoud Export Academy.
    No fabricated stats (D-08). Scroll-reveal animations (FND-08).
  -->
  <Testimonials />

  <!--
    Story — full-width dark personal story band (HOME-06, D-01).
    id="verhaal" — target of the hero secondary "Mijn verhaal" CTA (D-12).
    One yellow accent: eyebrow left-border only (D-02).
  -->
  <Story />

  <!--
    Newsletter — honest Substack signup section (HOME-07, D-09).
    naam + mailadres form; submit is disabled pending TODO_SUBSTACK_URL (Phase 3).
    No fake success state (HOME-10).
  -->
  <Newsletter />

  <!--
    Articles — 3 placeholder article cards (HOME-08, D-10).
    PlaceholderBadge visible on each card. "Alle artikelen" disabled (HOME-10).
    Real articles arrive Phase 3 (Substack integration).
  -->
  <Articles />
</BaseLayout>
