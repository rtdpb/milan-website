---
/**
 * contact.astro — Contact page (PAGE-04)
 *
 * Source: PLAN 02-01 Task 3, 02-UI-SPEC.md §/contact (PAGE-04), D-08, D-12
 *
 * Layout:
 *   1. Page header — SectionWrapper default, H1 + subtext (nl.contact)
 *   2. Contact form — ContactForm.astro, max-width 640px (UI-SPEC §/contact)
 *   3. Newsletter — reused Newsletter.astro at bottom
 *
 * SEO (D-12): unique title + description via BaseLayout → BaseHead.
 * No dark band on this page — form section stays light (cream --color-bg).
 * No sidebar — lean single-column focus (UI-SPEC §/contact: no sidebar).
 *
 * Internal hrefs: import.meta.env.BASE_URL prefix (PATTERNS.md §BASE_URL).
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { getStrings } from '../i18n/utils';

// Phase 4: locale-parameterized strings (Astro.currentLocale is 'nl' at root)
const t = getStrings(Astro.currentLocale);
const { pageTitle, pageDesc, heading, subtext } = t.contact;
---

<BaseLayout title={pageTitle} description={pageDesc}>

  <!-- Header + form in one aligned 640px column, tight gap between them -->
  <SectionWrapper id="contact-form-section" labelledBy="contact-heading" variant="default">
    <div class="contact-col">
      <div class="contact-header">
        <h1 id="contact-heading" class="contact-header__heading">
          {heading}
        </h1>
        <p class="contact-header__subtext">
          {subtext}
        </p>
      </div>
      <ContactForm />
    </div>
  </SectionWrapper>

  <!-- Newsletter: reused at bottom (UI-SPEC §/contact) -->
  <Newsletter />

</BaseLayout>

<style>
  /* ── Aligned column: header + form share one 640px left-aligned column,
        with a tightened gap between the heading block and the form. ──────── */
  .contact-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 640px;
  }

  /* ── Page header ──────────────────────────────────────────────────────── */
  .contact-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-header__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);   /* display size, same as homepage H1 */
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0;
  }

  .contact-header__subtext {
    font-family: var(--font-body);
    font-size: var(--text-base);  /* 16–18px */
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

</style>
