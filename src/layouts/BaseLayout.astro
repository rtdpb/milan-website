---
/**
 * BaseLayout.astro
 * Page shell for all pages. Imports global CSS (tokens + reset), renders
 * <html lang={lang}>, BaseHead, skip-link, Nav (sticky header), main content,
 * and Footer.
 *
 * Source: RESEARCH §Architecture Patterns, §Accessibility Baseline; D-17
 * Plan 02: Nav + Footer wired in this edit.
 * Phase 4: locale-parameterized lang attr, skip-link text, BaseHead locale prop.
 */
import BaseHead from '../components/layout/BaseHead.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';
import '../styles/global.css'; // Global token CSS applied to every component
import { getStrings } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** NL slug for hreflang cross-linking (needed when EN slug differs from NL slug) */
  nlSlug?: string;
  /** EN slug for hreflang cross-linking (needed when NL slug differs from EN slug) */
  enSlug?: string;
}

// Phase 4: resolve locale from Astro.currentLocale (undefined on 404 → fallback 'nl')
const lang = Astro.currentLocale ?? 'nl';
const t = getStrings(lang);

// Locale-correct defaults (CR-03): EN pages get English fallbacks, NL pages get Dutch.
// This prevents any future EN page that omits title/description from silently
// receiving Dutch SEO metadata.
const defaultTitle = lang === 'en'
  ? 'Milan van der Meulen — Founder Coach & Speaker'
  : 'Milan van der Meulen — Founder Coach & Spreker';
const defaultDescription = lang === 'en'
  ? 'Milan van der Meulen is an experienced entrepreneur, founder coach and speaker. He scaled Soly to 9 countries and 180 employees. Now he helps other founders scale without losing themselves.'
  : 'Milan van der Meulen is een ervaren ondernemer, founder coach en spreker. Hij hielp Soly groeien naar 9 landen en 180 medewerkers. Nu helpt hij andere founders schalen zonder zichzelf te verliezen.';

const {
  // Defaults sourced from UI-SPEC §SEO / Metadata Contract
  title = defaultTitle,
  description = defaultDescription,
  ogImage,
  nlSlug,
  enSlug,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      locale={lang}
      nlSlug={nlSlug}
      enSlug={enSlug}
    />
  </head>
  <body>
    <!--
      Scroll progress bar — fixed at top, fills left→right on scroll.
      Mounted first so it sits above all other stacking contexts (z-index 300).
      Decorative only (aria-hidden). Motion island in ScrollProgress.astro
      guards prefers-reduced-motion and uses rAF throttling. (260821-m2d)
    -->
    <ScrollProgress />

    <!--
      Skip-to-content link (a11y FND-06).
      Visually hidden until focused — allows keyboard/screen-reader users
      to bypass navigation and jump to main content directly.
      Styled in global.css (.skip-link).
      MUST precede Nav so keyboard users can bypass it.
      Phase 4: text is locale-resolved from common.skipToContent.
    -->
    <a href="#main-content" class="skip-link">{t.common.skipToContent}</a>

    <!-- Site header — sticky, scroll-aware, with honest disabled nav/CTAs (Plan 02) -->
    <Nav />

    <!--
      Main content landmark — every page has exactly one <main>.
      id="main-content" is the skip-link target.
      aria-label not needed here because there is only one <main> per page.
    -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Site footer — light bg, disabled nav links, copyright/legal (Plan 02) -->
    <Footer />

    <!--
      Global motion island (v4.1): reveals [data-anim] elements on scroll,
      runs count-up on [data-countup] (with optional prefix/suffix),
      drives subtle parallax on [data-parallax], and honours prefers-reduced-motion.
      Content is authored fully visible/valued so no-JS + reduced-motion users
      never see hidden or zeroed content.
      Extended in 260821-m2d: prefix seam + parallax pass.
    -->
    <script>
      (function () {
        'use strict';
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ── Reveal on scroll (fade-rise + directional/scale variants) ────────
        var animEls = Array.prototype.slice.call(document.querySelectorAll('[data-anim]'));
        if (!reduce && 'IntersectionObserver' in window && animEls.length) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          animEls.forEach(function (el) { io.observe(el); });
        } else {
          animEls.forEach(function (el) { el.classList.add('is-in'); });
        }

        // ── Count-up numerals (additive prefix seam — 260821-m2d) ────────────
        // data-countup: numeric target (e.g. 1, 180, 9)
        // data-countup-prefix: optional prefix string (e.g. "~")
        // data-suffix: optional suffix string (e.g. "M", " markten") [existing]
        var nums = Array.prototype.slice.call(document.querySelectorAll('[data-countup]'));
        function runCount(el: HTMLElement) {
          var target = parseFloat(el.getAttribute('data-countup') || '0') || 0;
          var prefix = el.getAttribute('data-countup-prefix') || '';
          var suffix = el.getAttribute('data-suffix') || '';
          var dur = 1200;
          var start: number | null = null;
          function step(ts: number) {
            if (start === null) start = ts;
            var p = Math.min((ts - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = prefix + Math.round(eased * target) + suffix;
            if (p < 1) requestAnimationFrame(step);
            else el.textContent = prefix + target + suffix;
          }
          requestAnimationFrame(step);
        }
        if (!reduce && 'IntersectionObserver' in window && nums.length) {
          var io2 = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              runCount(e.target as HTMLElement);
              io2.unobserve(e.target);
            });
          }, { threshold: 0.6 });
          nums.forEach(function (el) { io2.observe(el); });
        }
        // (reduced-motion / no-JS: the final value is already in the markup)

        // ── Subtle parallax (260821-m2d) ─────────────────────────────────────
        // Elements opt in with data-parallax (e.g. data-parallax="0.05").
        // Purely decorative translateY offset — natural position IS the final state,
        // so no CSS "shown state" is needed; the reduced-motion block in global.css
        // pins these to transform:none via !important as belt-and-suspenders.
        // IMPORTANT: do NOT use data-parallax on the same node as data-anim —
        // they both write transform and would fight.
        if (!reduce) {
          var parallaxEls = Array.prototype.slice.call(document.querySelectorAll('[data-parallax]')) as HTMLElement[];
          if (parallaxEls.length) {
            var pticking = false;
            function runParallax() {
              var viewportH = window.innerHeight;
              parallaxEls.forEach(function (el) {
                var rect = el.getBoundingClientRect();
                // Skip elements fully off-screen to save work
                if (rect.bottom < -viewportH || rect.top > viewportH * 2) return;
                var strength = parseFloat(el.getAttribute('data-parallax') || '0.06');
                var mid = rect.top + rect.height / 2;
                var offset = (mid - viewportH / 2) * strength;
                // Clamp to ±24px — SUBTLE, never a big drifting move
                offset = Math.max(-24, Math.min(24, offset));
                el.style.transform = 'translate3d(0,' + offset + 'px,0)';
              });
              pticking = false;
            }
            function onScrollParallax() {
              if (pticking) return;
              pticking = true;
              requestAnimationFrame(runParallax);
            }
            window.addEventListener('scroll', onScrollParallax, { passive: true });
            window.addEventListener('resize', onScrollParallax, { passive: true });
            runParallax();
          }
        }
      })();
    </script>
  </body>
</html>
