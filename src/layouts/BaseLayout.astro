---
/**
 * BaseLayout.astro
 * Page shell for all pages. Imports global CSS (tokens + reset), renders
 * <html lang={lang}>, BaseHead, skip-link, Nav (sticky header), main content,
 * and Footer.
 *
 * Source: RESEARCH §Architecture Patterns, §Accessibility Baseline; D-17
 * Plan 02: Nav + Footer wired in this edit.
 * Phase 4: locale-parameterized lang attr, skip-link text, BaseHead locale prop.
 */
import BaseHead from '../components/layout/BaseHead.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css'; // Global token CSS applied to every component
import { getStrings } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** NL slug for hreflang cross-linking (needed when EN slug differs from NL slug) */
  nlSlug?: string;
  /** EN slug for hreflang cross-linking (needed when NL slug differs from EN slug) */
  enSlug?: string;
}

// Phase 4: resolve locale from Astro.currentLocale (undefined on 404 → fallback 'nl')
const lang = Astro.currentLocale ?? 'nl';
const t = getStrings(lang);

// Locale-correct defaults (CR-03): EN pages get English fallbacks, NL pages get Dutch.
// This prevents any future EN page that omits title/description from silently
// receiving Dutch SEO metadata.
const defaultTitle = lang === 'en'
  ? 'Milan van der Meulen — Founder Coach & Speaker'
  : 'Milan van der Meulen — Founder Coach & Spreker';
const defaultDescription = lang === 'en'
  ? 'Milan van der Meulen is an experienced entrepreneur, founder coach and speaker. He scaled Soly to 9 countries and 180 employees. Now he helps other founders scale without losing themselves.'
  : 'Milan van der Meulen is een ervaren ondernemer, founder coach en spreker. Hij hielp Soly groeien naar 9 landen en 180 medewerkers. Nu helpt hij andere founders schalen zonder zichzelf te verliezen.';

const {
  // Defaults sourced from UI-SPEC §SEO / Metadata Contract
  title = defaultTitle,
  description = defaultDescription,
  ogImage,
  nlSlug,
  enSlug,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      locale={lang}
      nlSlug={nlSlug}
      enSlug={enSlug}
    />
  </head>
  <body>
    <!--
      Skip-to-content link (a11y FND-06).
      Visually hidden until focused — allows keyboard/screen-reader users
      to bypass navigation and jump to main content directly.
      Styled in global.css (.skip-link).
      MUST precede Nav so keyboard users can bypass it.
      Phase 4: text is locale-resolved from common.skipToContent.
    -->
    <a href="#main-content" class="skip-link">{t.common.skipToContent}</a>

    <!-- Site header — sticky, scroll-aware, with honest disabled nav/CTAs (Plan 02) -->
    <Nav />

    <!--
      Main content landmark — every page has exactly one <main>.
      id="main-content" is the skip-link target.
      aria-label not needed here because there is only one <main> per page.
    -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Site footer — light bg, disabled nav links, copyright/legal (Plan 02) -->
    <Footer />
  </body>
</html>
